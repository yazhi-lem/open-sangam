# Agent backend environment variables — copy to .env and fill in your values.
# Never commit .env to version control.

# Which model backend to use: "openrouter" (default) or "gemini".
SANGAM_AGENT_BACKEND=openrouter

# --- openrouter backend (default) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id as listed on openrouter.ai/models, without the "openrouter/" prefix
# that LiteLLM adds internally.
# NOTE: google/gemma-3-27b-it does NOT reliably tool-call through OpenRouter —
# verified live: it prints the call as "```tool_code" text instead of actually
# invoking the tool. gemini-2.5-flash tool-calls correctly over the same route.
SANGAM_AGENT_MODEL=google/gemini-2.5-flash
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- gemini backend (alternative; SANGAM_AGENT_BACKEND=gemini) ---
GEMINI_API_KEY=
# SANGAM_AGENT_MODEL=gemini-2.5-flash

# --- imagery (Paranar, M2) ---
SANGAM_IMAGE_BACKEND=none

# --- A2A/CORS (M3) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- REST API: POST /avai/ask (api/app.py) ---
# Idle-session TTL in seconds before a session_id is treated as expired.
AVAI_SESSION_TTL_SECONDS=3600
