# Agent backend environment variables — copy to .env and fill in your values.
# Never commit .env to version control.

# Which model backend to use: "openrouter" (default) or "gemini".
SANGAM_AGENT_BACKEND=openrouter

# --- openrouter backend (default) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Model id as listed on openrouter.ai/models, without the "openrouter/" prefix
# that LiteLLM adds internally.
# NOTE: google/gemma-3-27b-it does NOT reliably tool-call through OpenRouter —
# verified live: it prints the call as "```tool_code" text instead of actually
# invoking the tool. gemini-2.5-flash tool-calls correctly over the same route.
SANGAM_AGENT_MODEL=google/gemini-2.5-flash
OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# --- gemini backend (alternative; SANGAM_AGENT_BACKEND=gemini) ---
GEMINI_API_KEY=
# SANGAM_AGENT_MODEL=gemini-2.5-flash

# --- self-hosted OpenAI-compatible backend (vLLM/TGI/llama.cpp) ---
# SANGAM_AGENT_BACKEND=vllm
# SANGAM_AGENT_MODEL=qwen2.5-7b-instruct
# SANGAM_MODEL_API_BASE=http://127.0.0.1:8000/v1
# SANGAM_MODEL_API_KEY=not-needed

# --- local Ollama backend (native tool-call path) ---
# SANGAM_AGENT_BACKEND=ollama
# SANGAM_AGENT_MODEL=qwen2.5:3b
# SANGAM_MODEL_API_BASE=http://127.0.0.1:11434

# --- imagery (Paranar, M2) ---
SANGAM_IMAGE_BACKEND=none

# --- A2A/CORS (M3) ---
ALLOWED_ORIGINS=http://localhost:5173

# --- REST API: POST /avai/ask (api/app.py) ---
# Idle-session TTL in seconds before a session_id is treated as expired.
AVAI_SESSION_TTL_SECONDS=3600

# --- Durable sessions (persistence.py) ---
# Leave unset for in-memory sessions (local/dev). Production: Postgres URL,
# e.g. postgresql+psycopg://user:pass@/avai?host=/cloudsql/PROJECT:REGION:INSTANCE
# AVAI_DATABASE_URL=

# --- Distributed rate limiting (rate_limit.py) ---
# Leave unset for per-instance fallback. Production: Memorystore Redis URL.
# AVAI_REDIS_URL=redis://10.0.0.3:6379/0

# --- Production health (api/app.py, health.py) ---
# 1 = /avai/health/ready returns 503 when no model API key is configured.
# Deployments set this; leave unset locally so no-key tests stay green.
# AVAI_STRICT_READINESS=1
# Build identifier reported by /avai/health/live and /avai/capabilities.
# AVAI_VERSION=local-dev
# Comma-separated CORS origins; production defaults to the Yazhi domains.
# AVAI_ALLOWED_ORIGINS=https://sangam.yazhi.dev,https://yazhi.dev,https://chat.yazhi.dev
# POST /avai/ask calls allowed per client per minute; 0 disables the limit.
# AVAI_RATE_LIMIT_PER_MINUTE=12
# Optional service-to-service auth for POST /avai/ask. Health/metrics stay public.
# AVAI_API_TOKEN=

# --- Telemetry and cost attribution (telemetry.py) ---
# JSON structured logs are on by default; AVAI_LOG_JSON=0 disables them.
# AVAI_LOG_LEVEL=INFO
# INR conversion for cost_inr and avai_model_cost_inr_total metrics.
# AVAI_USD_INR_RATE=88.0
# Optional per-million-token override (USD) for a self-hosted or negotiated model.
# AVAI_MODEL_INPUT_PRICE_PER_MTOK=0.30
# AVAI_MODEL_OUTPUT_PRICE_PER_MTOK=2.50
