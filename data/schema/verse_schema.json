{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open Sangam Verse",
  "description": "Canonical schema for a single verse in the Open Sangam corpus. Structure: Verse → Line → Word.",
  "type": "object",
  "required": ["id", "poem", "number", "sangamTamil", "lines"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique verse identifier, e.g. 'maduraikanchi_0001'",
      "pattern": "^[a-z_]+_\\d{4}$"
    },
    "poem": {
      "type": "string",
      "description": "Poem identifier, e.g. 'maduraikanchi'"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "tinai": {
      "type": "string",
      "description": "Tiṇai (poetic landscape) classification",
      "enum": ["kurinji", "mullai", "marutam", "neytal", "palai", "unknown"]
    },
    "sangamTamil": {
      "type": "string",
      "description": "Original verse text in Sangam Tamil script"
    },
    "urai": {
      "type": ["string", "null"],
      "description": "Modern Tamil prose rendering (Urai). Null until AI-generated and verified."
    },
    "yazhi_urai": {
      "type": ["string", "null"],
      "description": "Plain, colloquial modern Tamil paraphrase (Yazhi Urai) — an easier-to-read retelling than the more formal `urai` prose. Null until AI-generated."
    },
    "yazhi_uraiMeta": {
      "type": ["object", "null"],
      "description": "Provenance for an AI-drafted yazhi_urai field, written by backend/python/ai/translate_with_gemini.py. Same shape as englishMeta.",
      "properties": {
        "provider": { "type": "string" },
        "model": { "type": "string" },
        "promptVersion": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "runId": { "type": "string" }
      }
    },
    "english": {
      "type": ["string", "null"],
      "description": "Contemporary English translation. Null until AI-generated and verified."
    },
    "englishMeta": {
      "type": ["object", "null"],
      "description": "Provenance for an AI-drafted english field, written by backend/python/ai/translate_with_gemini.py. Absent for verses translated by hand.",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Model gateway used, e.g. 'openrouter'"
        },
        "model": {
          "type": "string",
          "description": "Model id, e.g. 'google/gemini-2.5-flash'"
        },
        "promptVersion": {
          "type": "string",
          "description": "Prompt revision that produced the draft, e.g. 'english-v1'"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runId": {
          "type": "string",
          "description": "Pipeline run id; cross-references data/pipeline/translation-state.json"
        }
      }
    },
    "etymologyMeta": {
      "type": ["object", "null"],
      "description": "Provenance for AI-drafted word-level glossary fields (root/urichol/etymology/gloss), written by backend/python/ai/extract_etymology.py. Absent until a run has annotated this verse's words.",
      "properties": {
        "provider": {
          "type": "string",
          "description": "Model gateway used, e.g. 'openrouter'"
        },
        "model": {
          "type": "string",
          "description": "Model id, e.g. 'google/gemini-2.5-flash'"
        },
        "promptVersion": {
          "type": "string",
          "description": "Prompt revision that produced the draft, e.g. 'etymology-v1'"
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "runId": {
          "type": "string",
          "description": "Pipeline run id; cross-references data/pipeline/etymology-state.json"
        },
        "wordsAnnotated": {
          "type": "integer",
          "description": "Word count covered by this run, for a quick sanity check against lines[].words"
        }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["lineNumber", "text", "words"],
        "properties": {
          "lineNumber": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["form"],
              "properties": {
                "form": {
                  "type": "string",
                  "description": "Word as it appears in the verse"
                },
                "root": {
                  "type": ["string", "null"],
                  "description": "Root word (வேர்ச்சொல்)"
                },
                "urichol": {
                  "type": ["string", "null"],
                  "description": "Grammatical / semantic class (உரிச்சொல்)"
                },
                "etymology": {
                  "type": ["string", "null"],
                  "description": "Detailed explanation IN TAMIL — derivation, cognates, morphology, and semantic shift to modern usage"
                },
                "gloss": {
                  "type": ["string", "null"],
                  "description": "Detailed English gloss — the word's meaning and how it functions in this verse, not just a 1-4 word tag"
                }
              }
            }
          }
        }
      }
    },
    "culturalNotes": {
      "type": "array",
      "description": "Cultural context annotations linked to spans in the verse",
      "items": {
        "type": "object",
        "required": ["title", "description"],
        "properties": {
          "title": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "sourceVerse": { "type": ["string", "null"] },
          "references": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "audioUrl": {
      "type": ["string", "null"],
      "description": "URL to an audio recording of the verse recitation"
    },
    "source": {
      "type": "string",
      "description": "Source of the original text"
    },
    "verified": {
      "type": "boolean",
      "description": "True once a scholar has reviewed the AI translations",
      "default": false
    }
  }
}
