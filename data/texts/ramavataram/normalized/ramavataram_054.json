"},{"form":"தாங்கினேன்."}]},{"lineNumber":97,"text":"'\"விரும்பு எழில் எந்தையார் மெய்ம்மை வீயுமேல்,","words":[{"form":"'\"விரும்பு"},{"form":"எழில்"},{"form":"எந்தையார்"},{"form":"மெய்ம்மை"},{"form":"வீயுமேல்,"}]},{"lineNumber":98,"text":"வரும் பழி\" என்று, யான் மகுடம் சூடலேன்;","words":[{"form":"வரும்"},{"form":"பழி\""},{"form":"என்று,"},{"form":"யான்"},{"form":"மகுடம்"},{"form":"சூடலேன்;"}]},{"lineNumber":99,"text":"கரும்பு அழி சொல்லியைப் பகைஞன் கைக்கொள,","words":[{"form":"கரும்பு"},{"form":"அழி"},{"form":"சொல்லியைப்"},{"form":"பகைஞன்"},{"form":"கைக்கொள,"}]},{"lineNumber":100,"text":"பெரும் பழி சூடினேன்; பிழைத்தது என் அரோ?'","words":[{"form":"பெரும்"},{"form":"பழி"},{"form":"சூடினேன்;"},{"form":"பிழைத்தது"},{"form":"என்"},{"form":"அரோ?'"}]},{"lineNumber":101,"text":"என்ன நொந்து, இன்னன பன்னி, ஏங்கியே,","words":[{"form":"என்ன"},{"form":"நொந்து,"},{"form":"இன்னன"},{"form":"பன்னி,"},{"form":"ஏங்கியே,"}]},{"lineNumber":102,"text":"துன்ன அருந் துயரத்துச் சோர்கின்றான் தனை,","words":[{"form":"துன்ன"},{"form":"அருந்"},{"form":"துயரத்துச்"},{"form":"சோர்கின்றான்"},{"form":"தனை,"}]},{"lineNumber":103,"text":"பன்ன அருங் கதிரவன் புதல்வன், பையுள் பார்த்து,","words":[{"form":"பன்ன"},{"form":"அருங்"},{"form":"கதிரவன்"},{"form":"புதல்வன்,"},{"form":"பையுள்"},{"form":"பார்த்து,"}]},{"lineNumber":104,"text":"அன்ன வெந் துயர் எனும் அளக்கர் நீக்கினான்.","words":[{"form":"அன்ன"},{"form":"வெந்"},{"form":"துயர்"},{"form":"எனும்"},{"form":"அளக்கர்"},{"form":"நீக்கினான்."}]},{"lineNumber":105,"text":"'ஐய, நீ ஆற்றலின் ஆற்றினேன் அலது,","words":[{"form":"'ஐய,"},{"form":"நீ"},{"form":"ஆற்றலின்"},{"form":"ஆற்றினேன்"},{"form":"அலது,"}]},{"lineNumber":106,"text":"உய்வெனே? எனக்கு இதின் உறுதி வேறு உண்டோ?","words":[{"form":"உய்வெனே?"},{"form":"எனக்கு"},{"form":"இதின்"},{"form":"உறுதி"},{"form":"வேறு"},{"form":"உண்டோ?"}]},{"lineNumber":107,"text":"வையகத்து, இப் பழி தீர மாய்வது","words":[{"form":"வையகத்து,"},{"form":"இப்"},{"form":"பழி"},{"form":"தீர"},{"form":"மாய்வது"}]},{"lineNumber":108,"text":"செய்வென்; நின் குறை முடித்து அன்றிச் செய்கலேன்.'","words":[{"form":"செய்வென்;"},{"form":"நின்"},{"form":"குறை"},{"form":"முடித்து"},{"form":"அன்றிச்"},{"form":"செய்கலேன்.'"}]},{"lineNumber":109,"text":"என்றனன் இராகவன்; இனைய காலையில்,","words":[{"form":"என்றனன்"},{"form":"இராகவன்;"},{"form":"இனைய"},{"form":"காலையில்,"}]},{"lineNumber":110,"text":"வன் திறல் மாருதி வணங்கினான்; 'நெடுங்","words":[{"form":"வன்"},{"form":"திறல்"},{"form":"மாருதி"},{"form":"வணங்கினான்;"},{"form":"'நெடுங்"}]},{"lineNumber":111,"text":"குன்று இவர் தோளினாய்! கூற வேண்டுவது","words":[{"form":"குன்று"},{"form":"இவர்"},{"form":"தோளினாய்!"},{"form":"கூற"},{"form":"வேண்டுவது"}]},{"lineNumber":112,"text":"ஒன்று உளது; அதனை நீ உணர்ந்து கேள்!' எனா,","words":[{"form":"ஒன்று"},{"form":"உளது;"},{"form":"அதனை"},{"form":"நீ"},{"form":"உணர்ந்து"},{"form":"கேள்!'"},{"form":"எனா,"}]},{"lineNumber":113,"text":"'கொடுந் தொழில் வாலியைக் கொன்று, கோமகன்","words":[{"form":"'கொடுந்"},{"form":"தொழில்"},{"form":"வாலியைக்"},{"form":"கொன்று,"},{"form":"கோமகன்"}]},{"lineNumber":114,"text":"கடுங் கதிரோன் மகன் ஆக்கி, கை வளர்","words":[{"form":"கடுங்"},{"form":"கதிரோன்"},{"form":"மகன்"},{"form":"ஆக்கி,"},{"form":"கை"},{"form":"வளர்"}]},{"lineNumber":115,"text":"நெடும் படை கூட்டினால் அன்றி, நேட அரிது,","words":[{"form":"நெடும்"},{"form":"படை"},{"form":"கூட்டினால்"},{"form":"அன்றி,"},{"form":"நேட"},{"form":"அரிது,"}]},{"lineNumber":116,"text":"அடும் படை அரக்கர்தம் இருக்கை - ஆணையாய்!","words":[{"form":"அடும்"},{"form":"படை"},{"form":"அரக்கர்தம்"},{"form":"இருக்கை"},{"form":"-"},{"form":"ஆணையாய்!"}]},{"lineNumber":117,"text":"'வானதோ? மண்ணதோ? மற்று வெற்பதோ?","words":[{"form":"'வானதோ?"},{"form":"மண்ணதோ?"},{"form":"மற்று"},{"form":"வெற்பதோ?"}]},{"lineNumber":118,"text":"ஏனை மா நாகர்தம் இருக்கைப் பாலதோ? -","words":[{"form":"ஏனை"},{"form":"மா"},{"form":"நாகர்தம்"},{"form":"இருக்கைப்"},{"form":"பாலதோ?"},{"form":"-"}]},{"lineNumber":119,"text":"தேன் உலாம் தெரியலாய்! - தெளிவது அன்று, நாம்","words":[{"form":"தேன்"},{"form":"உலாம்"},{"form":"தெரியலாய்!"},{"form":"-"},{"form":"தெளிவது"},{"form":"அன்று,"},{"form":"நாம்"}]},{"lineNumber":120,"text":"ஊன் உடை மானிடம் ஆனது உண்மையால்!","words":[{"form":"ஊன்"},{"form":"உடை"},{"form":"மானிடம்"},{"form":"ஆனது"},{"form":"உண்மையால்!"}]},{"lineNumber":121,"text":"'எவ் உலகங்களும் இமைப்பின் எய்துவர்,","words":[{"form":"'எவ்"},{"form":"உலகங்களும்"},{"form":"இமைப்பின்"},{"form":"எய்துவர்,"}]},{"lineNumber":122,"text":"வவ்வுவர், அவ் வழி மகிழ்ந்த யாவையும்;","words":[{"form":"வவ்வுவர்,"},{"form":"அவ்"},{"form":"வழி"},{"form":"மகிழ்ந்த"},{"form":"யாவையும்;"}]},{"lineNumber":123,"text":"வெவ் வினை வந்தென வருவர், மீள்வரால்;","words":[{"form":"வெவ்"},{"form":"வினை"},{"form":"வந்தென"},{"form":"வருவர்,"},{"form":"மீள்வரால்;"}]},{"lineNumber":124,"text":"அவ் அவர் உறைவிடம் அறியற்பாலதோ?","words":[{"form":"அவ்"},{"form":"அவர்"},{"form":"உறைவிடம்"},{"form":"அறியற்பாலதோ?"}]},{"lineNumber":125,"text":"'ஒரு முறையே பரந்து உலகம் யாவையும்,","words":[{"form":"'ஒரு"},{"form":"முறையே"},{"form":"பரந்து"},{"form":"உலகம்"},{"form":"யாவையும்,"}]},{"lineNumber":126,"text":"திரு உறை வேறு இடம் தேரவேண்டுமால்;","words":[{"form":"திரு"},{"form":"உறை"},{"form":"வேறு"},{"form":"இடம்"},{"form":"தேரவேண்டுமால்;"}]},{"lineNumber":127,"text":"வரன்முறை நாடிட, வரம்பு இன்றால் உலகு;","words":[{"form":"வரன்முறை"},{"form":"நாடிட,"},{"form":"வரம்பு"},{"form":"இன்றால்"},{"form":"உலகு;"}]},{"lineNumber":128,"text":"அருமை உண்டு; அளப்ப அரும் ஆண்டும் வேண்டுமால்.","words":[{"form":"அருமை"},{"form":"உண்டு;"},{"form":"அளப்ப"},{"form":"அரும்"},{"form":"ஆண்டும்"},{"form":"வேண்டுமால்."}]},{"lineNumber":129,"text":"'ஏழு - பத்து ஆகிய வெள்ளத்து எம் படை,","words":[{"form":"'ஏழு"},{"form":"-"},{"form":"பத்து"},{"form":"ஆகிய"},{"form":"வெள்ளத்து"},{"form":"எம்"},{"form":"படை,"}]},{"lineNumber":130,"text":"ஊழியில் கடல் என உலகம் போர்க்குமால்;","words":[{"form":"ஊழியில்"},{"form":"கடல்"},{"form":"என"},{"form":"உலகம்"},{"form":"போர்க்குமால்;"}]},{"lineNumber":131,"text":"ஆழியைக் குடிப்பினும், அயன் செய் அண்டத்தைக்","words":[{"form":"ஆழியைக