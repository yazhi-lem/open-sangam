:"'ஏனையோன் இவன் இராமன் எனத் தன்","words":[{"form":"'ஏனையோன்"},{"form":"இவன்"},{"form":"இராமன்"},{"form":"எனத்"},{"form":"தன்"}]},{"lineNumber":81,"text":"மேனியே உரைசெய்கின்றது; வேறு இச்","words":[{"form":"மேனியே"},{"form":"உரைசெய்கின்றது;"},{"form":"வேறு"},{"form":"இச்"}]},{"lineNumber":82,"text":"சேனை வீரர் படையைத் தெரி' என்னத்","words":[{"form":"சேனை"},{"form":"வீரர்"},{"form":"படையைத்"},{"form":"தெரி'"},{"form":"என்னத்"}]},{"lineNumber":83,"text":"தான் வினாவ, எதிர், சாரன் விளம்பும்:","words":[{"form":"தான்"},{"form":"வினாவ,"},{"form":"எதிர்,"},{"form":"சாரன்"},{"form":"விளம்பும்:"}]},{"lineNumber":84,"text":"'இங்கு இவன், \"படை இலங்கையர் மன்னன்","words":[{"form":"'இங்கு"},{"form":"இவன்,"},{"form":"\"படை"},{"form":"இலங்கையர்"},{"form":"மன்னன்"}]},{"lineNumber":85,"text":"தங்கை\" என்றலும், முதிர்ந்த சலத்தால்,","words":[{"form":"தங்கை\""},{"form":"என்றலும்,"},{"form":"முதிர்ந்த"},{"form":"சலத்தால்,"}]},{"lineNumber":86,"text":"அங்கை வாள்கொடு அவள் ஆகம் விளங்கும்","words":[{"form":"அங்கை"},{"form":"வாள்கொடு"},{"form":"அவள்"},{"form":"ஆகம்"},{"form":"விளங்கும்"}]},{"lineNumber":87,"text":"கொங்கை, நாசி, செவி, கொய்து குறைத்தான்.","words":[{"form":"கொங்கை,"},{"form":"நாசி,"},{"form":"செவி,"},{"form":"கொய்து"},{"form":"குறைத்தான்."}]},{"lineNumber":88,"text":"'அறக்கண் அல்லது ஒரு கண் இலன் ஆகி,","words":[{"form":"'அறக்கண்"},{"form":"அல்லது"},{"form":"ஒரு"},{"form":"கண்"},{"form":"இலன்"},{"form":"ஆகி,"}]},{"lineNumber":89,"text":"நிறக் கருங் கடலுள் நேமியின் நின்று,","words":[{"form":"நிறக்"},{"form":"கருங்"},{"form":"கடலுள்"},{"form":"நேமியின்"},{"form":"நின்று,"}]},{"lineNumber":90,"text":"துறக்கம் எய்தியவரும் துறவாத","words":[{"form":"துறக்கம்"},{"form":"எய்தியவரும்"},{"form":"துறவாத"}]},{"lineNumber":91,"text":"உறக்கம் என்பதனை ஓட முனிந்தான்.","words":[{"form":"உறக்கம்"},{"form":"என்பதனை"},{"form":"ஓட"},{"form":"முனிந்தான்."}]},{"lineNumber":92,"text":"'கை அவன் தொட அமைந்த கரத்தான்,","words":[{"form":"'கை"},{"form":"அவன்"},{"form":"தொட"},{"form":"அமைந்த"},{"form":"கரத்தான்,"}]},{"lineNumber":93,"text":"ஐய! வாலியொடு இவ் அண்டம் நடுங்கச்","words":[{"form":"ஐய!"},{"form":"வாலியொடு"},{"form":"இவ்"},{"form":"அண்டம்"},{"form":"நடுங்கச்"}]},{"lineNumber":94,"text":"செய்த வன் செருவினின் திகழ்கின்றான்","words":[{"form":"செய்த"},{"form":"வன்"},{"form":"செருவினின்"},{"form":"திகழ்கின்றான்"}]},{"lineNumber":95,"text":"வெய்யவன் புதல்வன்; யாரினும் வெய்யான்.","words":[{"form":"வெய்யவன்"},{"form":"புதல்வன்;"},{"form":"யாரினும்"},{"form":"வெய்யான்."}]},{"lineNumber":96,"text":"'தந்தை மற்றையவன் சார்வு இல் வலத்தோர்","words":[{"form":"'தந்தை"},{"form":"மற்றையவன்"},{"form":"சார்வு"},{"form":"இல்"},{"form":"வலத்தோர்"}]},{"lineNumber":97,"text":"அந்தரத்தர் அமுது ஆர்கலி காண,","words":[{"form":"அந்தரத்தர்"},{"form":"அமுது"},{"form":"ஆர்கலி"},{"form":"காண,"}]},{"lineNumber":98,"text":"மந்தரத்தினொடும் வாசுகியோடும்,","words":[{"form":"மந்தரத்தினொடும்"},{"form":"வாசுகியோடும்,"}]},{"lineNumber":99,"text":"சுந்தரப் பெரிய தோள்கள் திரித்தான்.","words":[{"form":"சுந்தரப்"},{"form":"பெரிய"},{"form":"தோள்கள்"},{"form":"திரித்தான்."}]},{"lineNumber":100,"text":"'நடந்து நின்றவன், நகும் கதிர் முன்பு","words":[{"form":"'நடந்து"},{"form":"நின்றவன்,"},{"form":"நகும்"},{"form":"கதிர்"},{"form":"முன்பு"}]},{"lineNumber":101,"text":"தொடர்ந்தவன்; உலகு, சுற்றும் எயிற்றின்","words":[{"form":"தொடர்ந்தவன்;"},{"form":"உலகு,"},{"form":"சுற்றும்"},{"form":"எயிற்றின்"}]},{"lineNumber":102,"text":"இடந்து எழுந்தவனை ஒத்தவன்; வேலை","words":[{"form":"இடந்து"},{"form":"எழுந்தவனை"},{"form":"ஒத்தவன்;"},{"form":"வேலை"}]},{"lineNumber":103,"text":"கடந்தவன் சரிதை கண்டனை அன்றே?","words":[{"form":"கடந்தவன்"},{"form":"சரிதை"},{"form":"கண்டனை"},{"form":"அன்றே?"}]},{"lineNumber":104,"text":"'நீலன், நின்றவன்; நெருப்பின் மகன்; திண்","words":[{"form":"'நீலன்,"},{"form":"நின்றவன்;"},{"form":"நெருப்பின்"},{"form":"மகன்;"},{"form":"திண்"}]},{"lineNumber":105,"text":"சூலமும் கயிறும் இன்மை துணிந்தும்,","words":[{"form":"சூலமும்"},{"form":"கயிறும்"},{"form":"இன்மை"},{"form":"துணிந்தும்,"}]},{"lineNumber":106,"text":"ஆலம் உண்டவன் அடுந் திறல் மிக்கான்;","words":[{"form":"ஆலம்"},{"form":"உண்டவன்"},{"form":"அடுந்"},{"form":"திறல்"},{"form":"மிக்கான்;"}]},{"lineNumber":107,"text":"\"காலன்\" என்பர், இவனைக் கருதாதார்.","words":[{"form":"\"காலன்\""},{"form":"என்பர்,"},{"form":"இவனைக்"},{"form":"கருதாதார்."}]},{"lineNumber":108,"text":"'வேறாக நின்றான், நளன் என்னும் விலங்கல் அன்னான்;","words":[{"form":"'வேறாக"},{"form":"நின்றான்,"},{"form":"நளன்"},{"form":"என்னும்"},{"form":"விலங்கல்"},{"form":"அன்னான்;"}]},{"lineNumber":109,"text":"ஏறா, வருணன் வழி தந்திலன் என்று இராமன்","words":[{"form":"ஏறா,"},{"form":"வருணன்"},{"form":"வழி"},{"form":"தந்திலன்"},{"form":"என்று"},{"form":"இராமன்"}]},{"lineNumber":110,"text":"சீறாத உள்ளத்து எழு சீற்றம் உகுத்த, செந் தீ","words":[{"form":"சீறாத"},{"form":"உள்ளத்து"},{"form":"எழு"},{"form":"சீற்றம்"},{"form":"உகுத்த,"},{"form":"செந்"},{"form":"தீ"}]},{"lineNumber":111,"text":"ஆறாதமுன்னம், அகன் வேலையை ஆறு செய்தான்.","words":[{"form":"ஆறாதமுன்னம்,"},{"form":"அகன்"},{"form":"வேலையை"},{"form":"ஆறு"},{"form":"செய்தான்."}]},{"lineNumber":112,"text":"'முக் காலமும் மொய்ம் மதியால் முறையின் உணர்வான்,","words":[{"form":"'முக்"},{"form":"காலமும்"},{"form":"மொய்ம்"},{"form":"மதியால்"},{"form":"முறையின்"},{"form":"உணர்வான்,"}]},{"lineNumber":113,"text":"புக்கு ஆலம் எழப் புணரிப் புலவோர் கலக்கும்","words":[{"form":"புக்கு"},{"form":"ஆலம்"},{"form":"எழப்"},{"form":"புணரிப்"},{"form":"புலவோர்"},{"form":"கலக்கும்"}]},{"lineNumber":114,"text":"அக் காலம் உள்ளான், கரடிக்கு அரசு ஆகி நின்றான், -","words":[{"form":"அக்"},{"form":"காலம்"},{"form":"உள்ளான்,"},{"form":"கரடிக்கு"},{"form":"அரசு"},{"form":"ஆகி"},{"form":"நின்றான்,"},{"form":"-"}]},{"lineNumber":115,"text":"இக் காலம் நின்றும் உலகு ஏழும் எடுக்க வல்லான்.","words":[{"form":"இக்"},{"form":"காலம்"},{"form":"நின்றும்"},{"form":"உலகு"},{"form":"ஏழும்"},{"form":"எடுக்க"},{"form":"வல்லான்."}]},{"lineNumber":116,"text":"'சேனாபதிதன் அயலே, இருள் செய்த குன்றின்","words":[{"form":"'சேனாபதிதன்"},{"form":"அயலே,"},{"form":"இருள்"},{"form":"செய்த"},{"form":"குன்றின்"}]},{"lineNumber":117,"text":"ஆனா மருங்கே, இரண்டு ஆடகக் குன்றின் நின்றார்,","words":[{"form":"ஆனா"},{"form":"மருங்கே,"},{"form":"இரண்டு"},{"form":"ஆடகக்"},{"form":"குன்றின்"},{"form":"நின்றார்,"}]},{"lineNumber":118,"text":"ஏனோரில் இராமன் இலக்குவன் என்னும் ஈட்டார்;","words":[{"form":"ஏனோரில்"},{"form":"இராமன்"},{"form":"இலக்குவன்"},{"form":"என்னும்"},{"form":"ஈட்டார்;"}]},{"lineNumber":119,"text":"வானோர் தம் மருத்துவர் மைந்தர்; வலிக்கண் மிக்கார்.","words":[{"form":"வானோர்"},{"form":"தம்"},{"form":"மருத்துவர்"},{"form":"மைந்தர்;"},{"form":"வலிக்கண்"},{"form":"மிக்கார்."}]},{"lineNumber":120,"text":"'உவன்காண் குமுதன்; குமுதாக்கனும் ஊங்கு அவன்காண்;","words":[{"form":"'உவன்காண்"},{"form":"குமுதன்;"},{"form":"குமுதாக்கனும்"},{"form":"ஊங்கு"},{"form":"அவன்காண்;"}]},{"lineNumber":121,"text":"இவன்காண் கவயன்; கவயாக்கனும் ஈங்கு இவன்காண்;","words":[{"form":"இவன்காண்"},{"form":"கவயன்;"},{"form":"கவயாக்கனும்"},{"form":"ஈங்கு"},{"form":"இவன்காண்;"}]},{"lineNumber":122,"text":"சிவன்காண் அயன்காண் எனும் தூதனைப் பெற்ற செல்வன்","words":[{"form":"சிவன்காண்"},{"form":"அயன்காண்"},{"form":"எனும்"},{"form":"தூதனைப்"},{"form":"பெற்ற"},{"form":"செல்வன்"}]},{"lineNumber":123,"text":"அவன்காண், நெடுங் கேசரி என்பவன், ஆற்றல் மிக்கான்.","words":[{"form":"அவன்காண்,"},{"form":"நெடுங்"},{"form":"கேசரி"},{"form":"என்பவன்,"},{"form":"ஆற்றல்"},{"form":"மிக்கான்."}]},{"lineNumber":124,"text":"'முரபன், நகு தோளவன், மூரி மடங்கல் என்னக்","words":[{"form":"'முரபன்,"},{"form":"நகு"},{"form":"தோளவன்,"},{"form":"மூரி"},{"form":"மடங்கல்"},{"form":"என்னக்"}]},{"lineNumber":125,"text":"கர பல் நகம் அன்னவை மின் உகக் காந்துகின்றான்;","words":[{"form":"கர"},{"form":"பல்"},{"form":"நகம்"},{"form":"அன்னவை"},{"form":"மின்"},{"form":"உகக்"},{"form":"காந்துகின்றான்;"}]},{"lineNumber":126,"text":"வர பல் நகம்தன்னையும் வேரொடு வேண்டின் வாங்கும்","words":[{"form":"வர"},{"form":"பல்"},{"form":"நகம்தன்னையும்"},{"form":"வேரொடு"},{"form":"வேண்டின்"},{"form":"வாங்கும்"}]},{"lineNumber":127,"text":"சரபன் அவன்; இவன் சதவலி ஆய தக்கோன்.","words":[{"form":"சரபன்"},{"form":"அவன்;"},{"form":"இவன்"},{"form":"சதவலி"},{"form":"ஆய"},{"form":"தக்கோன்."}]},{"lineNumber":128,"text":"'மூன்று கண் இலன் ஆயினும், மூன்று எயில் எரித்தோன்","words":[{"form":"'மூன்று"},{"form":"கண்"},{"form":"இலன்"},{"form":"ஆயினும்,"},{"form":"மூன்று"},{"form":"எயில்"},{"form":"எரித்தோன்"}]},{"lineNumber":129,"text":"போன்று நின்றவன் பனசன்; இப் போர்க்கு எலாம் தானே","words":[{"form":"போன்று"},{"form":"நின்றவன்"},{"form":"பனசன்;"},{"form":"இப்"},{"form":"போர்க்கு"},{"form":"எலாம்"},{"form":"தானே"}]},{"lineNumber":130,"text":"ஏன்று நின்றவன் இடபன்; மற்று இவன் தனக்கு எதிரே","words":[{"form":"ஏன்று"},{"form":"நின்றவன்"},{"form":"இடபன்;"},{"form":"மற்று"},{"form":"இவன்"},{"form":"தனக்கு"},{"form":"எதிரே"}]},{"lineNumber":131,"text":"தோன்றுகின்றவன் சுடேணன், மூதறிவொடு தொடர்ந்தோன்.","words":[{"form":"தோன்றுகின்றவன்"},{"form":"சுடேணன்,"},{"form":"மூதறிவொடு"},{"form":"தொடர்ந்தோன்."}]},{"lineNumber":132,"text":"'வெதிர் கொள் குன்று எலாம் வேரொடும் வாங்கி, மேதினியை","words":[{"form":"'வெதிர்"},{"form":"கொள்"},{"form":"குன்று"},{"form":"எலாம்"},{"form":"வேரொடும்"},{"form":"வாங்கி,"},{"form":"மேதினியை"}]},{"lineNumber":133,"text":"முதுகு நொய்து எனச் செய்தவன், கனலையும் முனிவோன்,","words":[{"form":"முதுகு"},{"form":"நொய்து"},{"form":"எனச்"},{"form":"செய்தவன்,"},{"form":"கனலையும்"},{"form":"முனிவோன்,"}]},{"lineNumber":134,"text":"கதிரவன் மகற்கு இட மருங்கே நின்ற காளை,","words":[{"form":"கதிரவன்"},{"form":"மகற்கு"},{"form":"இட"},{"form":"மருங்கே"},{"form":"நின்ற"},{"form":"காளை,"}]},{"lineNumber":135,"text":"ததிமுகன்; அவன், சங்கன் என்று உரைக்கின்ற சிங்கம்.","words":[{"form":"ததிமுகன்;"},{"form":"அவன்,"},{"form":"சங்கன்"},{"form":"என்று"},{"form":"உரைக்கின்ற"},{"form":"சிங்கம்."}]},{"lineNumber":136,"text":"'அண்ணல்! கேள்: இவர்க்கு உவமையும் அளவும் ஒன்று உளதோ?","words":[{"form":"'அண்ணல்!"},{"form":"கேள்:"},{"form":"இவர்க்கு"},{"form":"உவமையும்"},{"form":"அளவும்"},{"form":"ஒன்று"},{"form":"உளதோ?"}]},{"lineNumber":137,"text":"விண்ணின் மீனினைக் குணிப்பினும், வேலையுள் மீனை","words":[{"form":"விண்ணின்"},{"form":"மீனினைக்"},{"form":"குணிப்பினும்,"},{"form":"வேலையுள்"},{"form":"மீனை"}]},{"lineNumber":138,"text":"எண்ணி நோக்கினும், இக் கடல் மணலினை எல்லாம்","words":[{"form":"எண்ணி"},{"form":"நோக்கினும்,"},{"form":"இக்"},{"form":"கடல்"},{"form":"மணலினை"},{"form":"எல்லாம்"}]},{"lineNumber":139,"text":"கண்ணி நோக்கினும், கணக்கு இலை' என்றனன், காட்டி.","words":[{"form":"கண்ணி"},{"form":"நோக்கினும்,"},{"form":"கணக்கு"},{"form":"இலை'"},{"form":"என்றனன்,"},{"form":"காட்டி."}]},{"lineNumber":140,"text":"இராவணன் வானரப் படையை இகழ்ந்து சிறு நகை செய்தல்","words":[{"form":"இராவணன்"},{"form":"வானரப்"},{"form":"படையை"},{"form":"இகழ்ந்து"},{"form":"சிறு"},{"form":"நகை"},{"form":"செய்தல்"}]},{"lineNumber":141,"text":"சினம் கொள் திண் திறல் அரக்கனும், சிறு நகை செய்தான்,","words":[{"form":"சினம்"},{"form":"கொள்"},{"form":"திண்"},{"form":"திறல்"},{"form":"அரக்கனும்,"},{"form":"சிறு"},{"form":"நகை"},{"form":"செய்தான்,"}]},{"lineNumber":142,"text":"'புனம் கொள் புன் தலைக் குரங்கினைப் புகழுதி போலாம்;","words":[{"form":"'புனம்"},{"form":"கொள்"},{"form":"புன்"},{"form":"தலைக்"},{"form":"குரங்கினைப்"},{"form":"புகழுதி"},{"form":"போலாம்;"}]},{"lineNumber":143,"text":"வனங்களும் படர் வரைதொறும் திரிதரு மானின்","words":[{"form":"வனங்களும்"},{"form":"படர்"},{"form":"வரைதொறும்"},{"form":"திரிதரு"},{"form":"மானின்"}]},{"lineNumber":144,"text":"இனங்களும் பல என் செயும், அரியினை?' என்றான்.","words":[{"form":"இனங்களும்"},{"form":"பல"},{"form":"என்"},{"form":"செயும்,"},{"form":"அரியினை?'"},{"form":"என்றான்."}]},{"lineNumber":145,"text":"மிகைப் பாடல்கள்","words":[{"form":"மிகைப்"},{"form":"பாடல்கள்"}]},{"lineNumber":146,"text":"'ஏறிட்ட கல்லு வீழும் இடம் அற, எண்கினாலே","words":[{"form":"'ஏறிட்ட"},{"form":"கல்லு"},{"form":"வீழும்"},{"form":"இடம்"},{"form":"அற,"},{"form":"எண்கினாலே"}]},{"lineNumber":147,"text":"நாறு இட்டதென்ன ஒவ்வோர் ஓசனை நாலுபாலும்","words":[{"form":"நாறு"},{"form":"இட்டதென்ன"},{"form":"ஒவ்வோர்"},{"form":"ஓசனை"},{"form":"நாலுபாலும்"}]},{"lineNumber":148,"text":"சூறிட்ட சேனை நாப்பண் தோன்றுவோன் இடும்பன் என்றே","words":[{"form":"சூறிட்ட"},{"form":"சேனை"},{"form":"நாப்பண்"},{"form":"தோன்றுவோன்"},{"form":"இடும்பன்"},{"form":"என்றே"}]},{"lineNumber":149,"text":"கூறிட்ட வயிரத் திண் தோள் கொடுந் தொழில் மடங்கல் போல்வான். 27-","words":[{"form":"கூறிட்ட"},{"form":"வயிரத்"},{"form":"திண்"},{"form":"தோள்"},{"form":"கொடுந்"},{"form":"தொழில்"},{"form":"மடங்கல்"},{"form":"போல்வான்."},{"form":"27-"}]},{"lineNumber":150,"text":"'மற்று இவன் படையில் ஒன்னார் அன்றி, வானவர்களே வந்து","words":[{"form":"'மற்று"},{"form":"இவன்"},{"form":"படையில்"},{"form":"ஒன்னார்"},{"form":"அன்றி,"},{"form":"வானவர்களே"},{"form":"வந்து"}]},{"lineNumber":151,"text":"உற்றனர் எனினும், பற்றி உயிர் உகப் பிசைந்திட்டு ஊத,","words":[{"form":"உற்றனர்"},{"form":"எனினும்,"},{"form":"பற்றி"},{"form":"உயிர்"},{"form":"உகப்"},{"form":"பிசைந்திட்டு"},{"form":"ஊத,"}]},{"lineNumber":152,"text":"கொற்றவன் அருளும் கொண்டோ ன்; குடாவடிக்கு இறைவன்; கூற்றம்","words":[{"form":"கொற்றவன்"},{"form":"அருளும்"},{"form":"கொண்டோ"},{"form":"ன்;"},{"form":"குடாவடிக்கு"},{"form":"இறைவன்;"},{"form":"கூற்றம்"}]},{"lineNumber":153,"text":"பெற்றவன்; அடைந்தோர்தம்மை உயிர் எனப் பேணும் நீரான். 27-","words":[{"form":"பெற்றவன்;"},{"form":"அடைந்தோர்தம்மை"},{"form":"உயிர்"},{"form":"எனப்"},{"form":"பேணும்"},{"form":"நீரான்."},{"form":"27-"}]},{"lineNumber":154,"text":"'ஆங்கு அவன் எதிரே வேறு ஓர் ஆடகக் குன்றம் ஒன்றை","words":[{"form":"'ஆங்கு"},{"form":"அவன்"},{"form":"எதிரே"},{"form":"வேறு"},{"form":"ஓர்"},{"form":"ஆடகக்"},{"form":"குன்றம்"},{"form":"ஒன்றை"}]},{"lineNumber":155,"text":"வாங்கு நீர் மகரவேலை வந்து உடன் வளைந்ததென்ன,","words":[{"form":"வாங்கு"},{"form":"நீர்"},{"form":"மகரவேலை"},{"form":"வந்து"},{"form":"உடன்"},{"form":"வளைந்ததென்ன,"}]},{"lineNumber":156,"text":"ஓங்கு மைம் முகத்தின் தானையுள் பொலிந்திடுவான், வெற்றி","words":[{"form":"ஓங்கு"},{"form":"மைம்"},{"form":"முகத்தின்"},{"form":"தானையுள்"},{"form":"பொலிந்திடுவான்,"},{"form":"வெற்றி"}]},{"lineNumber":157,"text":"ஓங்கிய குவவுத் திண் தோள் வினதன் என்று உரைக்கும் வெய்யோன். 27-","words":[{"form":"ஓங்கிய"},{"form":"குவவுத்"},{"form":"திண்"},{"form":"தோள்"},{"form":"வினதன்"},{"form":"என்று"},{"form":"உரைக்கும்"},{"form":"வெய்யோன்."},{"form":"27-"}]},{"lineNumber":158,"text":"'அன்னவன் தனக்கு வாமத்து ஐம்பது கோடி யூகம்","words":[{"form":"'அன்னவன்"},{"form":"தனக்கு"},{"form":"வாமத்து"},{"form":"ஐம்பது"},{"form":"கோடி"},{"form":"யூகம்"}]},{"lineNumber":159,"text":"தன்னை வந்து இடையில் சுற்ற, தட வரை என்ன நிற்பான்,","words":[{"form":"தன்னை"},{"form":"வந்து"},{"form":"இடையில்"},{"form":"சுற்ற,"},{"form":"தட"},{"form":"வரை"},{"form":"என்ன"},{"form":"நிற்பான்,"}]},{"lineNumber":160,"text":"கொல் நவில் குலிசத்து அண்ணல் கொதித்து எதிர்கொடுக்குமேனும்,","words":[{"form":"கொல்"},{"form":"நவில்"},{"form":"குலிசத்து"},{"form":"அண்ணல்"},{"form":"கொதித்து"},{"form":"எதிர்கொடுக்குமேனும்,"}]},{"lineNumber":161,"text":"வென்னிடக் குமைக்கும் வேகதெரிசி என்று உரைக்கும் வீரன். 27-","words":[{"form":"வென்னிடக்"},{"form":"குமைக்கும்"},{"form":"வேகதெரிசி"},{"form":"என்று"},{"form":"உரைக்கும்"},{"form":"வீரன்."},{"form":"27-"}]},{"lineNumber":162,"text":"'பிளக்கும் மன்பதையும், நாகர் பிலனையும்; கிளக்கும் வேரோடு","words":[{"form":"'பிளக்கும்"},{"form":"மன்பதையும்,"},{"form":"நாகர்"},{"form":"பிலனையும்;"},{"form":"கிளக்கும்"},{"form":"வேரோடு"}]},{"lineNumber":163,"text":"இளக்கும் இக் குடுமிக் குன்றத்து இனம் எலாம் பிடுங்கி, ஏந்தி,","words":[{"form":"இளக்கும்"},{"form":"இக்"},{"form":"குடுமிக்"},{"form":"குன்றத்து"},{"form":"இனம்"},{"form":"எலாம்"},{"form":"பிடுங்கி,"},{"form":"ஏந்தி,"}]},{"lineNumber":164,"text":"அளக்கர் கட்டவனும் மாட்டது அலக்கணுற்றிட விட்டு, ஆர்க்கும்","words":[{"form":"அளக்கர்"},{"form":"கட்டவனும்"},{"form":"மாட்டது"},{"form":"அலக்கணுற்றிட"},{"form":"விட்டு,"},{"form":"ஆர்க்கும்"}]},{"lineNumber":165,"text":"துளக்கம் இல் மொய்ம்பர் சோதிமுகனும் துன்முகனும் என்பார். 27-","words":[{"form":"துளக்கம்"},{"form":"இல்"},{"form":"மொய்ம்பர்"},{"form":"சோதிமுகனும்"},{"form":"துன்முகனும்"},{"form":"என்பார்."},{"form":"27-"}]},{"lineNumber":166,"text":"'குன்றொடு குணிக்கும் கொற்றக் குவவுத் தோள் குரக்குச் சேனை","words":[{"form":"'குன்றொடு"},{"form":"குணிக்கும்"},{"form":"கொற்றக்"},{"form":"குவவுத்"},{"form":"தோள்"},{"form":"குரக்குச்"},{"form":"சேனை"}]},{"lineNumber":167,"text":"ஒன்று பத்து ஐந்தொடு ஆறு கோடி வந்து ஒருங்கு சுற்ற,","words":[{"form":"ஒன்று"},{"form":"பத்து"},{"form":"ஐந்தொடு"},{"form":"ஆறு"},{"form":"கோடி"},{"form":"வந்து"},{"form":"ஒருங்கு"},{"form":"சுற்ற,"}]},{"lineNumber":168,"text":"மின் தொகுத்து அமைந்த போல விளக்கு எயிறு இலங்க, மேருச்","words":[{"form":"மின்"},{"form":"தொகுத்து"},{"form":"அமைந்த"},{"form":"போல"},{"form":"விளக்கு"},{"form":"எயிறு"},{"form":"இலங்க,"},{"form":"மேருச்"}]},{"lineNumber":169,"text":"சென்றென வந்து நிற்பான், திறல் கெழு தீர்க்கபாதன். 27-","words":[{"form":"சென்றென"},{"form":"வந்து"},{"form":"நிற்பான்,"},{"form":"திறல்"},{"form":"கெழு"},{"form":"தீர்க்கபாதன்."},{"form":"27-"}]},{"lineNumber":170,"text":"'நூற்றிரண்டாய கோடி நோன் கவித் தாளை சுற்ற,","words":[{"form":"'நூற்றிரண்டாய"},{"form":"கோடி"},{"form":"நோன்"},{"form":"கவித்"},{"form":"தாளை"},{"form":"சுற்ற,"}]},{"lineNumber":171,"text":"காற்றின் மா மகற்குக் கீழ்பால் கன வரை என்ன நிற்பான்,","words":[{"form":"காற்றின்"},{"form":"மா"},{"form":"மகற்குக்"},{"form":"கீழ்பால்"},{"form":"கன"},{"form":"வரை"},{"form":"என்ன"},{"form":"நிற்பான்,"}]},{"lineNumber":172,"text":"கூற்றின் மா மைந்தன்; கூற்றும் குலுக்கமுற்று அலக்கண் எய்தச்","words":[{"form":"கூற்றின்"},{"form":"மா"},{"form":"மைந்தன்;"},{"form":"கூற்றும்"},{"form":"குலுக்கமுற்று"},{"form":"அலக்கண்"},{"form":"எய்தச்"}]},{"lineNumber":173,"text":"சீற்றமே சிந்தும் செங் கண் தெதிமுகன் என்னும் சீயம். 27-","words":[{"form":"சீற்றமே"},{"form":"சிந்தும்"},{"form":"செங்"},{"form":"கண்"},{"form":"தெதிமுகன்"},{"form":"என்னும்"},{"form":"சீயம்."},{"form":"27-"}]},{"lineNumber":174,"text":"'நாடில், இங்கு இவர் ஆதியாய் நவின்ற மூ-எழுவர்","words":[{"form":"'நாடில்,"},{"form":"இங்கு"},{"form":"இவர்"},{"form":"ஆதியாய்"},{"form":"நவின்ற"},{"form":"மூ-எழுவர்"}]},{"lineNumber":175,"text":"ஆடல் வெம் படைத் தலைவர்கள் ஆறுபத்து ஏழு","words":[{"form":"ஆடல்"},{"form":"வெம்"},{"form":"படைத்"},{"form":"தலைவர்கள்"},{"form":"ஆறுபத்து"},{"form":"ஏழு"}]},{"lineNumber":176,"text":"கோடி வீரர்கள், குன்று எனக் குவவிய தோளாய்!","words":[{"form":"கோடி"},{"form":"வீரர்கள்,"},{"form":"குன்று"},{"form":"எனக்"},{"form":"குவவிய"},{"form":"தோளாய்!"}]},{"lineNumber":177,"text":"கூடு சேனையும் எழுபது வெள்ளமாய்க் குறிப்பார். 33-","words":[{"form":"கூடு"},{"form":"சேனையும்"},{"form":"எழுபது"},{"form":"வெள்ளமாய்க்"},{"form":"குறிப்பார்."},{"form":"33-"}]},{"lineNumber":178,"text":"'அழிவு இலா வலி படைத்துள நம் படை அரக்கர்","words":[{"form":"'அழிவு"},{"form":"இலா"},{"form":"வலி"},{"form":"படைத்துள"},{"form":"நம்"},{"form":"படை"},{"form":"அரக்கர்"}]},{"lineNumber":179,"text":"ஒழிவு இலாத பல் ஆயிர வெள்ளத்துக்கு உறை ஓர்","words":[{"form":"ஒழிவு"},{"form":"இலாத"},{"form":"பல்"},{"form":"ஆயிர"},{"form":"வெள்ளத்துக்கு"},{"form":"உறை"},{"form":"ஓர்"}]},{"lineNumber":180,"text":"துளியும் ஒவ்விடா எழுபது வெள்ளத்தின் தொகை சேர்","words":[{"form":"துளியும்"},{"form":"ஒவ்விடா"},{"form":"எழுபது"},{"form":"வெள்ளத்தின்"},{"form":"தொகை"},{"form":"சேர்"}]},{"lineNumber":181,"text":"எளிய புன் குரங்கு என் செயும்?' என்றனன், இகலோன். 35-","words":[{"form":"எளிய"},{"form":"புன்"},{"form":"குரங்கு"},{"form":"என்"},{"form":"செயும்?'"},{"form":"என்றனன்,"},{"form":"இகலோன்."},{"form":"35-"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%95%E0%AE%AE%E0%AF%8D%E0%AE%AA%E0%AE%B0%E0%AE%BE%E0%AE%AE%E0%AE%BE%E0%AE%AF%E0%AE%A3%E0%AE%AE%E0%AF%8D/%E0%AE%AF%E0%AF%81%E0%AE%A4%E0%AF%8D%E0%AE%A4_%E0%AE%95%E0%AE%BE%E0%AE%A3%E0%AF%8D%E0%AE%9F%E0%AE%AE%E0%AF%8D/%E0%AE%87%E0%AE%B0%E0%AE%BE%E0%AE%B5%E0%AE%A3%E0%AE%A9%E0%AF%8D_%E0%AE%B5%E0%AE%BE%E0%AE%A9%E0%AE%B0%E0%AE%A4%E0%AF%8D_%E0%AE%A4%E0%AE%BE%E0%AE%A9%E0%AF%88_%E0%AE%95%E0%AE%BE%E0%AE%A3%E0%AF%8D_%E0%AE%AA%E0%AE%9F%E0%AE%B2%E0%AE%AE%E0%AF%8D","verified":false,"structure":{"level":"padalam","book":"யுத்த காண்டம்"