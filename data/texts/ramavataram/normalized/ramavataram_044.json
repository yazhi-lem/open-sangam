"form":"அருணனுடன்"},{"form":"வயிநதேயன்,"}]},{"lineNumber":180,"text":"தழை புரையும் சிறைக் கூகை, பாறுமுதல் பெரும் பறவை தம்மை ஈன்றாள்;","words":[{"form":"தழை"},{"form":"புரையும்"},{"form":"சிறைக்"},{"form":"கூகை,"},{"form":"பாறுமுதல்"},{"form":"பெரும்"},{"form":"பறவை"},{"form":"தம்மை"},{"form":"ஈன்றாள்;"}]},{"lineNumber":181,"text":"இழை புரையும் தாம்பிரை ஊர்க்குருவி, சிவல், காடை, பல பிறவும் ஈன்றாள்;","words":[{"form":"இழை"},{"form":"புரையும்"},{"form":"தாம்பிரை"},{"form":"ஊர்க்குருவி,"},{"form":"சிவல்,"},{"form":"காடை,"},{"form":"பல"},{"form":"பிறவும்"},{"form":"ஈன்றாள்;"}]},{"lineNumber":182,"text":"கழை எனும் அக்கொடி பயந்தாள், கொடியுடனே செடி முதலாக் கண்ட எல்லாம். 24-","words":[{"form":"கழை"},{"form":"எனும்"},{"form":"அக்கொடி"},{"form":"பயந்தாள்,"},{"form":"கொடியுடனே"},{"form":"செடி"},{"form":"முதலாக்"},{"form":"கண்ட"},{"form":"எல்லாம்."},{"form":"24-"}]},{"lineNumber":183,"text":"வெருட்டி எழும் கண பணப்பை வியாளம் எலாம் கத்துரு ஆம் மின்னும் ஈன்றாள்;","words":[{"form":"வெருட்டி"},{"form":"எழும்"},{"form":"கண"},{"form":"பணப்பை"},{"form":"வியாளம்"},{"form":"எலாம்"},{"form":"கத்துரு"},{"form":"ஆம்"},{"form":"மின்னும்"},{"form":"ஈன்றாள்;"}]},{"lineNumber":184,"text":"மருள் திகழும் ஒரு தலைய புயங்கம் எலாம் சுதை என்னும் மாது தந்தாள்;","words":[{"form":"மருள்"},{"form":"திகழும்"},{"form":"ஒரு"},{"form":"தலைய"},{"form":"புயங்கம்"},{"form":"எலாம்"},{"form":"சுதை"},{"form":"என்னும்"},{"form":"மாது"},{"form":"தந்தாள்;"}]},{"lineNumber":185,"text":"அருட்டை என்னும் வல்லி தந்தாள், ஓந்தி, உடும்பு, அணில்கள் முதலான எல்லாம்;","words":[{"form":"அருட்டை"},{"form":"என்னும்"},{"form":"வல்லி"},{"form":"தந்தாள்,"},{"form":"ஓந்தி,"},{"form":"உடும்பு,"},{"form":"அணில்கள்"},{"form":"முதலான"},{"form":"எல்லாம்;"}]},{"lineNumber":186,"text":"தெருட்டிடும் மாது இளை ஈந்தாள், செலசரம் ஆகிய பலவும், தெரிக்குங்காலை. 24-","words":[{"form":"தெருட்டிடும்"},{"form":"மாது"},{"form":"இளை"},{"form":"ஈந்தாள்,"},{"form":"செலசரம்"},{"form":"ஆகிய"},{"form":"பலவும்,"},{"form":"தெரிக்குங்காலை."},{"form":"24-"}]},{"lineNumber":187,"text":"'அதிதி, திதி, தனு, அருட்டை, சுதை, கழையே, சுரபி, அணி விநதை, ஆன்ற","words":[{"form":"'அதிதி,"},{"form":"திதி,"},{"form":"தனு,"},{"form":"அருட்டை,"},{"form":"சுதை,"},{"form":"கழையே,"},{"form":"சுரபி,"},{"form":"அணி"},{"form":"விநதை,"},{"form":"ஆன்ற"}]},{"lineNumber":188,"text":"மதி, இளை, கந்துருவுடனே, குரோதவசை, தாம்பிரை, ஆம் மட நலார்கள்,","words":[{"form":"மதி,"},{"form":"இளை,"},{"form":"கந்துருவுடனே,"},{"form":"குரோதவசை,"},{"form":"தாம்பிரை,"},{"form":"ஆம்"},{"form":"மட"},{"form":"நலார்கள்,"}]},{"lineNumber":189,"text":"விதி முறையே, இவை அனைத்தும் பயந்தனர்கள்; விநதை சுதன் அருணன் மென் தோள்,","words":[{"form":"விதி"},{"form":"முறையே,"},{"form":"இவை"},{"form":"அனைத்தும்"},{"form":"பயந்தனர்கள்;"},{"form":"விநதை"},{"form":"சுதன்"},{"form":"அருணன்"},{"form":"மென்"},{"form":"தோள்,"}]},{"lineNumber":190,"text":"புது மதி சேர் நுதல், அரம்பைதனைப் புணர, உதித்தனம் யாம், புவனிமீதே. 24-","words":[{"form":"புது"},{"form":"மதி"},{"form":"சேர்"},{"form":"நுதல்,"},{"form":"அரம்பைதனைப்"},{"form":"புணர,"},{"form":"உதித்தனம்"},{"form":"யாம்,"},{"form":"புவனிமீதே."},{"form":"24-"}]},{"lineNumber":191,"text":"என்று உரைத்த எருவை அரசனைத்","words":[{"form":"என்று"},{"form":"உரைத்த"},{"form":"எருவை"},{"form":"அரசனைத்"}]},{"lineNumber":192,"text":"துன்று தாரவர் நோக்கித் தொழுது, கண்","words":[{"form":"துன்று"},{"form":"தாரவர்"},{"form":"நோக்கித்"},{"form":"தொழுது,"},{"form":"கண்"}]},{"lineNumber":193,"text":"ஒன்றும் முத்தம் முறை முறையாய் உக-","words":[{"form":"ஒன்றும்"},{"form":"முத்தம்"},{"form":"முறை"},{"form":"முறையாய்"},{"form":"உக-"}]},{"lineNumber":194,"text":"நின்று, மற்று இன்ன நீர்மை நிகழ்த்தினார். 27-","words":[{"form":"நின்று,"},{"form":"மற்று"},{"form":"இன்ன"},{"form":"நீர்மை"},{"form":"நிகழ்த்தினார்."},{"form":"27-"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%95%E0%AE%AE%E0%AF%8D%E0%AE%AA%E0%AE%B0%E0%AE%BE%E0%AE%AE%E0%AE%BE%E0%AE%AF%E0%AE%A3%E0%AE%AE%E0%AF%8D/%E0%AE%86%E0%AE%B0%E0%AE%A3%E0%AE%BF%E0%AE%AF_%E0%AE%95%E0%AE%BE%E0%