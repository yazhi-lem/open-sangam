rds":[{"form":"சுற்றிக்"},{"form":"கிளரும்"},{"form":"சுடர்"},{"form":"தோள்வளையான்;"}]},{"lineNumber":41,"text":"பல் ஆயிரம் மா மணி பாடம்உறும்","words":[{"form":"பல்"},{"form":"ஆயிரம்"},{"form":"மா"},{"form":"மணி"},{"form":"பாடம்உறும்"}]},{"lineNumber":42,"text":"தொல் ஆர் அணி கால் சுடரின் தொகைதாம்","words":[{"form":"தொல்"},{"form":"ஆர்"},{"form":"அணி"},{"form":"கால்"},{"form":"சுடரின்"},{"form":"தொகைதாம்"}]},{"lineNumber":43,"text":"எல்லாம் உடன் ஆய் எழலால், ஒரு தன்","words":[{"form":"எல்லாம்"},{"form":"உடன்"},{"form":"ஆய்"},{"form":"எழலால்,"},{"form":"ஒரு"},{"form":"தன்"}]},{"lineNumber":44,"text":"வில்லால், ஒளிர் மேகம் எனப் பொலிவான்;","words":[{"form":"வில்லால்,"},{"form":"ஒளிர்"},{"form":"மேகம்"},{"form":"எனப்"},{"form":"பொலிவான்;"}]},{"lineNumber":45,"text":"மானா உலகம்தனில், மன்றல் பொரும்,","words":[{"form":"மானா"},{"form":"உலகம்தனில்,"},{"form":"மன்றல்"},{"form":"பொரும்,"}]},{"lineNumber":46,"text":"தேன் நாறு, நலம் செறி, தொங்கலினான்;","words":[{"form":"தேன்"},{"form":"நாறு,"},{"form":"நலம்"},{"form":"செறி,"},{"form":"தொங்கலினான்;"}]},{"lineNumber":47,"text":"மீனோடு கடுத்து உயர் வென்றி அவாம்","words":[{"form":"மீனோடு"},{"form":"கடுத்து"},{"form":"உயர்"},{"form":"வென்றி"},{"form":"அவாம்"}]},{"lineNumber":48,"text":"வான் நாடியார் கண் எனும் வாள் உடையான்;","words":[{"form":"வான்"},{"form":"நாடியார்"},{"form":"கண்"},{"form":"எனும்"},{"form":"வாள்"},{"form":"உடையான்;"}]},{"lineNumber":49,"text":"வெல்லான் நசையால், விசையால், விடு நாள்,","words":[{"form":"வெல்லான்"},{"form":"நசையால்,"},{"form":"விசையால்,"},{"form":"விடு"},{"form":"நாள்,"}]},{"lineNumber":50,"text":"எல் வான் சுடர் மாலை இராவணன்மேல்,","words":[{"form":"எல்"},{"form":"வான்"},{"form":"சுடர்"},{"form":"மாலை"},{"form":"இராவணன்மேல்,"}]},{"lineNumber":51,"text":"நெல் வாலும் அறாத, நிறம் பிறழா,","words":[{"form":"நெல்"},{"form":"வாலும்"},{"form":"அறாத,"},{"form":"நிறம்"},{"form":"பிறழா,"}]},{"lineNumber":52,"text":"வல் வாய் மடியா, வயிரப் படையான்;-","words":[{"form":"வல்"},{"form":"வாய்"},{"form":"மடியா,"},{"form":"வயிரப்"},{"form":"படையான்;-"}]},{"lineNumber":53,"text":"நின்றான். எதிர் நின்ற நெடுந் தவனும்","words":[{"form":"நின்றான்."},{"form":"எதிர்"},{"form":"நின்ற"},{"form":"நெடுந்"},{"form":"தவனும்"}]},{"lineNumber":54,"text":"சென்றான், எதிர்கொண்டு; சிறப்பு அமையா,","words":[{"form":"சென்றான்,"},{"form":"எதிர்கொண்டு;"},{"form":"சிறப்பு"},{"form":"அமையா,"}]},{"lineNumber":55,"text":"'என்தான் இவண் எய்தியவாறு?'எனலும்,","words":[{"form":"'என்தான்"},{"form":"இவண்"},{"form":"எய்தியவாறு?'எனலும்,"}]},{"lineNumber":56,"text":"பொன்றாத பொலங் கழலோன் புகலும்:","words":[{"form":"பொன்றாத"},{"form":"பொலங்"},{"form":"கழலோன்"},{"form":"புகலும்:"}]},{"lineNumber":57,"text":"\"நின்னால் இயல் நீதி நெடுந் தவம், இன்று,","words":[{"form":"\"நின்னால்"},{"form":"இயல்"},{"form":"நீதி"},{"form":"நெடுந்"},{"form":"தவம்,"},{"form":"இன்று,"}]},{"lineNumber":58,"text":"என்னானும் விளம்ப அரிது\" என்று உணர்வான்","words":[{"form":"என்னானும்"},{"form":"விளம்ப"},{"form":"அரிது\""},{"form":"என்று"},{"form":"உணர்வான்"}]},{"lineNumber":59,"text":"அந் நான்முகன், நின்னை அழைத்தனனால்;","words":[{"form":"அந்"},{"form":"நான்முகன்,"},{"form":"நின்னை"},{"form":"அழைத்தனனால்;"}]},{"lineNumber":60,"text":"பொன் ஆர் சடை மாதவ! போதுதியால்;","words":[{"form":"பொன்"},{"form":"ஆர்"},{"form":"சடை"},{"form":"மாதவ!"},{"form":"போதுதியால்;"}]},{"lineNumber":61,"text":"'எந்தாய்! உலகு யாவையும் எவ் உயிரும்","words":[{"form":"'எந்தாய்!"},{"form":"உலகு"},{"form":"யாவையும்"},{"form":"எவ்"},{"form":"உயிரும்"}]},{"lineNumber":62,"text":"தந்தான் உறையும் நெறி தந்தனனால்;","words":[{"form":"தந்தான்"},{"form":"உறையும்"},{"form":"நெறி"},{"form":"தந்தனனால்;"}]},{"lineNumber":63,"text":"நந்தாத பெருந் தவ! நாடுஅது நீ","words":[{"form":"நந்தாத"},{"form":"பெருந்"},{"form":"தவ!"},{"form":"நாடுஅது"},{"form":"நீ"}]},{"lineNumber":64,"text":"வந்தாய்எனின், நின் எதிரே வருவான்;","words":[{"form":"வந்தாய்எனின்,"},{"form":"நின்"},{"form":"எதிரே"},{"form":"வருவான்;"}]},{"lineNumber":65,"text":"'எல்லா உலகிற்கும் உயர்ந்தமை, யான்","words":[{"form":"'எல்லா"},{"form":"உலகிற்கும்"},{"form":"உயர்ந்தமை,"},{"form":"யான்"}]},{"lineNumber":66,"text":"சொல்லாவகை, நீ உணர் தொன்மையையால்;","words":[{"form":"சொல்லாவகை,"},{"form":"நீ"},{"form":"உணர்"},{"form":"தொன்மையையால்;"}]},{"lineNumber":67,"text":"நல்லாளுடனே நட, நீ' எனலும்,","words":[{"form":"நல்லாளுடனே"},{"form":"நட,"},{"form":"நீ'"},{"form":"எனலும்,"}]},{"lineNumber":68,"text":"'அல்லேன்' என, வால் அறிவான் அறைவான்:","words":[{"form":"'அல்லேன்'"},{"form":"என,"},{"form":"வால்"},{"form":"அறிவான்"},{"form":"அறைவான்:"}]},{"lineNumber":69,"text":"'சொல் பொங்கு பெரும் புகழோடு! தொழில் மாய்","words":[{"form":"'சொல்"},{"form":"பொங்கு"},{"form":"பெரும்"},{"form":"புகழோடு!"},{"form":"தொழில்"},{"form":"மாய்"}]},{"lineNumber":70,"text":"சிற்பங்களின் வீவன சேர்குவெனோ?","words":[{"form":"சிற்பங்களின்"},{"form":"வீவன"},{"form":"சேர்குவெனோ?"}]},{"lineNumber":71,"text":"அற்பம் கருதேன்; என் அருந் தவமோ","words":[{"form":"அற்பம்"},{"form":"கருதேன்;"},{"form":"என்"},{"form":"அருந்"},{"form":"தவமோ"}]},{"lineNumber":72,"text":"கற்பம் பல சென்றது; காணுதியால்;","words":[{"form":"கற்பம்"},{"form":"பல"},{"form":"சென்றது;"},{"form":"காணுதியால்;"}]},{"lineNumber":73,"text":"'சொற்றும் தரம் அன்று இது; சூழ் கழலாய்!","words":[{"form":"'சொற்றும்"},{"form":"தரம்"},{"form":"அன்று"},{"form":"இது;"},{"form":"சூழ்"},{"form":"கழலாய்!"}]},{"lineNumber":74,"text":"பெற்றும், பெறுகில்லது ஓர் பெற்றியதே","words":[{"form":"பெற்றும்,"},{"form":"பெறுகில்லது"},{"form":"ஓர்"},{"form":"பெற்றியதே"}]},{"lineNumber":75,"text":"மற்று என் பல? நீ இவண் வந்ததனால்,","words":[{"form":"மற்று"},{"form":"என்"},{"form":"பல?"},{"form":"நீ"},{"form":"இவண்"},{"form":"வந்ததனால்,"}]},{"lineNumber":76,"text":"முற்றும் பகல்தானும் முடிந்துளதால்;","words":[{"form":"முற்றும்"},{"form":"பகல்தானும்"},{"form":"முடிந்துளதால்;"}]},{"lineNumber":77,"text":"'சிறு காலை இலா, நிலையோ திரியா,","words":[{"form":"'சிறு"},{"form":"காலை"},{"form":"இலா,"},{"form":"நிலையோ"},{"form":"திரியா,"}]},{"lineNumber":78,"text":"குறுகா, நெடுகா, குணம் வேறுபடா,","words":[{"form":"குறுகா,"},{"form":"நெடுகா,"},{"form":"குணம்"},{"form":"வேறுபடா,"}]},{"lineNumber":79,"text":"உறு கால் கிளர் பூதம் எலாம் உகினும்","words":[{"form":"உறு"},{"form":"கால்"},{"form":"கிளர்"},{"form":"பூதம்"},{"form":"எலாம்"},{"form":"உகினும்"}]},{"lineNumber":80,"text":"மறுகா, நெறி எய்துவென்;- வான் உடையாய்!'","words":[{"form":"மறுகா,"},{"form":"நெறி"},{"form":"எய்துவென்;-"},{"form":"வான்"},{"form":"உடையாய்!'"}]},{"lineNumber":81,"text":"என்று, இன்ன விளம்பிடும் எல்லையின்வாய்,","words":[{"form":"என்று,"},{"form":"இன்ன"},{"form":"விளம்பிடும்"},{"form":"எல்லையின்வாய்,"}]},{"lineNumber":82,"text":"வன் திண் சிலை வீரரும் வந்து அணுகா,","words":[{"form":"வன்"},{"form":"திண்"},{"form":"சிலை"},{"form":"வீரரும்"},{"form":"வந்து"},{"form":"அணுகா,"}]},{"lineNumber":83,"text":"ஒன்றும் கிளர் ஓதையினால் உணர்வார்,","words":[{"form":"ஒன்றும்"},{"form":"கிளர்"},{"form":"ஓதையினால்"},{"form":"உணர்வார்,"}]},{"lineNumber":84,"text":"நின்று, 'என்னைகொல் இன்னது?' எனா நினைவார்:","words":[{"form":"நின்று,"},{"form":"'என்னைகொல்"},{"form":"இன்னது?'"},{"form":"எனா"},{"form":"நினைவார்:"}]},{"lineNumber":85,"text":"'கொம்பு ஒத்தன நால் ஒளிர் கோள் வயிரக்","words":[{"form":"'கொம்பு"},{"form":"ஒத்தன"},{"form":"நால்"},{"form":"ஒளிர்"},{"form":"கோள்"},{"form":"வயிரக்"}]},{"lineNumber":86,"text":"கம்பக் கரி நின்றது கண்டனமால்;","words":[{"form":"கம்பக்"},{"form":"கரி"},{"form":"நின்றது"},{"form":"கண்டனமால்;"}]},{"lineNumber":87,"text":"இம்பர், தலை மா தவர்பால், இவன் ஆம்","words":[{"form":"இம்பர்,"},{"form":"தலை"},{"form":"மா"},{"form":"தவர்பால்,"},{"form":"இவன்"},{"form":"ஆம்"}]},{"lineNumber":88,"text":"உம்பர்க்கு அரசு எய்தினன்' என்று உணரா,","words":[{"form":"உம்பர்க்கு"},{"form":"அரசு"},{"form":"எய்தினன்'"},{"form":"என்று"},{"form":"உணரா,"}]},{"lineNumber":89,"text":"மானே அனையாளடு மைந்தனை அப்","words":[{"form":"மானே"},{"form":"அனையாளடு"},{"form":"மைந்தனை"},{"form":"அப்"}]},{"lineNumber":90,"text":"பூ நேர் பொழிலின் புறமே நிறுவா,","words":[{"form":"பூ"},{"form":"நேர்"},{"form":"பொழிலின்"},{"form":"புறமே"},{"form":"நிறுவா,"}]},{"lineNumber":91,"text":"ஆன்ஏறு என, ஆள் அரிஏறு இது என,","words":[{"form":"ஆன்ஏறு"},{"form":"என,"},{"form":"ஆள்"},{"form":"அரிஏறு"},{"form":"இது"},{"form":"என,"}]},{"lineNumber":92,"text":"தானே அவ் அகன் பொழில் சாருதலும்,","words":[{"form":"தானே"},{"form":"அவ்"},{"form":"அகன்"},{"form":"பொழில்"},{"form":"சாருதலும்,"}]},{"lineNumber":93,"text":"கண்தாம் அவை ஆயிரமும் கதுவ,","words":[{"form":"கண்தாம்"},{"form":"அவை"},{"form":"ஆயிரமும்"},{"form":"கதுவ,"}]},{"lineNumber":94,"text":"கண் தாமரைபோல் கரு ஞாயிறு எனக்","words":[{"form":"கண்"},{"form":"தாமரைபோல்"},{"form":"கரு"},{"form":"ஞாயிறு"},{"form":"எனக்"}]},{"lineNumber":95,"text":"கண்டான், இமையோர் இறை- காசினியின்","words":[{"form":"கண்டான்,"},{"form":"இமையோர்"},{"form":"இறை-"},{"form":"காசினியின்"}]},{"lineNumber":96,"text":"கண்தான், அரு நான்மறையின் கனியை.","words":[{"form":"கண்தான்,"},{"form":"அரு"},{"form":"நான்மறையின்"},{"form":"கனியை."}]},{"lineNumber":97,"text":"காணா, மனம் நொந்து கவன்றனனால்,","words":[{"form":"காணா,"},{"form":"மனம்"},{"form":"நொந்து"},{"form":"கவன்றனனால்,"}]},{"lineNumber":98,"text":"ஆண் நாதனை, அந்தணர் நாயகனை,","words":[{"form":"ஆண்"},{"form":"நாதனை,"},{"form":"அந்தணர்"},{"form":"நாயகனை,"}]},{"lineNumber":99,"text":"நாள் நாளும் வணங்கிய நன் முடியால்,","words":[{"form":"நாள்"},{"form":"நாளும்"},{"form":"வணங்கிய"},{"form":"நன்"},{"form":"முடியால்,"}]},{"lineNumber":100,"text":"தூண் ஆகிய தோள்கொடு, அவன்-தொழுவான்,","words":[{"form":"தூண்"},{"form":"ஆகிய"},{"form":"தோள்கொடு,"},{"form":"அவன்-தொழுவான்,"}]},{"lineNumber":101,"text":"துவசம் ஆர் தொல் அமருள், துன்னாரைச் செற்றும், சுருதிப் பெருங் கடலின் சொல் பொருள் கற்பித்தும்,","words":[{"form":"துவசம்"},{"form":"ஆர்"},{"form":"தொல்"},{"form":"அமருள்,"},{"form":"துன்னாரைச்"},{"form":"செற்றும்,"},{"form":"சுருதிப்"},{"form":"பெருங்"},{"form":"கடலின்"},{"form":"சொல்"},{"form":"பொருள்"},{"form":"கற்பித்தும்,"}]},{"lineNumber":102,"text":"திவசம் ஆர் நல் அறத்தின் செந்நெறியின் உய்த்தும், திரு அளித்தும், வீடு அளித்தும், சிங்காமைத் தங்கள்","words":[{"form":"திவசம்"},{"form":"ஆர்"},{"form":"நல்"},{"form":"அறத்தின்"},{"form":"செந்நெறியின்"},{"form":"உய்த்தும்,"},{"form":"திரு"},{"form":"அளித்தும்,"},{"form":"வீடு"},{"form":"அளித்தும்,"},{"form":"சிங்காமைத்"},{"form":"தங்கள்"}]},{"lineNumber":103,"text":"கவசம் ஆய், ஆர்உயிர் ஆய், கண் ஆய், மெய்த்தவம் ஆய், கடைஇலா ஞானம் ஆய், காப்பானைக்காணா,","words":[{"form":"கவசம்"},{"form":"ஆய்,"},{"form":"ஆர்உயிர்"},{"form":"ஆய்,"},{"form":"கண்"},{"form":"ஆய்,"},{"form":"மெய்த்தவம்"},{"form":"ஆய்,"},{"form":"கடைஇலா"},{"form":"ஞானம்"},{"form":"ஆய்,"},{"form":"காப்பானைக்காணா,"}]},{"lineNumber":104,"text":"அவசம் ஆய், சிந்தை அழிந்து, அயலே நின்றான், அறியாதான் போல,அறிந்தஎலாம் சொல்வான்:","words":[{"form":"அவசம்"},{"form":"ஆய்,"},{"form":"சிந்தை"},{"form":"அழிந்து,"},{"form":"அயலே"},{"form":"நின்றான்,"},{"form":"அறியாதான்"},{"form":"போல,அறிந்தஎலாம்"},{"form":"சொல்வான்:"}]},{"lineNumber":105,"text":"'தோய்ந்தும், பொருள் அனைத்தும் தோயாது நின்ற சுடரே! தொடக்கு அறுத்தோர் சுற்றமே! பற்றி","words":[{"form":"'தோய்ந்தும்,"},{"form":"பொருள்"},{"form":"அனைத்தும்"},{"form":"தோயாது"},{"form":"நின்ற"},{"form":"சுடரே!"},{"form":"தொடக்கு"},{"form":"அறுத்தோர்"},{"form":"சுற்றமே!"},{"form":"பற்றி"}]},{"lineNumber":106,"text":"நீந்த அரிய நெடுங் கருணைக்கு எல்லாம் நிலயமே! வேதம் நெறி முறையின் நேடி","words":[{"form":"நீந்த"},{"form":"அரிய"},{"form":"நெடுங்"},{"form":"கருணைக்கு"},{"form":"எல்லாம்"},{"form":"நிலயமே!"},{"form":"வேதம்"},{"form":"நெறி"},{"form":"முறையின்"},{"form":"நேடி"}]},{"lineNumber":107,"text":"ஆய்ந்த உணர்வின் உணர்வே! பகையால் அலைப்புண்டு அடியேம் அடி போற்ற, அந் நாள்","words":[{"form":"ஆய்ந்த"},{"form":"உணர்வின்"},{"form":"உணர்வே!"},{"form":"பகையால்"},{"form":"அலைப்புண்டு"},{"form":"அடியேம்"},{"form":"அடி"},{"form":"போற்ற,"},{"form":"அந்"},{"form":"நாள்"}]},{"lineNumber":108,"text":"ஈந்த வரம் உதவ எய்தினையே? எந்தாய்! இரு நிலத்தவோ, நின் இணை அடித் தாமரைதாம்?","words":[{"form":"ஈந்த"},{"form":"வரம்"},{"form":"உதவ"},{"form":"எய்தினையே?"},{"form":"எந்தாய்!"},{"form":"இரு"},{"form":"நிலத்தவோ,"},{"form":"நின்"},{"form":"இணை"},{"form":"அடித்"},{"form":"தாமரைதாம்?"}]},{"lineNumber":109,"text":"'மேவாதவர் இல்லை, மேவினரும் இல்லை; வெளியோடு இருள் இல்லை, மேல் கீழும் இல்லை;","words":[{"form":"'மேவாதவர்"},{"form":"இல்லை,"},{"form":"மேவினரும்"},{"form":"இல்லை;"},{"form":"வெளியோடு"},{"form":"இருள்"},{"form":"இல்லை,"},{"form":"மேல்"},{"form":"கீழும்"},{"form":"இல்லை;"}]},{"lineNumber":110,"text":"மூவாதமை இல்லை, மூத்தமையும் இல்லை; முதல் இடையடு ஈறு இல்லை, முன்னொடு பின் இல்லை;","words":[{"form":"மூவாதமை"},{"form":"இல்லை,"},{"form":"மூத்தமையும்"},{"form":"இல்லை;"},{"form":"முதல்"},{"form":"இடையடு"},{"form":"ஈறு"},{"form":"இல்லை,"},{"form":"முன்னொடு"},{"form":"பின்"},{"form":"இல்லை;"}]},{"lineNumber":111,"text":"தேவா! இங்கு இவ்வோ நின் தொன்று நிலை என்றால், சிலை ஏந்தி வந்து, எம்மைச் சேவடிகள் நோவ,","words":[{"form":"தேவா!"},{"form":"இங்கு"},{"form":"இவ்வோ"},{"form":"நின்"},{"form":"தொன்று"},{"form":"நிலை"},{"form":"என்றால்,"},{"form":"சிலை"},{"form":"ஏந்தி"},{"form":"வந்து,"},{"form":"எம்மைச்"},{"form":"சேவடிகள்"},{"form":"நோவ,"}]},{"lineNumber":112,"text":"காவாது ஒழியின், பழி பெரிதோ? அன்றே; கருங்கடலில் கண்வளராய்! கைம்மாறும் உண்டோ?","words":[{"form":"காவாது"},{"form":"ஒழியின்,"},{"form":"பழி"},{"form":"பெரிதோ?"},{"form":"அன்றே;"},{"form":"கருங்கடலில்"},{"form":"கண்வளராய்!"},{"form":"கைம்மாறும்"},{"form":"உண்டோ?"}]},{"lineNumber":113,"text":"'நாழி, நரை தீர் உலகு எலாம் ஆக, நளினத்து நீ தந்த நான்முகனார்தாமே","words":[{"form":"'நாழி,"},{"form":"நரை"},{"form":"தீர்"},{"form":"உலகு"},{"form":"எலாம்"},{"form":"ஆக,"},{"form":"நளினத்து"},{"form":"நீ"},{"form":"தந்த"},{"form":"நான்முகனார்தாமே"}]},{"lineNumber":114,"text":"ஊழி பலபலவும் நின்று அளந்தால், என்றும் உலவாப் பெருங் குணத்து எம் உத்தமனே! மேல்நாள்,","words":[{"form":"ஊழி"},{"form":"பலபலவும்"},{"form":"நின்று"},{"form":"அளந்தால்,"},{"form":"என்றும்"},{"form":"உலவாப்"},{"form":"பெருங்"},{"form":"குணத்து"},{"form":"எம்"},{"form":"உத்தமனே!"},{"form":"மேல்நாள்,"}]},{"lineNumber":115,"text":"தாழி தரை ஆக, தண் தயிர் நீர் ஆக, தட வரையே மத்து ஆக, தாமரைக் கை நோவ","words":[{"form":"தாழி"},{"form":"தரை"},{"form":"ஆக,"},{"form":"தண்"},{"form":"தயிர்"},{"form":"நீர்"},{"form":"ஆக,"},{"form":"தட"},{"form":"வரையே"},{"form":"மத்து"},{"form":"ஆக,"},{"form":"தாமரைக்"},{"form":"கை"},{"form":"நோவ"}]},{"lineNumber":116,"text":"ஆழிகடைந்து,அமுதம் எங்களுக்கே ஈந்தாய்;-அவுணர்கள்தாம்நின் அடிமை அல்லாமை உண்டோ?","words":[{"form":"ஆழிகடைந்து,அமுதம்"},{"form":"எங்களுக்கே"},{"form":"ஈந்தாய்;-அவுணர்கள்தாம்நின்"},{"form":"அடிமை"},{"form":"அல்லாமை"},{"form":"உண்டோ?"}]},{"lineNumber":117,"text":"'ஒன்று ஆகி, மூலத்து உருவம் பல ஆகி, உணர்வும் உயிரும் பிறிது ஆகி, ஊழி","words":[{"form":"'ஒன்று"},{"form":"ஆகி,"},{"form":"மூலத்து"},{"form":"உருவம்"},{"form":"பல"},{"form":"ஆகி,"},{"form":"உணர்வும்"},{"form":"உயிரும்"},{"form":"பிறிது"},{"form":"ஆகி,"},{"form":"ஊழி"}]},{"lineNumber":118,"text":"சென்று ஆசறும் காலத்து அந் நிலையது ஆகி, திறத்து உலகம்தான் ஆகி, செஞ்செவே நின்ற","words":[{"form":"சென்று"},{"form":"ஆசறும்"},{"form":"காலத்து"},{"form":"அந்"},{"form":"நிலையது"},{"form":"ஆகி,"},{"form":"திறத்து"},{"form":"உலகம்தான்"},{"form":"ஆகி,"},{"form":"செஞ்செவே"},{"form":"நின்ற"}]},{"lineNumber":119,"text":"நன்று ஆய ஞானத் தனிக் கொழுந்தே! எங்கள் நவை தீர்க்கும் நாயகமே! நல் வினையே நோக்கி","words":[{"form":"நன்று"},{"form":"ஆய"},{"form":"ஞானத்"},{"form":"தனிக்"},{"form":"கொழுந்தே!"},{"form":"எங்கள்"},{"form":"நவை"},{"form":"தீர்க்கும்"},{"form":"நாயகமே!"},{"form":"நல்"},{"form":"வினையே"},{"form":"நோக்கி"}]},{"lineNumber":120,"text":"நின்றாரைக் காத்தி; அயலாரைக் காய்தி; நிலை இல்லாத் தீவினையும் நீ தந்தது அன்றே?","words":[{"form":"நின்றாரைக்"},{"form":"காத்தி;"},{"form":"அயலாரைக்"},{"form":"காய்தி;"},{"form":"நிலை"},{"form":"இல்லாத்"},{"form":"தீவினையும்"},{"form":"நீ"},{"form":"தந்தது"},{"form":"அன்றே?"}]},{"lineNumber":121,"text":"'வல்லை வரம்பு இல்லாத மாய வினைதன்னால் மயங்கினரோடு எய்தி, மதி மயங்கி, மேல்நாள்,","words":[{"form":"'வல்லை"},{"form":"வரம்பு"},{"form":"இல்லாத"},{"form":"மாய"},{"form":"வினைதன்னால்"},{"form":"மயங்கினரோடு"},{"form":"எய்தி,"},{"form":"மதி"},{"form":"மயங்கி,"},{"form":"மேல்நாள்,"}]},{"lineNumber":122,"text":"\"அல்லை இறையவன் நீ ஆதி\" என, பேதுற்று அலமருவேம்; முன்னை அறப் பயன் உண்டாக,","words":[{"form":"\"அல்லை"},{"form":"இறையவன்"},{"form":"நீ"},{"form":"ஆதி\""},{"form":"என,"},{"form":"பேதுற்று"},{"form":"அலமருவேம்;"},{"form":"முன்னை"},{"form":"அறப்"},{"form":"பயன்"},{"form":"உண்டாக,"}]},{"lineNumber":123,"text":"\"எல்லை வலயங்கள் நின்னுழை\" என்று, அந் நாள் எரியோனைத் தீண்டி, எழுவர் என நின்ற","words":[{"form":"\"எல்லை"},{"form":"வலயங்கள்"},{"form":"நின்னுழை\""},{"form":"என்று,"},{"form":"அந்"},{"form":"நாள்"},{"form":"எரியோனைத்"},{"form":"தீண்டி,"},{"form":"எழுவர்"},{"form":"என"},{"form":"நின்ற"}]},{"lineNumber":124,"text":"தொல்லை முதல் முனிவர், சூளுற்ற போதே, தொகை நின்ற ஐயம் துடைத்திலையோ? -எந்தாய்!'","words":[{"form":"தொல்லை"},{"form":"முதல்"},{"form":"முனிவர்,"},{"form":"சூளுற்ற"},{"form":"போதே,"},{"form":"தொகை"},{"form":"நின்ற"},{"form":"ஐயம்"},{"form":"துடைத்திலையோ?"},{"form":"-எந்தாய்!'"}]},{"lineNumber":125,"text":"இன்னன பல நினைந்து, ஏத்தினன் இயம்பா,","words":[{"form":"இன்னன"},{"form":"பல"},{"form":"நினைந்து,"},{"form":"ஏத்தினன்"},{"form":"இயம்பா,"}]},{"lineNumber":126,"text":"துன்னுதல் இடை உளது என நனி துணிவான்,","words":[{"form":"துன்னுதல்"},{"form":"இடை"},{"form":"உளது"},{"form":"என"},{"form":"நனி"},{"form":"துணிவான்,"}]},{"lineNumber":127,"text":"தன் நிகர் முனிவனை, 'தர விடை' என்னா,","words":[{"form":"தன்"},{"form":"நிகர்"},{"form":"முனிவனை,"},{"form":"'தர"},{"form":"விடை'"},{"form":"என்னா,"}]},{"lineNumber":128,"text":"பொன் ஒளிர் நெடு முடிப் புரந்தரன் போனான்.","words":[{"form":"பொன்"},{"form":"ஒளிர்"},{"form":"நெடு"},{"form":"முடிப்"},{"form":"புரந்தரன்"},{"form":"போனான்."}]},{"lineNumber":129,"text":"போனவன் அக நிலை புலமையின் உணர்வான்","words":[{"form":"போனவன்"},{"form":"அக"},{"form":"நிலை"},{"form":"புலமையின்"},{"form":"உணர்வான்"}]},{"lineNumber":130,"text":"வானவர் தலைவனை வரவு எதிர்கொண்டான்;","words":[{"form":"வானவர்"},{"form":"தலைவனை"},{"form":"வரவு"},{"form":"எதிர்கொண்டான்;"}]},{"lineNumber":131,"text":"ஆனவன் அடி தொழ, அருள் வர, அழுதான்","words":[{"form":"ஆனவன்"},{"form":"அடி"},{"form":"தொழ,"},{"form":"அருள்"},{"form":"வர,"},{"form":"அழுதான்"}]},{"lineNumber":132,"text":"தானுடை இட வகை தழுவினன், நுழைவான்.","words":[{"form":"தானுடை"},{"form":"இட"},{"form":"வகை"},{"form":"தழுவினன்,"},{"form":"நுழைவான்."}]},{"lineNumber":133,"text":"'ஏழையும் இளவலும் வருக' என, இனிதா","words":[{"form":"'ஏழையும்"},{"form":"இளவலும்"},{"form":"வருக'"},{"form":"என,"},{"form":"இனிதா"}]},{"lineNumber":134,"text":"வாழிய அவரொடும் வள்ளலும் மகிழ்வால்,","words":[{"form":"வாழிய"},{"form":"அவரொடும்"},{"form":"வள்ளலும்"},{"form":"மகிழ்வால்,"}]},{"lineNumber":135,"text":"ஊழியின் முதல் முனி உறையுளை அணுக,","words":[{"form":"ஊழியின்"},{"form":"முதல்"},{"form":"முனி"},{"form":"உறையுளை"},{"form":"அணுக,"}]},{"lineNumber":136,"text":"ஆழியில் அறிதுயிலவன் என மகிழ்வான்.","words":[{"form":"ஆழியில்"},{"form":"அறிதுயிலவன்"},{"form":"என"},{"form":"மகிழ்வான்."}]},{"lineNumber":137,"text":"அவ் வயின், அழகனும் வைகினன் -அறிஞன்","words":[{"form":"அவ்"},{"form":"வயின்,"},{"form":"அழகனும்"},{"form":"வைகினன்"},{"form":"-அறிஞன்"}]},{"lineNumber":138,"text":"செவ்விய அற உரை செவிவயின் உதவ,","words":[{"form":"செவ்விய"},{"form":"அற"},{"form":"உரை"},{"form":"செவிவயின்"},{"form":"உதவ,"}]},{"lineNumber":139,"text":"நவ்வியின் விழியவளடு, நனி இருளைக்","words":[{"form":"நவ்வியின்"},{"form":"விழியவளடு,"},{"form":"நனி"},{"form":"இருளைக்"}]},{"lineNumber":140,"text":"கவ்விய நிசி ஒரு கடையுறும் அளவின்.","words":[{"form":"கவ்விய"},{"form":"நிசி"},{"form":"ஒரு"},{"form":"கடையுறும்"},{"form":"அளவின்."}]},{"lineNumber":141,"text":"விலகிடு நிழலினன், வெயில் விரி அயில் வாள்","words":[{"form":"விலகிடு"},{"form":"நிழலினன்,"},{"form":"வெயில்"},{"form":"விரி"},{"form":"அயில்"},{"form":"வாள்"}]},{"lineNumber":142,"text":"இலகிடு சுடரவன், இசையன திசை தோய்,","words":[{"form":"இலகிடு"},{"form":"சுடரவன்,"},{"form":"இசையன"},{"form":"திசை"},{"form":"தோய்,"}]},{"lineNumber":143,"text":"அலகிடல் அரிய, தன் அவிர் கர நிரையால்,","words":[{"form":"அலகிடல்"},{"form":"அரிய,"},{"form":"தன்"},{"form":"அவிர்"},{"form":"கர"},{"form":"நிரையால்,"}]},{"lineNumber":144,"text":"உலகு இடு நிறை இருள் உறையினை உரிவான்.","words":[{"form":"உலகு"},{"form":"இடு"},{"form":"நிறை"},{"form":"இருள்"},{"form":"உறையினை"},{"form":"உரிவான்."}]},{"lineNumber":145,"text":"ஆயிடை, அறிஞனும், அவன் எதிர் அழுவத்","words":[{"form":"ஆயிடை,"},{"form":"அறிஞனும்,"},{"form":"அவன்"},{"form":"எதிர்"},{"form":"அழுவத்"}]},{"lineNumber":146,"text":"தீயிடை நுழைவது ஒர் தெளிவினை உடையான்,","words":[{"form":"தீயிடை"},{"form":"நுழைவது"},{"form":"ஒர்"},{"form":"தெளிவினை"},{"form":"உடையான்,"}]},{"lineNumber":147,"text":"'நீ விடை தருக' என நிறுவினன், நெறியால்,","words":[{"form":"'நீ"},{"form":"விடை"},{"form":"தருக'"},{"form":"என"},{"form":"நிறுவினன்,"},{"form":"நெறியால்,"}]},{"lineNumber":148,"text":"காய் எரி வரன் முறை கடிதினில் இடுவான்.","words":[{"form":"காய்"},{"form":"எரி"},{"form":"வரன்"},{"form":"முறை"},{"form":"கடிதினில்"},{"form":"இடுவான்."}]},{"lineNumber":149,"text":"வரி சிலை உழவனும், மறை உழவனை, 'நீ","words":[{"form":"வரி"},{"form":"சிலை"},{"form":"உழவனும்,"},{"form":"மறை"},{"form":"உழவனை,"},{"form":"'நீ"}]},{"lineNumber":150,"text":"புரி தொழில் எனை? அது புகலுதி' எனலும்,","words":[{"form":"புரி"},{"form":"தொழில்"},{"form":"எனை?"},{"form":"அது"},{"form":"புகலுதி'"},{"form":"எனலும்,"}]},{"lineNumber":151,"text":"'திருமகள் தலைவ! செய் திருவினை உற, யான்","words":[{"form":"'திருமகள்"},{"form":"தலைவ!"},{"form":"செய்"},{"form":"திருவினை"},{"form":"உற,"},{"form":"யான்"}]},{"lineNumber":152,"text":"எரி புக நினைகுவென்; அருள்' என, இறைவன்:","words":[{"form":"எரி"},{"form":"புக"},{"form":"நினைகுவென்;"},{"form":"அருள்'"},{"form":"என,"},{"form":"இறைவன்:"}]},{"lineNumber":153,"text":"'யான் வரும் அமைதியின் இது செயல் எவனோ?-","words":[{"form":"'யான்"},{"form":"வரும்"},{"form":"அமைதியின்"},{"form":"இது"},{"form":"செயல்"},{"form":"எவனோ?-"}]},{"lineNumber":154,"text":"மான் வரு தனி உரி மார்பினை!' எனலும்,","words":[{"form":"மான்"},{"form":"வரு"},{"form":"தனி"},{"form":"உரி"},{"form":"மார்பினை!'"},{"form":"எனலும்,"}]},{"lineNumber":155,"text":"மீன் வரு கொடியவன் விறல் அடும் மறவோன்","words":[{"form":"மீன்"},{"form":"வரு"},{"form":"கொடியவன்"},{"form":"விறல்"},{"form":"அடும்"},{"form":"மறவோன்"}]},{"lineNumber":156,"text":"ஊன் விடும் உவகையின் உரை நனி புரிவான்:","words":[{"form":"ஊன்"},{"form":"விடும்"},{"form":"உவகையின்"},{"form":"உரை"},{"form":"நனி"},{"form":"புரிவான்:"}]},{"lineNumber":157,"text":"'ஆயிர முகம் உள தவம் அயர்குவென், யான்;","words":[{"form":"'ஆயிர"},{"form":"முகம்"},{"form":"உள"},{"form":"தவம்"},{"form":"அயர்குவென்,"},{"form":"யான்;"}]},{"lineNumber":158,"text":"\"நீ இவண் வருகுதி\" எனும் நினைவு உடையேன்;","words":[{"form":"\"நீ"},{"form":"இவண்"},{"form":"வருகுதி\""},{"form":"எனும்"},{"form":"நினைவு"},{"form":"உடையேன்;"}]},{"lineNumber":159,"text":"போயின இரு வினை; புகலுறு விதியால்","words":[{"form":"போயின"},{"form":"இரு"},{"form":"வினை;"},{"form":"புகலுறு"},{"form":"விதியால்"}]},{"lineNumber":160,"text":"மேயினை; இனி ஒரு வினை இலை;-விறலோய்!","words":[{"form":"மேயினை;"},{"form":"இனி"},{"form":"ஒரு"},{"form":"வினை"},{"form":"இலை;-விறலோய்!"}]},{"lineNumber":161,"text":"'இந்திரன் அருளினன் இறுதி செய் பகலா","words":[{"form":"'இந்திரன்"},{"form":"அருளினன்"},{"form":"இறுதி"},{"form":"செய்"},{"form":"பகலா"}]},{"lineNumber":162,"text":"வந்தனன், \"மருவுதி மலர் அயன் உலகம்;","words":[{"form":"வந்தனன்,"},{"form":"\"மருவுதி"},{"form":"மலர்"},{"form":"அயன்"},{"form":"உலகம்;"}]},{"lineNumber":163,"text":"தந்தனென்\" என, 'அது சாரலென்,-உரவோய்!-","words":[{"form":"தந்தனென்\""},{"form":"என,"},{"form":"'அது"},{"form":"சாரலென்,-உரவோய்!-"}]},{"lineNumber":164,"text":"அந்தம் இல் உயர் பதம் அடைதலை முயல்வேன்.","words":[{"form":"அந்தம்"},{"form":"இல்"},{"form":"உயர்"},{"form":"பதம்"},{"form":"அடைதலை"},{"form":"முயல்வேன்."}]},{"lineNumber":165,"text":"'ஆதலின், இது பெற அருள்' என உரையா,","words":[{"form":"'ஆதலின்,"},{"form":"இது"},{"form":"பெற"},{"form":"அருள்'"},{"form":"என"},{"form":"உரையா,"}]},{"lineNumber":166,"text":"காதலி அவளடு கதழ் எரி முழுகி,","words":[{"form":"காதலி"},{"form":"அவளடு"},{"form":"கதழ்"},{"form":"எரி"},{"form":"முழுகி,"}]},{"lineNumber":167,"text":"போதலை மருவினன், ஒரு நெறி-புகலா","words":[{"form":"போதலை"},{"form":"மருவினன்,"},{"form":"ஒரு"},{"form":"நெறி-புகலா"}]},{"lineNumber":168,"text":"வேதமும் அறிவு அரு மிகு பொருள் உணர்வோன்.","words":[{"form":"வேதமும்"},{"form":"அறிவு"},{"form":"அரு"},{"form":"மிகு"},{"form":"பொருள்"},{"form":"உணர்வோன்."}]},{"lineNumber":169,"text":"தேவரும், முனிவரும், உறுவது தெரிவோர்,","words":[{"form":"தேவரும்,"},{"form":"முனிவரும்,"},{"form":"உறுவது"},{"form":"தெரிவோர்,"}]},{"lineNumber":170,"text":"மா வரும் நறு விரை மலர் அயன் முதலோர்,","words":[{"form":"மா"},{"form":"வரும்"},{"form":"நறு"},{"form":"விரை"},{"form":"மலர்"},{"form":"அயன்"},{"form":"முதலோர்,"}]},{"lineNumber":171,"text":"ஏவரும், அறிவினில் இரு வினை ஒருவி,","words":[{"form":"ஏவரும்,"},{"form":"அறிவினில்"},{"form":"இரு"},{"form":"வினை"},{"form":"ஒருவி,"}]},{"lineNumber":172,"text":"போவது கருதும் அவ் அரு நெறி புக்கான்.","words":[{"form":"போவது"},{"form":"கருதும்"},{"form":"அவ்"},{"form":"அரு"},{"form":"நெறி"},{"form":"புக்கான்."}]},{"lineNumber":173,"text":"அண்டமும் அகிலமும் அறிவு அரு நெறியால்","words":[{"form":"அண்டமும்"},{"form":"அகிலமும்"},{"form":"அறிவு"},{"form":"அரு"},{"form":"நெறியால்"}]},{"lineNumber":174,"text":"உண்டவன் ஒரு பெயர் உணர்குநர் உறு பேறு","words":[{"form":"உண்டவன்"},{"form":"ஒரு"},{"form":"பெயர்"},{"form":"உணர்குநர்"},{"form":"உறு"},{"form":"பேறு"}]},{"lineNumber":175,"text":"எண் தவ நெடிதுஎனின், இறுதியில் அவனைக்","words":[{"form":"எண்"},{"form":"தவ"},{"form":"நெடிதுஎனின்,"},{"form":"இறுதியில்"},{"form":"அவனைக்"}]},{"lineNumber":176,"text":"கண்டவர் உறு பொருள் கருதுவது எளிதோ?","words":[{"form":"கண்டவர்"},{"form":"உறு"},{"form":"பொருள்"},{"form":"கருதுவது"},{"form":"எளிதோ?"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%95%E0%AE%AE%E0%AF%8D%E0%AE%AA%E0%AE%B0%E0%AE%BE%E0%AE%AE%E0%AE%BE%E0%AE%AF%E0%AE%A3%E0%AE%AE%E0%AF%8D/%E0%AE%86%E0%AE%B0%E0%AE%A3%E0%AE%BF%E0%AE%AF_%E0%AE%95%E0%AE%BE%E0%AE%A3%E0%AF%8D%E0%AE%9F%E0%AE%AE%E