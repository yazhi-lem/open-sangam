ுந்தெரு"},{"form":"ஒத்தது"},{"form":"-"},{"form":"அப்"},{"form":"படை"},{"form":"செல்"},{"form":"ஆறு"},{"form":"அரோ!"}]},{"lineNumber":185,"text":"'தார்கள் தாம், கோதைதாம், தாமம்தாம், தகை","words":[{"form":"'தார்கள்"},{"form":"தாம்,"},{"form":"கோதைதாம்,"},{"form":"தாமம்தாம்,"},{"form":"தகை"}]},{"lineNumber":186,"text":"ஏர்கள் தாம், கலவை தாம், கமழ்ந்தின்று என்பரால்-","words":[{"form":"ஏர்கள்"},{"form":"தாம்,"},{"form":"கலவை"},{"form":"தாம்,"},{"form":"கமழ்ந்தின்று"},{"form":"என்பரால்-"}]},{"lineNumber":187,"text":"கார்கள் தாம் என மிகக் கடுத்த கைம்மலை","words":[{"form":"கார்கள்"},{"form":"தாம்"},{"form":"என"},{"form":"மிகக்"},{"form":"கடுத்த"},{"form":"கைம்மலை"}]},{"lineNumber":188,"text":"வார் கடாம் அல்லது, அம் மன்னன் சேனையே.","words":[{"form":"வார்"},{"form":"கடாம்"},{"form":"அல்லது,"},{"form":"அம்"},{"form":"மன்னன்"},{"form":"சேனையே."}]},{"lineNumber":189,"text":"ஆள் உலாம் கடலினும் அகன்ற அக்கடல்,","words":[{"form":"ஆள்"},{"form":"உலாம்"},{"form":"கடலினும்"},{"form":"அகன்ற"},{"form":"அக்கடல்,"}]},{"lineNumber":190,"text":"தோள் உலாம் குண்டலம் முதல தொல் அணி","words":[{"form":"தோள்"},{"form":"உலாம்"},{"form":"குண்டலம்"},{"form":"முதல"},{"form":"தொல்"},{"form":"அணி"}]},{"lineNumber":191,"text":"கேள் உலாம் மின் ஒளி கிளர்ந்தது இல்லையால்வ","words":[{"form":"கேள்"},{"form":"உலாம்"},{"form":"மின்"},{"form":"ஒளி"},{"form":"கிளர்ந்தது"},{"form":"இல்லையால்வ"}]},{"lineNumber":192,"text":"¡ள் உலாம் நுதலியர் மருங்குல் அல்லதே.","words":[{"form":"¡ள்"},{"form":"உலாம்"},{"form":"நுதலியர்"},{"form":"மருங்குல்"},{"form":"அல்லதே."}]},{"lineNumber":193,"text":"மத்தளம் முதலிய வயங்கு பல் இயம்","words":[{"form":"மத்தளம்"},{"form":"முதலிய"},{"form":"வயங்கு"},{"form":"பல்"},{"form":"இயம்"}]},{"lineNumber":194,"text":"ஒத்தன சேறலின், உரை இலாமையின்,","words":[{"form":"ஒத்தன"},{"form":"சேறலின்,"},{"form":"உரை"},{"form":"இலாமையின்,"}]},{"lineNumber":195,"text":"சித்திரச் சுவர் நெடுஞ் சேனை தீட்டிய","words":[{"form":"சித்திரச்"},{"form":"சுவர்"},{"form":"நெடுஞ்"},{"form":"சேனை"},{"form":"தீட்டிய"}]},{