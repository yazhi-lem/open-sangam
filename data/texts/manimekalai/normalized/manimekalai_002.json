ும்"},{"form":"பல"},{"form":"உடன்"},{"form":"பரப்புமின்"}]},{"lineNumber":46,"text":"காய்க் குலைக் கமுகும் வாழையும் வஞ்சியும்","words":[{"form":"காய்க்"},{"form":"குலைக்"},{"form":"கமுகும்"},{"form":"வாழையும்"},{"form":"வஞ்சியும்"}]},{"lineNumber":47,"text":"பூக் கொடி வல்லியும் கரும்பும் நடுமின்","words":[{"form":"பூக்"},{"form":"கொடி"},{"form":"வல்லியும்"},{"form":"கரும்பும்"},{"form":"நடுமின்"}]},{"lineNumber":48,"text":"பத்தி வேதிகைப் பசும் பொன் தூணத்து","words":[{"form":"பத்தி"},{"form":"வேதிகைப்"},{"form":"பசும்"},{"form":"பொன்"},{"form":"தூணத்து"}]},{"lineNumber":49,"text":"முத்துத் தாமம் முறையொடு நாற்றுமின்","words":[{"form":"முத்துத்"},{"form":"தாமம்"},{"form":"முறையொடு"},{"form":"நாற்றுமின்"}]},{"lineNumber":50,"text":"விழவு மலி மூதூர் வீதியும் மன்றமும்.","words":[{"form":"விழவு"},{"form":"மலி"},{"form":"மூதூர்"},{"form":"வீதியும்"},{"form":"மன்றமும்."}]},{"lineNumber":51,"text":"பழ மணல் மாற்றுமின் புது மணல் பரப்புமின்","words":[{"form":"பழ"},{"form":"மணல்"},{"form":"மாற்றுமின்"},{"form":"புது"},{"form":"மணல்"},{"form":"பரப்புமின்"}]},{"lineNumber":52,"text":"கதலிகைக் கொடியும் காழ் ஊன்று விலோதமும்","words":[{"form":"கதலிகைக்"},{"form":"கொடியும்"},{"form":"காழ்"},{"form":"ஊன்று"},{"form":"விலோதமும்"}]},{"lineNumber":53,"text":"மதலை மாடமும் வாயிலும் சேர்த்துமின்","words":[{"form":"மதலை"},{"form":"மாடமும்"},{"form":"வாயிலும்"},{"form":"சேர்த்துமின்"}]},{"lineNumber":54,"text":"நுதல் விழி நாட்டத்து இறையோன் முதலா","words":[{"form":"நுதல்"},{"form":"விழி"},{"form":"நாட்டத்து"},{"form":"இறையோன்"},{"form":"முதலா"}]},{"lineNumber":55,"text":"பதி வாழ் சதுக்கத்துத் தெய்வம் ஈறு ஆக","words":[{"form":"பதி"},{"form":"வாழ்"},{"form":"சதுக்கத்துத்"},{"form":"தெய்வம்"},{"form":"ஈறு"},{"form":"ஆக"}]},{"lineNumber":56,"text":"வேறுவேறு சிறப்பின் வேறுவேறு செய்வினை","words":[{"form":"வேறுவேறு"},{"form":"சிறப்பின்"},{"form":"வேறுவேறு"},{"form":"செய்வினை"}]},{"lineNumber":57,"text":"ஆறு அறி மரபின் அறிந்தோர் செய்யுமின்","words":[{"form":"ஆறு"},{"form":"அறி"},{"form":"மரபின்"},{"form":"அறிந்தோர்"},{"form":"செய்யுமின்"}]},{"lineNumber":58,"text":"தண் மணல் பந்தரும் தாழ்தரு பொதியிலும்","words":[{"form":"தண்"},{"form":"மணல்"},{"form":"பந்தரும்"},{"form":"தாழ்தரு"},{"form":"பொதியிலும்"}]},{"lineNumber":59,"text":"புண்ணிய நல்லுரை அறிவீர்! பொருந்துமின்","words":[{"form":"புண்ணிய"},{"form":"நல்லுரை"},{"form":"அறிவீர்!"},{"form":"பொருந்துமின்"}]},{"lineNumber":60,"text":"ஒட்டிய சமயத்து உறு பொருள் வாதிகள்.","words":[{"form":"ஒட்டிய"},{"form":"சமயத்து"},{"form":"உறு"},{"form":"பொருள்"},{"form":"வாதிகள்."}]},{"lineNumber":61,"text":"பட்டி மண்டபத்து பாங்கு அறிந்து ஏறுமின்","words":[{"form":"பட்டி"},{"form":"மண்டபத்து"},{"form":"பாங்கு"},{"form":"அறிந்து"},{"form":"ஏறுமின்"}]},{"lineNumber":62,"text":"பற்றாமாக்கள் தம்முடன் ஆயினும்","words":[{"form":"பற்றாமாக்கள்"},{"form":"தம்முடன்"},{"form":"ஆயினும்"}]},{"lineNumber":63,"text":"செற்றமும் கலாமும் செய்யாது அகலுமின்","words":[{"form":"செற்றமும்"},{"form":"கலாமும்"},{"form":"செய்யாது"},{"form":"அகலுமின்"}]},{"lineNumber":64,"text":"வெண் மணல் குன்றமும் விரி பூஞ் சோலையும்","words":[{"form":"வெண்"},{"form":"மணல்"},{"form":"குன்றமும்"},{"form":"விரி"},{"form":"பூஞ்"},{"form":"சோலையும்"}]},{"lineNumber":65,"text":"தண் மணல் துருத்தியும் தாழ் பூந் துறைகளும்","words":[{"form":"தண்"},{"form":"மணல்"},{"form":"துருத்தியும்"},{"form":"தாழ்"},{"form":"பூந்"},{"form":"துறைகளும்"}]},{"lineNumber":66,"text":"தேவரும் மக்களும் ஒத்து உடன் திரிதரும்","words":[{"form":"தேவரும்"},{"form":"மக்களும்"},{"form":"ஒத்து"},{"form":"உடன்"},{"form":"திரிதரும்"}]},{"lineNumber":67,"text":"நால் ஏழ் நாளினும் நன்கு அறிந்தீர் என","words":[{"form":"நால்"},{"form":"ஏழ்"},{"form":"நாளினும்"},{"form":"நன்கு"},{"form":"அறிந்தீர்"},{"form":"என"}]},{"lineNumber":68,"text":"ஒளிறு வாள் மறவரும் தேரும் மாவும்","words":[{"form":"ஒளிறு"},{"form":"வாள்"},{"form":"மறவரும்"},{"form":"தேரும்"},{"form":"மாவும்"}]},{"lineNumber":69,"text":"களிறும் சூழ்தர கண் முரசு இயம்பி","words":[{"form":"களிறும்"},{"form":"சூழ்தர"},{"form":"கண்"},{"form":"முரசு"},{"form":"இயம்பி"