ு"}]},{"lineNumber":140,"text":"நா நனி வருந்த என் நலம் பாராட்டலின் -----------------------------------------------21-140","words":[{"form":"நா"},{"form":"நனி"},{"form":"வருந்த"},{"form":"என்"},{"form":"நலம்"},{"form":"பாராட்டலின்"},{"form":"-----------------------------------------------21-140"}]},{"lineNumber":141,"text":"மணிமேகலை! யான் வரு பொருள் எல்லாம்","words":[{"form":"மணிமேகலை!"},{"form":"யான்"},{"form":"வரு"},{"form":"பொருள்"},{"form":"எல்லாம்"}]},{"lineNumber":142,"text":"துணிவுடன் உரைத்தேன் என் சொல் தேறு' என","words":[{"form":"துணிவுடன்"},{"form":"உரைத்தேன்"},{"form":"என்"},{"form":"சொல்"},{"form":"தேறு'"},{"form":"என"}]},{"lineNumber":143,"text":"\"தேறேன் அல்லேன் தெய்வக் கிளவிகள்","words":[{"form":"\"தேறேன்"},{"form":"அல்லேன்"},{"form":"தெய்வக்"},{"form":"கிளவிகள்"}]},{"lineNumber":144,"text":"ஈறு கடைபோக எனக்கு அருள்?\" என்றலும்","words":[{"form":"ஈறு"},{"form":"கடைபோக"},{"form":"எனக்கு"},{"form":"அருள்?\""},{"form":"என்றலும்"}]},{"lineNumber":145,"text":"துவதிகன் உரைக்கும்' சொல்லலும் சொல்லுவேன்","words":[{"form":"துவதிகன்"},{"form":"உரைக்கும்'"},{"form":"சொல்லலும்"},{"form":"சொல்லுவேன்"}]},{"lineNumber":146,"text":"வருவது கேளாய் மடக் கொடி நல்லாய்!","words":[{"form":"வருவது"},{"form":"கேளாய்"},{"form":"மடக்"},{"form":"கொடி"},{"form":"நல்லாய்!"}]},{"lineNumber":147,"text":"மன் உயிர் நீங்க மழை வளம் கரந்து","words":[{"form":"மன்"},{"form":"உயிர்"},{"form":"நீங்க"},{"form":"மழை"},{"form":"வளம்"},{"form":"கரந்து"}]},{"lineNumber":148,"text":"பொன் எயில் காஞ்சி நகர் கவின் அழிய","words":[{"form":"பொன்"},{"form":"எயில்"},{"form":"காஞ்சி"},{"form":"நகர்"},{"form":"கவின்"},{"form":"அழிய"}]},{"lineNumber":149,"text":"ஆங்கு அது கேட்டே ஆர் உயிர் மருந்தாய்","words":[{"form":"ஆங்கு"},{"form":"அது"},{"form":"கேட்டே"},{"form":"ஆர்"},{"form":"உயிர்"},{"form":"மருந்தாய்"}]},{"lineNumber":150,"text":"ஈங்கு இம் முதியாள் இடவயின் வைத்த ------------------------------------------------21-150","words":[{"form":"ஈங்கு"},{"form":"இம்"},{"form":"முதியாள்"},{"form":"இடவயின்"},{"form":"