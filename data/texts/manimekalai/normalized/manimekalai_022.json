ையும்"},{"form":"பேசா"},{"form":"என்பது"}]},{"lineNumber":117,"text":"அறிதலும் அறிதியோ? அறியாய்கொல்லோ?","words":[{"form":"அறிதலும்"},{"form":"அறிதியோ?"},{"form":"அறியாய்கொல்லோ?"}]},{"lineNumber":118,"text":"அறியாய் ஆயின் ஆங்கு அது கேளாய்!","words":[{"form":"அறியாய்"},{"form":"ஆயின்"},{"form":"ஆங்கு"},{"form":"அது"},{"form":"கேளாய்!"}]},{"lineNumber":119,"text":"முடித்து வரு சிறப்பின் மூதூர் யாங்கணும்","words":[{"form":"முடித்து"},{"form":"வரு"},{"form":"சிறப்பின்"},{"form":"மூதூர்"},{"form":"யாங்கணும்"}]},{"lineNumber":120,"text":"கொடித் தேர் வீதியும் தேவர் கோட்டமும் ---------------------------------------------21-120","words":[{"form":"கொடித்"},{"form":"தேர்"},{"form":"வீதியும்"},{"form":"தேவர்"},{"form":"கோட்டமும்"},{"form":"---------------------------------------------21-120"}]},{"lineNumber":121,"text":"முது மர இடங்களும் முது நீர்த் துறைகளும்","words":[{"form":"முது"},{"form":"மர"},{"form":"இடங்களும்"},{"form":"முது"},{"form":"நீர்த்"},{"form":"துறைகளும்"}]},{"lineNumber":122,"text":"பொதியிலும் மன்றமும் பொருந்துபு நாடி","words":[{"form":"பொதியிலும்"},{"form":"மன்றமும்"},{"form":"பொருந்துபு"},{"form":"நாடி"}]},{"lineNumber":123,"text":"காப்பு உடை மா நகர்க் காவலும் கண்ணி","words":[{"form":"காப்பு"},{"form":"உடை"},{"form":"மா"},{"form":"நகர்க்"},{"form":"காவலும்"},{"form":"கண்ணி"}]},{"lineNumber":124,"text":"யாப்பு உடைத்தாக அறிந்தோர் வலித்து","words":[{"form":"யாப்பு"},{"form":"உடைத்தாக"},{"form":"அறிந்தோர்"},{"form":"வலித்து"}]},{"lineNumber":125,"text":"மண்ணினும் கல்லினும் மரத்தினும் சுவரினும்","words":[{"form":"மண்ணினும்"},{"form":"கல்லினும்"},{"form":"மரத்தினும்"},{"form":"சுவரினும்"}]},{"lineNumber":126,"text":"கண்ணிய தெய்வதம் காட்டுநர் வகுக்க","words":[{"form":"கண்ணிய"},{"form":"தெய்வதம்"},{"form":"காட்டுநர்"},{"form":"வகுக்க"}]},{"lineNumber":127,"text":"ஆங்கு அத் தெய்வதம் அவ் இடம் நீங்கா","words":[{"form":"ஆங்கு"},{"form":"அத்"},{"form":"தெய்வதம்"},{"form":"அவ்"},{"form":"இடம்"},{"form":"நீங்கா"}]},{"lineNumber":128,"text":"ஊன் கண்ணினார்கட்கு உற்றதை உரைக்கு