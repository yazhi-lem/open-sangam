்கு துயில் எய்திய சுதமதி ஒழியப்","words":[{"form":"தூங்கு"},{"form":"துயில்"},{"form":"எய்திய"},{"form":"சுதமதி"},{"form":"ஒழியப்"}]},{"lineNumber":210,"text":"பூங்கொடி தன்னைப் பொருந்தித் தழீஇ","words":[{"form":"பூங்கொடி"},{"form":"தன்னைப்"},{"form":"பொருந்தித்"},{"form":"தழீஇ"}]},{"lineNumber":211,"text":"அந்தரம் ஆறா ஆறு ஐந்து யோசனைத்","words":[{"form":"அந்தரம்"},{"form":"ஆறா"},{"form":"ஆறு"},{"form":"ஐந்து"},{"form":"யோசனைத்"}]},{"lineNumber":212,"text":"தென் திசை மருங்கில் சென்று திரை உடுத்த","words":[{"form":"தென்"},{"form":"திசை"},{"form":"மருங்கில்"},{"form":"சென்று"},{"form":"திரை"},{"form":"உடுத்த"}]},{"lineNumber":213,"text":"மணிபல்லவத்திடை மணிமேகலா தெய்வம்","words":[{"form":"மணிபல்லவத்திடை"},{"form":"மணிமேகலா"},{"form":"தெய்வம்"}]},{"lineNumber":214,"text":"அணி இழை தன்னை வைத்து அகன்றது தான் என்","words":[{"form":"அணி"},{"form":"இழை"},{"form":"தன்னை"},{"form":"வைத்து"},{"form":"அகன்றது"},{"form":"தான்"},{"form":"என்"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AE%E0%AE%A3%E0%AE%BF%E0%AE%AE%E0%AF%87%E0%AE%95%E0%AE%B2%E0%AF%88","verified":false,"structure":{"level":"kadai","book":null,"chapter":"சக்கரவாளக் கோட்டம் உரைத்த காதை","chapterNumber":6,"number":6,"verseCount":null},"title":"சக்கரவாளக் கோட்டம் உரைத்த காதை"}
