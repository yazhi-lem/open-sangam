{"lineNumber":53,"text":"வான் தரு கற்பின் மனையறம் பட்டேன்","words":[{"form":"வான்"},{"form":"தரு"},{"form":"கற்பின்"},{"form":"மனையறம்"},{"form":"பட்டேன்"}]},{"lineNumber":54,"text":"யான் செய் குற்றம் யான் அறிகில்லேன்","words":[{"form":"யான்"},{"form":"செய்"},{"form":"குற்றம்"},{"form":"யான்"},{"form":"அறிகில்லேன்"}]},{"lineNumber":55,"text":"பொய்யினைகொல்லோ பூத சதுக்கத்துத்","words":[{"form":"பொய்யினைகொல்லோ"},{"form":"பூத"},{"form":"சதுக்கத்துத்"}]},{"lineNumber":56,"text":"தெய்வம் நீ\" எனச் சேயிழை அரற்றலும்","words":[{"form":"தெய்வம்"},{"form":"நீ\""},{"form":"எனச்"},{"form":"சேயிழை"},{"form":"அரற்றலும்"}]},{"lineNumber":57,"text":"மா பெரும் பூதம் தோன்றி \"மடக்கொடி!","words":[{"form":"மா"},{"form":"பெரும்"},{"form":"பூதம்"},{"form":"தோன்றி"},{"form":"\"மடக்கொடி!"}]},{"lineNumber":58,"text":"நீ கேள்\" என்றே நேர் இழைக்கு உரைக்கும்","words":[{"form":"நீ"},{"form":"கேள்\""},{"form":"என்றே"},{"form":"நேர்"},{"form":"இழைக்கு"},{"form":"உரைக்கும்"}]},{"lineNumber":59,"text":"\"தெய்வம் தொழா அள் கொழுநன் தொழுது எழுவாள்","words":[{"form":"\"தெய்வம்"},{"form":"தொழா"},{"form":"அள்"},{"form":"கொழுநன்"},{"form":"தொழுது"},{"form":"எழுவாள்"}]},{"lineNumber":60,"text":"பெய் எனப் பெய்யும் பெரு மழை\" என்ற அப் ---------------------------------------------22-060","words":[{"form":"பெய்"},{"form":"எனப்"},{"form":"பெய்யும்"},{"form":"பெரு"},{"form":"மழை\""},{"form":"என்ற"},{"form":"அப்"},{"form":"---------------------------------------------22-060"}]},{"lineNumber":61,"text":"பொய்யில் புலவன் பொருளுரை தேறாய்!","words":[{"form":"பொய்யில்"},{"form":"புலவன்"},{"form":"பொருளுரை"},{"form":"தேறாய்!"}]},{"lineNumber":62,"text":"பிசியும் நொடியும் பிறர் வாய்க் கேட்டு","words":[{"form":"பிசியும்"},{"form":"நொடியும்"},{"form":"பிறர்"},{"form":"வாய்க்"},{"form":"கேட்டு"}]},{"lineNumber":63,"text":"விசி பிணி முழவின் விழாக் கோள் விரும்பி","words":[{"form":"விசி"},{"form":"பிணி"},{"form":"முழவின்"},{"form":"விழாக்"},{"form":"கோள்"},{"form":"விரும்பி"}]},{"lineNumber":64,"text":"கடவுள் பேணல் கடவியை ஆகலின்