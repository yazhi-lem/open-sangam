orm":"அருந்த"},{"form":"ஏமாந்த"},{"form":"ஆர்"},{"form":"உயிர்"},{"form":"தளிர்ப்ப"}]},{"lineNumber":73,"text":"விருந்தின் மூரல் அரும்பியதூஉம்","words":[{"form":"விருந்தின்"},{"form":"மூரல்"},{"form":"அரும்பியதூஉம்"}]},{"lineNumber":74,"text":"மா இதழ்க் குவளை மலர் புறத்து ஓட்டிக்","words":[{"form":"மா"},{"form":"இதழ்க்"},{"form":"குவளை"},{"form":"மலர்"},{"form":"புறத்து"},{"form":"ஓட்டிக்"}]},{"lineNumber":75,"text":"காய் வேல் வென்ற கருங் கயல் நெடுங் கண்","words":[{"form":"காய்"},{"form":"வேல்"},{"form":"வென்ற"},{"form":"கருங்"},{"form":"கயல்"},{"form":"நெடுங்"},{"form":"கண்"}]},{"lineNumber":76,"text":"\"அறிவு பிறிதாகியது ஆய் இழை தனக்கு\" என","words":[{"form":"\"அறிவு"},{"form":"பிறிதாகியது"},{"form":"ஆய்"},{"form":"இழை"},{"form":"தனக்கு\""},{"form":"என"}]},{"lineNumber":77,"text":"செவிஅகம் புகூஉச் சென்ற செவ்வியும்","words":[{"form":"செவிஅகம்"},{"form":"புகூஉச்"},{"form":"சென்ற"},{"form":"செவ்வியும்"}]},{"lineNumber":78,"text":"பளிங்கு புறத்து எறிந்த பவளப் பாவை \"என்","words":[{"form":"பளிங்கு"},{"form":"புறத்து"},{"form":"எறிந்த"},{"form":"பவளப்"},{"form":"பாவை"},{"form":"\"என்"}]},{"lineNumber":79,"text":"உளம் கொண்டு ஒளித்தாள் உயிர்க் காப்பிட்டு\" என்று","words":[{"form":"உளம்"},{"form":"கொண்டு"},{"form":"ஒளித்தாள்"},{"form":"உயிர்க்"},{"form":"காப்பிட்டு\""},{"form":"என்று"}]},{"lineNumber":80,"text":"இடை இருள் யாமத்து இருந்தேன் முன்னர்ப்","words":[{"form":"இடை"},{"form":"இருள்"},{"form":"யாமத்து"},{"form":"இருந்தேன்"},{"form":"முன்னர்ப்"}]},{"lineNumber":81,"text":"பொன் திகழ் மேனி ஒருத்தி தோன்றிச்","words":[{"form":"பொன்"},{"form":"திகழ்"},{"form":"மேனி"},{"form":"ஒருத்தி"},{"form":"தோன்றிச்"}]},{"lineNumber":82,"text":"செங்கோல் காட்டிச் \"செய் தவம் புரிந்த","words":[{"form":"செங்கோல்"},{"form":"காட்டிச்"},{"form":"\"செய்"},{"form":"தவம்"},{"form":"புரிந்த"}]},{"lineNumber":83,"text":"அங்கு அவள் தன் திறம் அயர்ப்பாய்\" என்றனள்","words":[{"form":"அங்கு"},{"form":"அவள்"},{"form":"தன்"},{"form":"திறம்"},{"form":"அயர்ப்பாய்\""},{"form":"என்றனள்"}]},{"lineNumber":84,"text":"தெய்வம்கொல்லோ? திப்பியம்கொல்லோ?","words":[{"form":"தெய்வம்கொல்லோ?"},{"form":"திப்பியம்கொல்லோ?"}]},{"lineNumber":85,"text":"எய்யா மையலேன் யான்! என்று அவன் சொலச்","words":[{"form":"எய்யா"},{"form":"மையலேன்"},{"form":"யான்!"},{"form":"என்று"},{"form":"அவன்"},{"form":"சொலச்"}]},{"lineNumber":86,"text":"சித்திராபதி தான் சிறு நகை எய்தி","words":[{"form":"சித்திராபதி"},{"form":"தான்"},{"form":"சிறு"},{"form":"நகை"},{"form":"எய்தி"}]},{"lineNumber":87,"text":"'அத் திறம் விடுவாய் அரசு இளங் குருசில்!","words":[{"form":"'அத்"},{"form":"திறம்"},{"form":"விடுவாய்"},{"form":"அரசு"},{"form":"இளங்"},{"form":"குருசில்!"}]},{"lineNumber":88,"text":"காமக் கள்ளாட்டிடை மயக்குற்றன","words":[{"form":"காமக்"},{"form":"கள்ளாட்டிடை"},{"form":"மயக்குற்றன"}]},{"lineNumber":89,"text":"தேவர்க்கு ஆயினும் சிலவோ செப்பின்?","words":[{"form":"தேவர்க்கு"},{"form":"ஆயினும்"},{"form":"சிலவோ"},{"form":"செப்பின்?"}]},{"lineNumber":90,"text":"மாதவன் மடந்தைக்கு வருந்து துயர் எய்தி","words":[{"form":"மாதவன்"},{"form":"மடந்தைக்கு"},{"form":"வருந்து"},{"form":"துயர்"},{"form":"எய்தி"}]},{"lineNumber":91,"text":"ஆயிரம் செங் கண் அமரர் கோன் பெற்றதும்","words":[{"form":"ஆயிரம்"},{"form":"செங்"},{"form":"கண்"},{"form":"அமரர்"},{"form":"கோன்"},{"form":"பெற்றதும்"}]},{"lineNumber":92,"text":"மேருக் குன்றத்து ஊரும் நீர்ச் சரவணத்து","words":[{"form":"மேருக்"},{"form":"குன்றத்து"},{"form":"ஊரும்"},{"form":"நீர்ச்"},{"form":"சரவணத்து"}]},{"lineNumber":93,"text":"அருந் திறல் முனிவர்க்கு ஆர் அணங்கு ஆகிய","words":[{"form":"அருந்"},{"form":"திறல்"},{"form":"முனிவர்க்கு"},{"form":"ஆர்"},{"form":"அணங்கு"},{"form":"ஆகிய"}]},{"lineNumber":94,"text":"பெரும் பெயர்ப் பெண்டிர்பின்பு உளம் போக்கிய","words":[{"form":"பெரும்"},{"form":"பெயர்ப்"},{"form":"பெண்டிர்பின்பு"},{"form":"உளம்"},{"form":"போக்கிய"}]},{"lineNumber":95,"text":"அங்கி மனையாள் அவரவர் வடிவு ஆய்த்","words":[{"form":"அங்கி"},{"form":"மனையாள்"},{"form":"அவரவர்"},{"form":"வடிவு"},{"form":"ஆய்த்"}]},{"lineNumber":96,"text":"தங்கா வேட்கை தனை அவண் தணித்ததூஉம்","words":[{"form":"தங்கா"},{"form":"வேட்கை"},{"form":"தனை"},{"form":"அவண்"},{"form":"தணித்ததூஉம்"}]},{"lineNumber":97,"text":"கேட்டும் அறிதியோ வாள் திறல் குருசில்?","words":[{"form":"கேட்டும்"},{"form":"அறிதியோ"},{"form":"வாள்"},{"form":"திறல்"},{"form":"குருசில்?"}]},{"lineNumber":98,"text":"கன்னிக் காவலும் கடியின் காவலும்","words":[{"form":"கன்னிக்"},{"form":"காவலும்"},{"form":"கடியின்"},{"form":"காவலும்"}]},{"lineNumber":99,"text":"தன் உறு கணவன் சாவுறின் காவலும்","words":[{"form":"தன்"},{"form":"உறு"},{"form":"கணவன்"},{"form":"சாவுறின்"},{"form":"காவலும்"}]},{"lineNumber":100,"text":"நிறையின் காத்துப் பிறர் பிறர்க் காணாது","words":[{"form":"நிறையின்"},{"form":"காத்துப்"},{"form":"பிறர்"},{"form":"பிறர்க்"},{"form":"காணாது"}]},{"lineNumber":101,"text":"கொண்டோன் அல்லது தெய்வமும் பேணாப்","words":[{"form":"கொண்டோன்"},{"form":"அல்லது"},{"form":"தெய்வமும்"},{"form":"பேணாப்"}]},{"lineNumber":102,"text":"பெண்டிர் தம் குடியில் பிறந்தாள் அல்லள்","words":[{"form":"பெண்டிர்"},{"form":"தம்"},{"form":"குடியில்"},{"form":"பிறந்தாள்"},{"form":"அல்லள்"}]},{"lineNumber":103,"text":"நாடவர் காண நல் அரங்கு ஏறி","words":[{"form":"நாடவர்"},{"form":"காண"},{"form":"நல்"},{"form":"அரங்கு"},{"form":"ஏறி"}]},{"lineNumber":104,"text":"ஆடலும் பாடலும் அழகும் காட்டி","words":[{"form":"ஆடலும்"},{"form":"பாடலும்"},{"form":"அழகும்"},{"form":"காட்டி"}]},{"lineNumber":105,"text":"சுருப்பு நாண் கருப்பு வில் அருப்புக் கணை தூவச்","words":[{"form":"சுருப்பு"},{"form":"நாண்"},{"form":"கருப்பு"},{"form":"வில்"},{"form":"அருப்புக்"},{"form":"கணை"},{"form":"தூவச்"}]},{"lineNumber":106,"text":"செருக் கயல் நெடுங் கண் சுருக்கு வலைப் படுத்துக்","words":[{"form":"செருக்"},{"form":"கயல்"},{"form":"நெடுங்"},{"form":"கண்"},{"form":"சுருக்கு"},{"form":"வலைப்"},{"form":"படுத்துக்"}]},{"lineNumber":107,"text":"கண்டோர் நெஞ்சம் கொண்டு அகம் புக்குப்","words":[{"form":"கண்டோர்"},{"form":"நெஞ்சம்"},{"form":"கொண்டு"},{"form":"அகம்"},{"form":"புக்குப்"}]},{"lineNumber":108,"text":"பண் தேர் மொழியின் பயன் பல வாங்கி","words":[{"form":"பண்"},{"form":"தேர்"},{"form":"மொழியின்"},{"form":"பயன்"},{"form":"பல"},{"form":"வாங்கி"}]},{"lineNumber":109,"text":"வண்டின் துறக்கும் கொண்டி மகளிரைப்","words":[{"form":"வண்டின்"},{"form":"துறக்கும்"},{"form":"கொண்டி"},{"form":"மகளிரைப்"}]},{"lineNumber":110,"text":"பான்மையின் பிணித்துப் படிற்று உரை அடக்குதல்","words":[{"form":"பான்மையின்"},{"form":"பிணித்துப்"},{"form":"படிற்று"},{"form":"உரை"},{"form":"அடக்குதல்"}]},{"lineNumber":111,"text":"கோன்முறை அன்றோ குமரற்கு?' என்றலும்","words":[{"form":"கோன்முறை"},{"form":"அன்றோ"},{"form":"குமரற்கு?'"},{"form":"என்றலும்"}]},{"lineNumber":112,"text":"உதயகுமரன் உள்ளம் பிறழ்ந்து","words":[{"form":"உதயகுமரன்"},{"form":"உள்ளம்"},{"form":"பிறழ்ந்து"}]},{"lineNumber":113,"text":"விரை பரி நெடுந் தேர்மேல் சென்று ஏறி","words":[{"form":"விரை"},{"form":"பரி"},{"form":"நெடுந்"},{"form":"தேர்மேல்"},{"form":"சென்று"},{"form":"ஏறி"}]},{"lineNumber":114,"text":"ஆய் இழை இருந்த அம்பலம் எய்தி","words":[{"form":"ஆய்"},{"form":"இழை"},{"form":"இருந்த"},{"form":"அம்பலம்"},{"form":"எய்தி"}]},{"lineNumber":115,"text":"காடு அமர் செல்வி கடிப் பசி களைய","words":[{"form":"காடு"},{"form":"அமர்"},{"form":"செல்வி"},{"form":"கடிப்"},{"form":"பசி"},{"form":"களைய"}]},{"lineNumber":116,"text":"ஓடு கைக்கொண்டு நின்று ஊட்டுநள் போலத்","words":[{"form":"ஓடு"},{"form":"கைக்கொண்டு"},{"form":"நின்று"},{"form":"ஊட்டுநள்"},{"form":"போலத்"}]},{"lineNumber":117,"text":"தீப் பசி மாக்கட்குச் செழுஞ் சோறு ஈத்துப்","words":[{"form":"தீப்"},{"form":"பசி"},{"form":"மாக்கட்குச்"},{"form":"செழுஞ்"},{"form":"சோறு"},{"form":"ஈத்துப்"}]},{"lineNumber":118,"text":"பாத்திரம் ஏந்திய பாவையைக் கண்டலும்","words":[{"form":"பாத்திரம்"},{"form":"ஏந்திய"},{"form":"பாவையைக்"},{"form":"கண்டலும்"}]},{"lineNumber":119,"text":"இடங்கழி காமமொடு அடங்காண் ஆகி","words":[{"form":"இடங்கழி"},{"form":"காமமொடு"},{"form":"அடங்காண்"},{"form":"ஆகி"}]},{"lineNumber":120,"text":"'உடம்போடு என் தன் உள்ளகம் புகுந்து என்","words":[{"form":"'உடம்போடு"},{"form":"என்"},{"form":"தன்"},{"form":"உள்ளகம்"},{"form":"புகுந்து"},{"form":"என்"}]},{"lineNumber":121,"text":"நெஞ்சம் கவர்ந்த வஞ்சக் கள்வி","words":[{"form":"நெஞ்சம்"},{"form":"கவர்ந்த"},{"form":"வஞ்சக்"},{"form":"கள்வி"}]},{"lineNumber":122,"text":"நோற்றூண் வாழ்க்கையின் நொசி தவம் தாங்கி","words":[{"form":"நோற்றூண்"},{"form":"வாழ்க்கையின்"},{"form":"நொசி"},{"form":"தவம்"},{"form":"தாங்கி"}]},{"lineNumber":123,"text":"ஏற்றூண் விரும்பிய காரணம் என்? என","words":[{"form":"ஏற்றூண்"},{"form":"விரும்பிய"},{"form":"காரணம்"},{"form":"என்?"},{"form":"என"}]},{"lineNumber":124,"text":"தானே தமியள் நின்றோள் முன்னர்","words":[{"form":"தானே"},{"form":"தமியள்"},{"form":"நின்றோள்"},{"form":"முன்னர்"}]},{"lineNumber":125,"text":"யானே கேட்டல் இயல்பு' எனச் சென்று","words":[{"form":"யானே"},{"form":"கேட்டல்"},{"form":"இயல்பு'"},{"form":"எனச்"},{"form":"சென்று"}]},{"lineNumber":126,"text":"'நல்லாய்! என்கொல் நல் தவம் புரிந்தது?","words":[{"form":"'நல்லாய்!"},{"form":"என்கொல்"},{"form":"நல்"},{"form":"தவம்"},{"form":"புரிந்தது?"}]},{"lineNumber":127,"text":"சொல்லாய்' என்று துணிந்துடன் கேட்ப","words":[{"form":"சொல்லாய்'"},{"form":"என்று"},{"form":"துணிந்துடன்"},{"form":"கேட்ப"}]},{"lineNumber":128,"text":"'என் அமர் காதலன் இராகுலன் ஈங்கு இவன்","words":[{"form":"'என்"},{"form":"அமர்"},{"form":"காதலன்"},{"form":"இராகுலன்"},{"form":"ஈங்கு"},{"form":"இவன்"}]},{"lineNumber":129,"text":"தன் அடி தொழுதலும் தகவு!' என வணங்கி","words":[{"form":"தன்"},{"form":"அடி"},{"form":"தொழுதலும்"},{"form":"தகவு!'"},{"form":"என"},{"form":"வணங்கி"}]},{"lineNumber":130,"text":"'அறைபோய் நெஞ்சம் அவன்பால் அணுகினும்","words":[{"form":"'அறைபோய்"},{"form":"நெஞ்சம்"},{"form":"அவன்பால்"},{"form":"அணுகினும்"}]},{"lineNumber":131,"text":"இறை வளை முன்கை ஈங்கு இவன் பற்றினும்","words":[{"form":"இறை"},{"form":"வளை"},{"form":"முன்கை"},{"form":"ஈங்கு"},{"form":"இவன்"},{"form":"பற்றினும்"}]},{"lineNumber":132,"text":"தொன்று காதலன் சொல் எதிர் மறுத்தல்","words":[{"form":"தொன்று"},{"form":"காதலன்"},{"form":"சொல்"},{"form":"எதிர்"},{"form":"மறுத்தல்"}]},{"lineNumber":133,"text":"நன்றி அன்று!' என நடுங்கினள் மயங்கி","words":[{"form":"நன்றி"},{"form":"அன்று!'"},{"form":"என"},{"form":"நடுங்கினள்"},{"form":"மயங்கி"}]},{"lineNumber":134,"text":"'கேட்டது மொழியேன் கேள்வியாளரின்","words":[{"form":"'கேட்டது"},{"form":"மொழியேன்"},{"form":"கேள்வியாளரின்"}]},{"lineNumber":135,"text":"தோட்ட செவியை நீ ஆகுவை ஆம் எனின்","words":[{"form":"தோட்ட"},{"form":"செவியை"},{"form":"நீ"},{"form":"ஆகுவை"},{"form":"ஆம்"},{"form":"எனின்"}]},{"lineNumber":136,"text":"பிறத்தலும் மூத்தலும் பிணிப்பட்டு இரங்கலும்","words":[{"form":"பிறத்தலும்"},{"form":"மூத்தலும்"},{"form":"பிணிப்பட்டு"},{"form":"இரங்கலும்"}]},{"lineNumber":137,"text":"இறத்தலும் உடையது இடும்பைக் கொள்கலம்","words":[{"form":"இறத்தலும்"},{"form":"உடையது"},{"form":"இடும்பைக்"},{"form":"கொள்கலம்"}]},{"lineNumber":138,"text":"மக்கள் யாக்கை இது என உணர்ந்து","words":[{"form":"மக்கள்"},{"form":"யாக்கை"},{"form":"இது"},{"form":"என"},{"form":"உணர்ந்து"}]},{"lineNumber":139,"text":"மிக்க நல் அறம் விரும்புதல் புரிந்தேன்","words":[{"form":"மிக்க"},{"form":"நல்"},{"form":"அறம்"},{"form":"விரும்புதல்"},{"form":"புரிந்தேன்"}]},{"lineNumber":140,"text":"மண்டு அமர் முருக்கும் களிறு அனையார்க்கு","words":[{"form":"மண்டு"},{"form":"அமர்"},{"form":"முருக்கும்"},{"form":"களிறு"},{"form":"அனையார்க்கு"}]},{"lineNumber":141,"text":"பெண்டிர் கூறும் பேர் அறிவு உண்டோ","words":[{"form":"பெண்டிர்"},{"form":"கூறும்"},{"form":"பேர்"},{"form":"அறிவு"},{"form":"உண்டோ"}]},{"lineNumber":142,"text":"கேட்டனை ஆயின் வேட்டது செய்க!' என","words":[{"form":"கேட்டனை"},{"form":"ஆயின்"},{"form":"வேட்டது"},{"form":"செய்க!'"},{"form":"என"}]},{"lineNumber":143,"text":"வாள் திறல் குருசிலை மடக்கொடி நீங்கி","words":[{"form":"வாள்"},{"form":"திறல்"},{"form":"குருசிலை"},{"form":"மடக்கொடி"},{"form":"நீங்கி"}]},{"lineNumber":144,"text":"முத்தை முதல்வி முதியாள் இருந்த","words":[{"form":"முத்தை"},{"form":"முதல்வி"},{"form":"முதியாள்"},{"form":"இருந்த"}]},{"lineNumber":145,"text":"குச்சரக் குடிகை தன் அகம் புக்கு ஆங்கு","words":[{"form":"குச்சரக்"},{"form":"குடிகை"},{"form":"தன்"},{"form":"அகம்"},{"form":"புக்கு"},{"form":"ஆங்கு"}]},{"lineNumber":146,"text":"'ஆடவர் செய்தி அறிகுநர் யார்?' எனத்","words":[{"form":"'ஆடவர்"},{"form":"செய்தி"},{"form":"அறிகுநர்"},{"form":"யார்?'"},{"form":"எனத்"}]},{"lineNumber":147,"text":"தோடு அலர் கோதையைத் தொழுதனன் ஏத்தி","words":[{"form":"தோடு"},{"form":"அலர்"},{"form":"கோதையைத்"},{"form":"தொழுதனன்"},{"form":"ஏத்தி"}]},{"lineNumber":148,"text":"மாய விஞ்சை மந்திரம் ஓதிக்","words":[{"form":"மாய"},{"form":"விஞ்சை"},{"form":"மந்திரம்"},{"form":"ஓதிக்"}]},{"lineNumber":149,"text":"காயசண்டிகை எனும் காரிகை வடிவு ஆய்","words":[{"form":"காயசண்டிகை"},{"form":"எனும்"},{"form":"காரிகை"},{"form":"வடிவு"},{"form":"ஆய்"}]},{"lineNumber":150,"text":"மணிமேகலை தான் வந்து தோன்ற","words":[{"form":"மணிமேகலை"},{"form":"தான்"},{"form":"வந்து"},{"form":"தோன்ற"}]},{"lineNumber":151,"text":"அணி மலர்த் தாரோன் அவள்பால் புக்குக்","words":[{"form":"அணி"},{"form":"மலர்த்"},{"form":"தாரோன்"},{"form":"அவள்பால்"},{"form":"புக்குக்"}]},{"lineNumber":152,"text":"குச்சரக் குடிகைக் குமரியை மரீஇப்","words":[{"form":"குச்சரக்"},{"form":"குடிகைக்"},{"form":"குமரியை"},{"form":"மரீஇப்"}]},{"lineNumber":153,"text":"'பிச்சைப் பாத்திரம் பெரும் பசி உழந்த","words":[{"form":"'பிச்சைப்"},{"form":"பாத்திரம்"},{"form":"பெரும்"},{"form":"பசி"},{"form":"உழந்த"}]},{"lineNumber":154,"text":"காயசண்டிகை தன் கையில் காட்டி","words":[{"form":"காயசண்டிகை"},{"form":"தன்"},{"form":"கையில்"},{"form":"காட்டி"}]},{"lineNumber":155,"text":"மாயையின் ஒளித்த மணிமேகலை தனை","words":[{"form":"மாயையின்"},{"form":"ஒளித்த"},{"form":"மணிமேகலை"},{"form":"தனை"}]},{"lineNumber":156,"text":"ஈங்கு இம் மண்ணீட்டு யார் என உணர்கேன்?","words":[{"form":"ஈங்கு"},{"form":"இம்"},{"form":"மண்ணீட்டு"},{"form":"யார்"},{"form":"என"},{"form":"உணர்கேன்?"}]},{"lineNumber":157,"text":"ஆங்கு அவள் இவள் என்று அருளாய் ஆயிடின்","words":[{"form":"ஆங்கு"},{"form":"அவள்"},{"form":"இவள்"},{"form":"என்று"},{"form":"அருளாய்"},{"form":"ஆயிடின்"}]},{"lineNumber":158,"text":"பல் நாள் ஆயினும் பாடுகிடப்பேன்!","words":[{"form":"பல்"},{"form":"நாள்"},{"form":"ஆயினும்"},{"form":"பாடுகிடப்பேன்!"}]},{"lineNumber":159,"text":"இன்னும் கேளாய் இமையோர் பாவாய்!","words":[{"form":"இன்னும்"},{"form":"கேளாய்"},{"form":"இமையோர்"},{"form":"பாவாய்!"}]},{"lineNumber":160,"text":"பவளச் செவ் வாய்த் தவள வாள் நகையும்","words":[{"form":"பவளச்"},{"form":"செவ்"},{"form":"வாய்த்"},{"form":"தவள"},{"form":"வாள்"},{"form":"நகையும்"}]},{"lineNumber":161,"text":"அஞ்சனம் சேராச் செங் கயல் நெடுங் கணும்","words":[{"form":"அஞ்சனம்"},{"form":"சேராச்"},{"form":"செங்"},{"form":"கயல்"},{"form":"நெடுங்"},{"form":"கணும்"}]},{"lineNumber":162,"text":"முரிந்து கடை நெரிய வரிந்த சிலைப் புருவமும்","words":[{"form":"முரிந்து"},{"form":"கடை"},{"form":"நெரிய"},{"form":"வரிந்த"},{"form":"சிலைப்"},{"form":"புருவமும்"}]},{"lineNumber":163,"text":"குவி முள் கருவியும் கோணமும் கூர் நுனைக்","words":[{"form":"குவி"},{"form":"முள்"},{"form":"கருவியும்"},{"form":"கோணமும்"},{"form":"கூர்"},{"form":"நுனைக்"}]},{"lineNumber":164,"text":"கவை முள் கருவியும் ஆகிக் கடிகொள","words":[{"form":"கவை"},{"form":"முள்"},{"form":"கருவியும்"},{"form":"ஆகிக்"},{"form":"கடிகொள"}]},{"lineNumber":165,"text":"கல்விப் பாகரின் காப்பு வலை ஓட்டி","words":[{"form":"கல்விப்"},{"form":"பாகரின்"},{"form":"காப்பு"},{"form":"வலை"},{"form":"ஓட்டி"}]},{"lineNumber":166,"text":"வல் வாய் யாழின் மெல்லிதின் விளங்க","words":[{"form":"வல்"},{"form":"வாய்"},{"form":"யாழின்"},{"form":"மெல்லிதின்"},{"form":"விளங்க"}]},{"lineNumber":167,"text":"முதுக்குறை முதுமொழி எடுத்துக் காட்டிப்","words":[{"form":"முதுக்குறை"},{"form":"முதுமொழி"},{"form":"எடுத்துக்"},{"form":"காட்டிப்"}]},{"lineNumber":168,"text":"புதுக் கோள் யானை வேட்டம் வாய்ந்தென","words":[{"form":"புதுக்"},{"form":"கோள்"},{"form":"யானை"},{"form":"வேட்டம்"},{"form":"வாய்ந்தென"}]},{"lineNumber":169,"text":"முதியாள்! உன் தன் கோட்டம் புகுந்த","words":[{"form":"முதியாள்!"},{"form":"உன்"},{"form":"தன்"},{"form":"கோட்டம்"},{"form":"புகுந்த"}]},{"lineNumber":170,"text":"மதி வாள் முகத்து மணிமேகலை தனை","words":[{"form":"மதி"},{"form":"வாள்"},{"form":"முகத்து"},{"form":"மணிமேகலை"},{"form":"தனை"}]},{"lineNumber":171,"text":"ஒழியப் போகேன் உன் அடி தொட்டேன்","words":[{"form":"ஒழியப்"},{"form":"போகேன்"},{"form":"உன்"},{"form":"அடி"},{"form":"தொட்டேன்"}]},{"lineNumber":172,"text":"இது குறை' என்றனன் இறைமகன் தான் என்","words":[{"form":"இது"},{"form":"குறை'"},{"form":"என்றனன்"},{"form":"இறைமகன்"},{"form":"தான்"},{"form":"என்"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AE%E0%AE%A3%E0%AE%BF%E0%AE%AE%E0%AF%87%E0%AE%95%E0%AE%B2%E0%AF%88","verified":false,"structure":{"level":"kadai","book":null,"chapter":"உதயகுமரன் அம்பலம் புக்க காதை","chapterNumber":18,"number":18,"verseCount":null},"title":"உதயகுமரன் அம்பலம் புக்க காதை"}
