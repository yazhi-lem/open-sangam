"form":"துளங்கும்"},{"form":"மான்"},{"form":"ஊர்தித்"},{"form":"தூ"},{"form":"மலர்ப்"},{"form":"பள்ளி"}]},{"lineNumber":49,"text":"வெண் திரை விரிந்த வெண் நிறச் சாமரை","words":[{"form":"வெண்"},{"form":"திரை"},{"form":"விரிந்த"},{"form":"வெண்"},{"form":"நிறச்"},{"form":"சாமரை"}]},{"lineNumber":50,"text":"கொண்டு இரு மருங்கும் கோதையர் வீச","words":[{"form":"கொண்டு"},{"form":"இரு"},{"form":"மருங்கும்"},{"form":"கோதையர்"},{"form":"வீச"}]},{"lineNumber":51,"text":"இருந்தோன் திருந்து அடி பொருந்தி நின்று ஏத்தித்","words":[{"form":"இருந்தோன்"},{"form":"திருந்து"},{"form":"அடி"},{"form":"பொருந்தி"},{"form":"நின்று"},{"form":"ஏத்தித்"}]},{"lineNumber":52,"text":"திருந்து எயிறு இலங்கச் செவ்வியின் நக்கு அவன்","words":[{"form":"திருந்து"},{"form":"எயிறு"},{"form":"இலங்கச்"},{"form":"செவ்வியின்"},{"form":"நக்கு"},{"form":"அவன்"}]},{"lineNumber":53,"text":"'மாதவி மணிமேகலையுடன் எய்திய","words":[{"form":"'மாதவி"},{"form":"மணிமேகலையுடன்"},{"form":"எய்திய"}]},{"lineNumber":54,"text":"தாபதக் கோலம் தவறு இன்றோ?' என","words":[{"form":"தாபதக்"},{"form":"கோலம்"},{"form":"தவறு"},{"form":"இன்றோ?'"},{"form":"என"}]},{"lineNumber":55,"text":"'அரிது பெறு சிறப்பின் குருகு கருவுயிர்ப்ப","words":[{"form":"'அரிது"},{"form":"பெறு"},{"form":"சிறப்பின்"},{"form":"குருகு"},{"form":"கருவுயிர்ப்ப"}]},{"lineNumber":56,"text":"ஒரு தனி ஓங்கிய திரு மணிக் காஞ்சி","words":[{"form":"ஒரு"},{"form":"தனி"},{"form":"ஓங்கிய"},{"form":"திரு"},{"form":"மணிக்"},{"form":"காஞ்சி"}]},{"lineNumber":57,"text":"பாடல்சால் சிறப்பின் பரதத்து ஓங்கிய","words":[{"form":"பாடல்சால்"},{"form":"சிறப்பின்"},{"form":"பரதத்து"},{"form":"ஓங்கிய"}]},{"lineNumber":58,"text":"நாடகம் விரும்ப நல் நலம் கவினிக்","words":[{"form":"நாடகம்"},{"form":"விரும்ப"},{"form":"நல்"},{"form":"நலம்"},{"form":"கவினிக்"}]},{"lineNumber":59,"text":"காமர் செவ்விக் கடி மலர் அவிழ்ந்தது","words":[{"form":"காமர்"},{"form":"செவ்விக்"},{"form":"கடி"},{"form":"மலர்"},{"form":"அவிழ்ந்தது"}]},{"lineNumber":60,"text":"உதயகுமரன் எனும் ஒரு வண்டு உணீஇய","words":[{"form":"உதயகுமர