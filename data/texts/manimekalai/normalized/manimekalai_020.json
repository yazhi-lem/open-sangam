்"},{"form":"வயவரும்"},{"form":"மிடைந்த"}]},{"lineNumber":123,"text":"தலைத் தார்ச் சேனையொடு மலைத்துத் தலைவந்தோர்","words":[{"form":"தலைத்"},{"form":"தார்ச்"},{"form":"சேனையொடு"},{"form":"மலைத்துத்"},{"form":"தலைவந்தோர்"}]},{"lineNumber":124,"text":"சிலைக் கயல் நெடுங் கொடி செரு வேல் தடக் கை","words":[{"form":"சிலைக்"},{"form":"கயல்"},{"form":"நெடுங்"},{"form":"கொடி"},{"form":"செரு"},{"form":"வேல்"},{"form":"தடக்"},{"form":"கை"}]},{"lineNumber":125,"text":"ஆர் புனை தெரியல் இளங்கோன் தன்னால்","words":[{"form":"ஆர்"},{"form":"புனை"},{"form":"தெரியல்"},{"form":"இளங்கோன்"},{"form":"தன்னால்"}]},{"lineNumber":126,"text":"காரியாற்றுக் கொண்ட காவல் வெண்குடை","words":[{"form":"காரியாற்றுக்"},{"form":"கொண்ட"},{"form":"காவல்"},{"form":"வெண்குடை"}]},{"lineNumber":127,"text":"வலி கெழு தடக் கை மாவண்கிள்ளி!","words":[{"form":"வலி"},{"form":"கெழு"},{"form":"தடக்"},{"form":"கை"},{"form":"மாவண்கிள்ளி!"}]},{"lineNumber":128,"text":"ஒளியொடு வாழி ஊழிதோறு ஊழி!","words":[{"form":"ஒளியொடு"},{"form":"வாழி"},{"form":"ஊழிதோறு"},{"form":"ஊழி!"}]},{"lineNumber":129,"text":"வாழி எம் கோ மன்னவர் பெருந்தகை!","words":[{"form":"வாழி"},{"form":"எம்"},{"form":"கோ"},{"form":"மன்னவர்"},{"form":"பெருந்தகை!"}]},{"lineNumber":130,"text":"கேள் இது மன்னோ! கெடுக நின் பகைஞர்","words":[{"form":"கேள்"},{"form":"இது"},{"form":"மன்னோ!"},{"form":"கெடுக"},{"form":"நின்"},{"form":"பகைஞர்"}]},{"lineNumber":131,"text":"யானைத்தீ நோய்க்கு அயர்ந்து மெய் வாடி இம்","words":[{"form":"யானைத்தீ"},{"form":"நோய்க்கு"},{"form":"அயர்ந்து"},{"form":"மெய்"},{"form":"வாடி"},{"form":"இம்"}]},{"lineNumber":132,"text":"மா நகர்த் திரியும் ஓர் வம்ப மாதர்","words":[{"form":"மா"},{"form":"நகர்த்"},{"form":"திரியும்"},{"form":"ஓர்"},{"form":"வம்ப"},{"form":"மாதர்"}]},{"lineNumber":133,"text":"அருஞ் சிறைக்கோட்டத்து அகவயின் புகுந்து","words":[{"form":"அருஞ்"},{"form":"சிறைக்கோட்டத்து"},{"form":"அகவயின்"},{"form":"புகுந்து"}]},{"lineNumber":134,"text":"பெரும் பெயர் மன்ன! நின் பெயர் வாழ்த்தி","words":[{"form":"பெரும்"},{"form":"பெயர்"},{"form":"மன்ன!"},{"form":"நின்"},{"form":"பெயர்"},{"form":"வாழ்த்தி"}]},{"lineNumber":135,"text":"ஐயப் பாத்திரம் ஒன்று கொண்டு ஆங்கு","words":[{"form":"ஐயப்"},{"form":"பாத்திரம்"},{"form":"ஒன்று"},{"form":"கொண்டு"},{"form":"ஆங்கு"}]},{"lineNumber":136,"text":"மொய் கொள் மாக்கள் மொசிக்க ஊண் சுரந்தனள்","words":[{"form":"மொய்"},{"form":"கொள்"},{"form":"மாக்கள்"},{"form":"மொசிக்க"},{"form":"ஊண்"},{"form":"சுரந்தனள்"}]},{"lineNumber":137,"text":"ஊழிதோறு ஊழி உலகம் காத்து","words":[{"form":"ஊழிதோறு"},{"form":"ஊழி"},{"form":"உலகம்"},{"form":"காத்து"}]},{"lineNumber":138,"text":"வாழி எம் கோ மன்னவ!' என்றலும்","words":[{"form":"வாழி"},{"form":"எம்"},{"form":"கோ"},{"form":"மன்னவ!'"},{"form":"என்றலும்"}]},{"lineNumber":139,"text":"'வருக வருக மடக்கொடி தான்' என்று","words":[{"form":"'வருக"},{"form":"வருக"},{"form":"மடக்கொடி"},{"form":"தான்'"},{"form":"என்று"}]},{"lineNumber":140,"text":"அருள் புரி நெஞ்சமொடு அரசன் கூறலின்","words":[{"form":"அருள்"},{"form":"புரி"},{"form":"நெஞ்சமொடு"},{"form":"அரசன்"},{"form":"கூறலின்"}]},{"lineNumber":141,"text":"வாயிலாளரின் மடக்கொடி தான் சென்று","words":[{"form":"வாயிலாளரின்"},{"form":"மடக்கொடி"},{"form":"தான்"},{"form":"சென்று"}]},{"lineNumber":142,"text":"'ஆய் கழல் வேந்தன் அருள் வாழிய!' எனத்","words":[{"form":"'ஆய்"},{"form":"கழல்"},{"form":"வேந்தன்"},{"form":"அருள்"},{"form":"வாழிய!'"},{"form":"எனத்"}]},{"lineNumber":143,"text":"'தாங்கு அருந் தன்மைத் தவத்தோய் நீ யார்?","words":[{"form":"'தாங்கு"},{"form":"அருந்"},{"form":"தன்மைத்"},{"form":"தவத்தோய்"},{"form":"நீ"},{"form":"யார்?"}]},{"lineNumber":144,"text":"யாங்கு ஆகியது இவ் ஏந்திய கடிஞை?' என்று","words":[{"form":"யாங்கு"},{"form":"ஆகியது"},{"form":"இவ்"},{"form":"ஏந்திய"},{"form":"கடிஞை?'"},{"form":"என்று"}]},{"lineNumber":145,"text":"அரசன் கூறலும் ஆய் இழை உரைக்கும்","words":[{"form":"அரசன்"},{"form":"கூறலும்"},{"form":"ஆய்"},{"form":"இழை"},{"form":"உரைக்கும்"}]},{"lineNumber":146,"text":"'விரைத் தார் வேந்தே! நீ நீடு வாழி!","words":[{"form":"'விரைத்"},{"form":"தார்"},{"form":"வேந்தே!"},{"form":"நீ"},{"form":"நீடு"},{"form":"வாழி!"}]},{"lineNumber":147,"text":"விஞ்சை மகள் யான் விழவு அணி மூதூர்","words":[{"form":"விஞ்சை"},{"form":"மகள்"},{"form":"யான்"},{"form":"விழவு"},{"form":"அணி"},{"form":"மூதூர்"}]},{"lineNumber":148,"text":"வஞ்சம் திரிந்தேன் வாழிய பெருந்தகை!","words":[{"form":"வஞ்சம்"},{"form":"திரிந்தேன்"},{"form":"வாழிய"},{"form":"பெருந்தகை!"}]},{"lineNumber":149,"text":"வானம் வாய்க்க! மண் வளம் பெருகுக!","words":[{"form":"வானம்"},{"form":"வாய்க்க!"},{"form":"மண்"},{"form":"வளம்"},{"form":"பெருகுக!"}]},{"lineNumber":150,"text":"தீது இன்றாக கோமகற்கு! ஈங்கு ஈது","words":[{"form":"தீது"},{"form":"இன்றாக"},{"form":"கோமகற்கு!"},{"form":"ஈங்கு"},{"form":"ஈது"}]},{"lineNumber":151,"text":"ஐயக் கடிஞை அம்பல மருங்கு ஓர்","words":[{"form":"ஐயக்"},{"form":"கடிஞை"},{"form":"அம்பல"},{"form":"மருங்கு"},{"form":"ஓர்"}]},{"lineNumber":152,"text":"தெய்வம் தந்தது திப்பியம் ஆயது","words":[{"form":"தெய்வம்"},{"form":"தந்தது"},{"form":"திப்பியம்"},{"form":"ஆயது"}]},{"lineNumber":153,"text":"யானைத்தீ நோய் அரும் பசி கெடுத்தது","words":[{"form":"யானைத்தீ"},{"form":"நோய்"},{"form":"அரும்"},{"form":"பசி"},{"form":"கெடுத்தது"}]},{"lineNumber":154,"text":"ஊன் உடை மாக்கட்கு உயிர் மருந்து இது' என","words":[{"form":"ஊன்"},{"form":"உடை"},{"form":"மாக்கட்கு"},{"form":"உயிர்"},{"form":"மருந்து"},{"form":"இது'"},{"form":"என"}]},{"lineNumber":155,"text":"'யான் செயற்பாலது என் இளங்கொடிக்கு?' என்று","words":[{"form":"'யான்"},{"form":"செயற்பாலது"},{"form":"என்"},{"form":"இளங்கொடிக்கு?'"},{"form":"என்று"}]},{"lineNumber":156,"text":"வேந்தன் கூற மெல் இயல் உரைக்கும்","words":[{"form":"வேந்தன்"},{"form":"கூற"},{"form":"மெல்"},{"form":"இயல்"},{"form":"உரைக்கும்"}]},{"lineNumber":157,"text":"'சிறையோர் கோட்டம் சீத்து அருள் நெஞ்சத்து","words":[{"form":"'சிறையோர்"},{"form":"கோட்டம்"},{"form":"சீத்து"},{"form":"அருள்"},{"form":"நெஞ்சத்து"}]},{"lineNumber":158,"text":"அறவோர்க்கு ஆக்குமது வாழியர்!' என","words":[{"form":"அறவோர்க்கு"},{"form":"ஆக்குமது"},{"form":"வாழியர்!'"},{"form":"என"}]},{"lineNumber":159,"text":