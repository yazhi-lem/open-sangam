"},{"form":"என்போர்"}]},{"lineNumber":133,"text":"அல்லல் மாக்கட்கு இல்லது நிரப்புநர்","words":[{"form":"அல்லல்"},{"form":"மாக்கட்கு"},{"form":"இல்லது"},{"form":"நிரப்புநர்"}]},{"lineNumber":134,"text":"திருந்து ஏர் எல் வளை! செல் உலகு அறிந்தோர்","words":[{"form":"திருந்து"},{"form":"ஏர்"},{"form":"எல்"},{"form":"வளை!"},{"form":"செல்"},{"form":"உலகு"},{"form":"அறிந்தோர்"}]},{"lineNumber":135,"text":"வருந்தி வந்தோர் அரும் பசி களைந்தோர்","words":[{"form":"வருந்தி"},{"form":"வந்தோர்"},{"form":"அரும்"},{"form":"பசி"},{"form":"களைந்தோர்"}]},{"lineNumber":136,"text":"துன்பம் அறுக்கும் துணி பொருள் உணர்ந்தோர்","words":[{"form":"துன்பம்"},{"form":"அறுக்கும்"},{"form":"துணி"},{"form":"பொருள்"},{"form":"உணர்ந்தோர்"}]},{"lineNumber":137,"text":"மன்பதைக்கு எல்லாம் அன்பு ஒழியார்' என","words":[{"form":"மன்பதைக்கு"},{"form":"எல்லாம்"},{"form":"அன்பு"},{"form":"ஒழியார்'"},{"form":"என"}]},{"lineNumber":138,"text":"ஞான நல் நீர் நன்கனம் தௌித்து","words":[{"form":"ஞான"},{"form":"நல்"},{"form":"நீர்"},{"form":"நன்கனம்"},{"form":"தௌித்து"}]},{"lineNumber":139,"text":"தேன் ஆர் ஓதி செவிமுதல் வார்த்து","words":[{"form":"தேன்"},{"form":"ஆர்"},{"form":"ஓதி"},{"form":"செவிமுதல்"},{"form":"வார்த்து"}]},{"lineNumber":140,"text":"மகன் துயர் நெருப்பா மனம் விறகு ஆக ----------------------------------------------------------23-140","words":[{"form":"மகன்"},{"form":"துயர்"},{"form":"நெருப்பா"},{"form":"மனம்"},{"form":"விறகு"},{"form":"ஆக"},{"form":"----------------------------------------------------------23-140"}]},{"lineNumber":141,"text":"அகம் சுடு வெந் தீ ஆய் இழை அவிப்ப","words":[{"form":"அகம்"},{"form":"சுடு"},{"form":"வெந்"},{"form":"தீ"},{"form":"ஆய்"},{"form":"இழை"},{"form":"அவிப்ப"}]},{"lineNumber":142,"text":"தேறு படு சில் நீர் போலத் தௌிந்து","words":[{"form":"தேறு"},{"form":"படு"},{"form":"சில்"},{"form":"நீர்"},{"form":"போலத்"},{"form":"தௌிந்து"}]},{"lineNumber":143,"text":"மாறு கொண்டு ஓரா மனத்தினள் ஆகி","words":[{"form":"மாறு"},{"form":"கொண்டு"},{"form":"ஓரா"},{"form":"மனத்தினள்"},{"form":"ஆகி"}]},{"lineNumber":144,"text":"ஆங்கு அவள் தொழுதலும் ஆய் இழை பொறாஅள்","words":[{"form":"ஆங்கு"},{"form":"அவள்"},{"form":"தொழுதலும்"},{"form":"ஆய்"},{"form":"இழை"},{"form":"பொறாஅள்"}]},{"lineNumber":145,"text":"தான் தொழுது ஏத்தி 'தகுதி செய்திலை'","words":[{"form":"தான்"},{"form":"தொழுது"},{"form":"ஏத்தி"},{"form":"'தகுதி"},{"form":"செய்திலை'"}]},{"lineNumber":146,"text":"காதலற் பயந்தோய் அன்றியும் காவலன்","words":[{"form":"காதலற்"},{"form":"பயந்தோய்"},{"form":"அன்றியும்"},{"form":"காவலன்"}]},{"lineNumber":147,"text":"மாபெருந்தேவி' என்று எதிர் வணங்கினள் என் -----------------------------------------------------23-147","words":[{"form":"மாபெருந்தேவி'"},{"form":"என்று"},{"form":"எதிர்"},{"form":"வணங்கினள்"},{"form":"என்"},{"form":"-----------------------------------------------------23-147"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AE%E0%AE%A3%E0%AE%BF%E0%AE%AE%E0%AF%87%E0%AE%95%E0%AE%B2%E0%AF%88","verified":false,"structure":{"level":"kadai","book":null,"chapter":"சிறை விடு காதை","chapterNumber":23,"number":23,"verseCount":null},"title":"சிறை விடு காதை"}
