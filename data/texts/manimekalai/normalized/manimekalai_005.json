form":"கையாறு"},{"form":"அழுங்கல்"}]},{"lineNumber":119,"text":"தவலா உள்ளம் தன்பால் உடையது","words":[{"form":"தவலா"},{"form":"உள்ளம்"},{"form":"தன்பால்"},{"form":"உடையது"}]},{"lineNumber":120,"text":"மக்கள் யாக்கை இது என உணர்ந்து","words":[{"form":"மக்கள்"},{"form":"யாக்கை"},{"form":"இது"},{"form":"என"},{"form":"உணர்ந்து"}]},{"lineNumber":121,"text":"மிக்கோய்! இதனைப் புறமறிப்பாராய்'","words":[{"form":"மிக்கோய்!"},{"form":"இதனைப்"},{"form":"புறமறிப்பாராய்'"}]},{"lineNumber":122,"text":"என்று அவள் உரைத்த இசை படு தீம் சொல்","words":[{"form":"என்று"},{"form":"அவள்"},{"form":"உரைத்த"},{"form":"இசை"},{"form":"படு"},{"form":"தீம்"},{"form":"சொல்"}]},{"lineNumber":123,"text":"சென்று அவன் உள்ளம் சேராமுன்னர்","words":[{"form":"சென்று"},{"form":"அவன்"},{"form":"உள்ளம்"},{"form":"சேராமுன்னர்"}]},{"lineNumber":124,"text":"பளிங்கு புறத்து எறிந்த பவளப் பாவையின்","words":[{"form":"பளிங்கு"},{"form":"புறத்து"},{"form":"எறிந்த"},{"form":"பவளப்"},{"form":"பாவையின்"}]},{"lineNumber":125,"text":"இளங்கொடி தோன்றுமால் இளங்கோ முன் என்","words":[{"form":"இளங்கொடி"},{"form":"தோன்றுமால்"},{"form":"இளங்கோ"},{"form":"முன்"},{"form":"என்"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AE%E0%AE%A3%E0%AE%BF%E0%AE%AE%E0%AF%87%E0%AE%95%E0%AE%B2%E0%AF%88","verified":false,"structure":{"level":"kadai","book":null,"chapter":"பளிக்கறை புக்ககாதை","chapterNumber":4,"number":4,"verseCount":null},"title":"பளிக்கறை புக்ககாதை"}
