rm":"மலை"},{"form":"ஒழிந்து"},{"form":"என்"}]},{"lineNumber":51,"text":"அலவலைச் செய்திக்கு அஞ்சினன் அகன்ற","words":[{"form":"அலவலைச்"},{"form":"செய்திக்கு"},{"form":"அஞ்சினன்"},{"form":"அகன்ற"}]},{"lineNumber":52,"text":"இலகு ஒளி விஞ்சையன் விழுமமோடு எய்தி","words":[{"form":"இலகு"},{"form":"ஒளி"},{"form":"விஞ்சையன்"},{"form":"விழுமமோடு"},{"form":"எய்தி"}]},{"lineNumber":53,"text":"\"ஆர் அணங்கு ஆகிய அருந் தவன் தன்னால்","words":[{"form":"\"ஆர்"},{"form":"அணங்கு"},{"form":"ஆகிய"},{"form":"அருந்"},{"form":"தவன்"},{"form":"தன்னால்"}]},{"lineNumber":54,"text":"காரணம் இன்றியும் கடு நோய் உழந்தனை!","words":[{"form":"காரணம்"},{"form":"இன்றியும்"},{"form":"கடு"},{"form":"நோய்"},{"form":"உழந்தனை!"}]},{"lineNumber":55,"text":"வானூடு எழுக\" என மந்திரம் மறந்தேன்!","words":[{"form":"வானூடு"},{"form":"எழுக\""},{"form":"என"},{"form":"மந்திரம்"},{"form":"மறந்தேன்!"}]},{"lineNumber":56,"text":"ஊன் உயிர் நீங்கும் உருப்பொடு தோன்றி","words":[{"form":"ஊன்"},{"form":"உயிர்"},{"form":"நீங்கும்"},{"form":"உருப்பொடு"},{"form":"தோன்றி"}]},{"lineNumber":57,"text":"வயிறு காய் பெரும் பசி வருத்தும் என்றேற்கு","words":[{"form":"வயிறு"},{"form":"காய்"},{"form":"பெரும்"},{"form":"பசி"},{"form":"வருத்தும்"},{"form":"என்றேற்கு"}]},{"lineNumber":58,"text":"தீம் கனி கிழங்கு செழுங் காய் நல்லன","words":[{"form":"தீம்"},{"form":"கனி"},{"form":"கிழங்கு"},{"form":"செழுங்"},{"form":"காய்"},{"form":"நல்லன"}]},{"lineNumber":59,"text":"ஆங்கு அவன் கொணரவும் ஆற்றேன்ஆக","words":[{"form":"ஆங்கு"},{"form":"அவன்"},{"form":"கொணரவும்"},{"form":"ஆற்றேன்ஆக"}]},{"lineNumber":60,"text":"நீங்கல் ஆற்றான் நெடுந் துயர் எய்தி","words":[{"form":"நீங்கல்"},{"form":"ஆற்றான்"},{"form":"நெடுந்"},{"form":"துயர்"},{"form":"எய்தி"}]},{"lineNumber":61,"text":"ஆங்கு அவன் ஆங்கு எனக்கு அருளொடும் உரைப்போன்","words":[{"form":"ஆங்கு"},{"form":"அவன்"},{"form":"ஆங்கு"},{"form":"எனக்கு"},{"form":"அருளொடும்"},{"form":"உரைப்போன்"}]},{"lineNumber":62,"text":"\"சம்புத் தீவினுள் தமிழக மருங்கில்","words":[{"form":"\"சம்புத்"},{"form":"தீவினுள்"},{"form":"த