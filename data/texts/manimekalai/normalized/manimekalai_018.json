மணிமேகலை!"},{"form":"என்"},{"form":"வான்"},{"form":"பதிப்"},{"form":"படர்கேன்"}]},{"lineNumber":75,"text":"துக்கம் துடைக்கும் துகள் அறு மாதவர்","words":[{"form":"துக்கம்"},{"form":"துடைக்கும்"},{"form":"துகள்"},{"form":"அறு"},{"form":"மாதவர்"}]},{"lineNumber":76,"text":"சக்கரவாளக் கோட்டம் உண்டு ஆங்கு அதில்","words":[{"form":"சக்கரவாளக்"},{"form":"கோட்டம்"},{"form":"உண்டு"},{"form":"ஆங்கு"},{"form":"அதில்"}]},{"lineNumber":77,"text":"பலர் புகத் திறந்த பகு வாய் வாயில்","words":[{"form":"பலர்"},{"form":"புகத்"},{"form":"திறந்த"},{"form":"பகு"},{"form":"வாய்"},{"form":"வாயில்"}]},{"lineNumber":78,"text":"உலக அறவி ஒன்று உண்டு அதனிடை","words":[{"form":"உலக"},{"form":"அறவி"},{"form":"ஒன்று"},{"form":"உண்டு"},{"form":"அதனிடை"}]},{"lineNumber":79,"text":"ஊர்ஊர் ஆங்கண் உறு பசி உழந்தோர்","words":[{"form":"ஊர்ஊர்"},{"form":"ஆங்கண்"},{"form":"உறு"},{"form":"பசி"},{"form":"உழந்தோர்"}]},{"lineNumber":80,"text":"ஆரும் இன்மையின் அரும் பிணி உற்றோர்","words":[{"form":"ஆரும்"},{"form":"இன்மையின்"},{"form":"அரும்"},{"form":"பிணி"},{"form":"உற்றோர்"}]},{"lineNumber":81,"text":"இடுவோர்த் தேர்ந்து ஆங்கு இருப்போர் பலரால்","words":[{"form":"இடுவோர்த்"},{"form":"தேர்ந்து"},{"form":"ஆங்கு"},{"form":"இருப்போர்"},{"form":"பலரால்"}]},{"lineNumber":82,"text":"வடு வாழ் கூந்தல்! அதன்பால் போக' என்று","words":[{"form":"வடு"},{"form":"வாழ்"},{"form":"கூந்தல்!"},{"form":"அதன்பால்"},{"form":"போக'"},{"form":"என்று"}]},{"lineNumber":83,"text":"ஆங்கு அவள் போகிய பின்னர் ஆய் இழை","words":[{"form":"ஆங்கு"},{"form":"அவள்"},{"form":"போகிய"},{"form":"பின்னர்"},{"form":"ஆய்"},{"form":"இழை"}]},{"lineNumber":84,"text":"ஓங்கிய வீதியின் ஒரு புடை ஒதுங்கி","words":[{"form":"ஓங்கிய"},{"form":"வீதியின்"},{"form":"ஒரு"},{"form":"புடை"},{"form":"ஒதுங்கி"}]},{"lineNumber":85,"text":"வல முறை மும் முறை வந்தனை செய்து அவ்","words":[{"form":"வல"},{"form":"முறை"},{"form":"மும்"},{"form":"முறை"},{"form":"வந்தனை"},{"form":"செய்து"},{"form":"அவ்"}]},{"lineNumber":86,"text":"உலக அறவியின் ஒரு தனி ஏறி","words":[{"form":"உலக"},{"form":"அ