]},{"lineNumber":97,"text":"புரி நூல் மார்பீர்! பொய் உரை ஆமோ?","words":[{"form":"புரி"},{"form":"நூல்"},{"form":"மார்பீர்!"},{"form":"பொய்"},{"form":"உரை"},{"form":"ஆமோ?"}]},{"lineNumber":98,"text":"சாலிக்கு உண்டோ தவறு?' என உரைத்து","words":[{"form":"சாலிக்கு"},{"form":"உண்டோ"},{"form":"தவறு?'"},{"form":"என"},{"form":"உரைத்து"}]},{"lineNumber":99,"text":"நான்மறை மாக்களை நகுவனன் நிற்ப","words":[{"form":"நான்மறை"},{"form":"மாக்களை"},{"form":"நகுவனன்"},{"form":"நிற்ப"}]},{"lineNumber":100,"text":"\"ஓதல் அந்தணர்க்கு ஒவ்வான்\" என்றே","words":[{"form":"\"ஓதல்"},{"form":"அந்தணர்க்கு"},{"form":"ஒவ்வான்\""},{"form":"என்றே"}]},{"lineNumber":101,"text":"தாதை பூதியும் தன் மனை கடிதர","words":[{"form":"தாதை"},{"form":"பூதியும்"},{"form":"தன்"},{"form":"மனை"},{"form":"கடிதர"}]},{"lineNumber":102,"text":"\"ஆ கவர் கள்வன்\" என்று அந்தணர் உறைதரும்","words":[{"form":"\"ஆ"},{"form":"கவர்"},{"form":"கள்வன்\""},{"form":"என்று"},{"form":"அந்தணர்"},{"form":"உறைதரும்"}]},{"lineNumber":103,"text":"கிராமம் எங்கணும் கடிஞையில் கல் இட","words":[{"form":"கிராமம்"},{"form":"எங்கணும்"},{"form":"கடிஞையில்"},{"form":"கல்"},{"form":"இட"}]},{"lineNumber":104,"text":"மிக்க செல்வத்து விளங்கியோர் வாழும்","words":[{"form":"மிக்க"},{"form":"செல்வத்து"},{"form":"விளங்கியோர்"},{"form":"வாழும்"}]},{"lineNumber":105,"text":"தக்கண மதுரை தான் சென்று எய்தி","words":[{"form":"தக்கண"},{"form":"மதுரை"},{"form":"தான்"},{"form":"சென்று"},{"form":"எய்தி"}]},{"lineNumber":106,"text":"சிந்தா விளக்கின் செழுங் கலை நியமத்து","words":[{"form":"சிந்தா"},{"form":"விளக்கின்"},{"form":"செழுங்"},{"form":"கலை"},{"form":"நியமத்து"}]},{"lineNumber":107,"text":"அந்தில் முன்றில் அம்பலப் பீடிகைத்","words":[{"form":"அந்தில்"},{"form":"முன்றில்"},{"form":"அம்பலப்"},{"form":"பீடிகைத்"}]},{"lineNumber":108,"text":"தங்கினன் வதிந்து அத் தக்கணப் பேர் ஊர்","words":[{"form":"தங்கினன்"},{"form":"வதிந்து"},{"form":"அத்"},{"form":"தக்கணப்"},{"form":"பேர்"},{"form":"ஊர்"}]},{"lineNumber":109,"text":"ஐயக் கடிஞை கையின் ஏந்தி","words":[{"form":"ஐயக்"},{