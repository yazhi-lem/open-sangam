":"வெற்றிச்"},{"form":"சிலைக்"},{"form":"காமன்"}]},{"lineNumber":38,"text":"மயிலையும் செயலையும் மாவும் குவளையும்","words":[{"form":"மயிலையும்"},{"form":"செயலையும்"},{"form":"மாவும்"},{"form":"குவளையும்"}]},{"lineNumber":39,"text":"பயில் இதழ்க் கமலமும் பருவத்து அலர்ந்த","words":[{"form":"பயில்"},{"form":"இதழ்க்"},{"form":"கமலமும்"},{"form":"பருவத்து"},{"form":"அலர்ந்த"}]},{"lineNumber":40,"text":"மலர் வாய் அம்பின் வாசம் கமழப் ---------------------------------------------------------------24-040","words":[{"form":"மலர்"},{"form":"வாய்"},{"form":"அம்பின்"},{"form":"வாசம்"},{"form":"கமழப்"},{"form":"---------------------------------------------------------------24-040"}]},{"lineNumber":41,"text":"பலர் புறங்கண்டோன் பணிந்து தொழில் கேட்ப","words":[{"form":"பலர்"},{"form":"புறங்கண்டோன்"},{"form":"பணிந்து"},{"form":"தொழில்"},{"form":"கேட்ப"}]},{"lineNumber":42,"text":"ஒரு மதி எல்லை கழிப்பினும் உரையாள்","words":[{"form":"ஒரு"},{"form":"மதி"},{"form":"எல்லை"},{"form":"கழிப்பினும்"},{"form":"உரையாள்"}]},{"lineNumber":43,"text":"பொரு அறு பூங்கொடி போயின அந் நாள்","words":[{"form":"பொரு"},{"form":"அறு"},{"form":"பூங்கொடி"},{"form":"போயின"},{"form":"அந்"},{"form":"நாள்"}]},{"lineNumber":44,"text":"\"யாங்கு ஒளித்தனள் அவ் இளங்கொடி!\" என்றே","words":[{"form":"\"யாங்கு"},{"form":"ஒளித்தனள்"},{"form":"அவ்"},{"form":"இளங்கொடி!\""},{"form":"என்றே"}]},{"lineNumber":45,"text":"வேந்தரை அட்டோன் மெல் இயல் தேர்வுழி","words":[{"form":"வேந்தரை"},{"form":"அட்டோன்"},{"form":"மெல்"},{"form":"இயல்"},{"form":"தேர்வுழி"}]},{"lineNumber":46,"text":"நிலத்தில் குளித்து நெடு விசும்பு ஏறி","words":[{"form":"நிலத்தில்"},{"form":"குளித்து"},{"form":"நெடு"},{"form":"விசும்பு"},{"form":"ஏறி"}]},{"lineNumber":47,"text":"சலத்தில் திரியும் ஓர் சாரணன் தோன்ற","words":[{"form":"சலத்தில்"},{"form":"திரியும்"},{"form":"ஓர்"},{"form":"சாரணன்"},{"form":"தோன்ற"}]},{"lineNumber":48,"text":"மன்னவன் அவனை வணங்கி முன் நின்று","words":[{"form":"மன்னவன்"},{"form":"அவனை"},{"form":"வணங்கி"},{"form":"முன்"},{"form":"நின்று"}]},{"lineNumber":49,"text":"\"என் உயிர் அனையாள் ஈங்கு ஒளித்தாள் உளள்","words":[{"form":"\"என்"},{"form":"உயிர்"},{"form":"அனையாள்"},{"form":"ஈங்கு"},{"form":"ஒளித்தாள்"},{"form":"உளள்"}]},{"lineNumber":50,"text":"அன்னாள் ஒருத்தியைக் கண்டிரோ அடிகள்? --------------------------------------------------------24-050","words":[{"form":"அன்னாள்"},{"form":"ஒருத்தியைக்"},{"form":"கண்டிரோ"},{"form":"அடிகள்?"},{"form":"--------------------------------------------------------24-050"}]},{"lineNumber":51,"text":"சொல்லுமின்\" என்று தொழ அவன் உரைப்பான்","words":[{"form":"சொல்லுமின்\""},{"form":"என்று"},{"form":"தொழ"},{"form":"அவன்"},{"form":"உரைப்பான்"}]},{"lineNumber":52,"text":"\"கண்டிலேன் ஆயினும் காரிகை தன்னைப்","words":[{"form":"\"கண்டிலேன்"},{"form":"ஆயினும்"},{"form":"காரிகை"},{"form":"தன்னைப்"}]},{"lineNumber":53,"text":"பண்டு அறிவுடையேன் பார்த்திப கேளாய்","words":[{"form":"பண்டு"},{"form":"அறிவுடையேன்"},{"form":"பார்த்திப"},{"form":"கேளாய்"}]},{"lineNumber":54,"text":"நாக நாடு நடுக்கு இன்று ஆள்பவன்","words":[{"form":"நாக"},{"form":"நாடு"},{"form":"நடுக்கு"},{"form":"இன்று"},{"form":"ஆள்பவன்"}]},{"lineNumber":55,"text":"வாகை வேலோன் வளைவணன் தேவி","words":[{"form":"வாகை"},{"form":"வேலோன்"},{"form":"வளைவணன்"},{"form":"தேவி"}]},{"lineNumber":56,"text":"வாசமயிலை வயிற்றுள் தோன்றிய","words":[{"form":"வாசமயிலை"},{"form":"வயிற்றுள்"},{"form":"தோன்றிய"}]},{"lineNumber":57,"text":"பீலிவளை என்போள் பிறந்த அந் நாள்","words":[{"form":"பீலிவளை"},{"form":"என்போள்"},{"form":"பிறந்த"},{"form":"அந்"},{"form":"நாள்"}]},{"lineNumber":58,"text":"\"இரவி குலத்து ஒருவன் இணை முலை தோய","words":[{"form":"\"இரவி"},{"form":"குலத்து"},{"form":"ஒருவன்"},{"form":"இணை"},{"form":"முலை"},{"form":"தோய"}]},{"lineNumber":59,"text":"கருவொடு வரும்\" எனக் கணி எடுத்து உரைத்தனன்","words":[{"form":"கருவொடு"},{"form":"வரும்\""},{"form":"எனக்"},{"form":"கணி"},{"form":"எடுத்து"},{"form":"உரைத்தனன்"}]},{"lineNumber":60,"text":"ஆங்கு அப் புதல்வன் வரூஉம் அல்லது ------------------------------------------------------------24-060","words":[{"form":"ஆங்கு"},{"form":"அப்"},{"form":"புதல்வன்"},{"form":"வரூஉம்"},{"form":"அல்லது"},{"form":"------------------------------------------------------------24-060"}]},{"lineNumber":61,"text":"பூங்கொடி வாராள் புலம்பல்! இது கேள்","words":[{"form":"பூங்கொடி"},{"form":"வாராள்"},{"form":"புலம்பல்!"},{"form":"இது"},{"form":"கேள்"}]},{"lineNumber":62,"text":"தீவகச் சாந்தி செய்யா நாள் உன்","words":[{"form":"தீவகச்"},{"form":"சாந்தி"},{"form":"செய்யா"},{"form":"நாள்"},{"form":"உன்"}]},{"lineNumber":63,"text":"காவல் மா நகர் கடல் வயிறு புகூஉம்","words":[{"form":"காவல்"},{"form":"மா"},{"form":"நகர்"},{"form":"கடல்"},{"form":"வயிறு"},{"form":"புகூஉம்"}]},{"lineNumber":64,"text":"மணிமேகலை தன் வாய்மொழியால் அது","words":[{"form":"மணிமேகலை"},{"form":"தன்"},{"form":"வாய்மொழியால்"},{"form":"அது"}]},{"lineNumber":65,"text":"தணியாது இந்திர சாபம் உண்டு ஆகலின்","words":[{"form":"தணியாது"},{"form":"இந்திர"},{"form":"சாபம்"},{"form":"உண்டு"},{"form":"ஆகலின்"}]},{"lineNumber":66,"text":"ஆங்குப் பதி அழிதலும் ஈங்குப் பதி கெடுதலும்","words":[{"form":"ஆங்குப்"},{"form":"பதி"},{"form":"அழிதலும்"},{"form":"ஈங்குப்"},{"form":"பதி"},{"form":"கெடுதலும்"}]},{"lineNumber":67,"text":"வேந்தரை அட்டோய்! மெய் எனக் கொண்டு இக்","words":[{"form":"வேந்தரை"},{"form":"அட்டோய்!"},{"form":"மெய்"},{"form":"எனக்"},{"form":"கொண்டு"},{"form":"இக்"}]},{"lineNumber":68,"text":"காசு இல் மா நகர் கடல் வயிறு புகாமல்","words":[{"form":"காசு"},{"form":"இல்"},{"form":"மா"},{"form":"நகர்"},{"form":"கடல்"},{"form":"வயிறு"},{"form":"புகாமல்"}]},{"lineNumber":69,"text":"வாசவன் விழாக் கோள் மறவேல்\" என்று","words":[{"form":"வாசவன்"},{"form":"விழாக்"},{"form":"கோள்"},{"form":"மறவேல்\""},{"form":"என்று"}]},{"lineNumber":70,"text":"மாதவன் போயின அந் நாள் தொட்டும் இக் ---------------------------------------------------------24-070","words":[{"form":"மாதவன்"},{"form":"போயின"},{"form":"அந்"},{"form":"நாள்"},{"form":"தொட்டும்"},{"form":"இக்"},{"form":"---------------------------------------------------------24-070"}]},{"lineNumber":71,"text":"காவல் மா நகர் கலக்கு ஒழியாதால்","words":[{"form":"காவல்"},{"form":"மா"},{"form":"நகர்"},{"form":"கலக்கு"},{"form":"ஒழியாதால்"}]},{"lineNumber":72,"text":"தன் பெயர் மடந்தை துயருறுமாயின்","words":[{"form":"தன்"},{"form":"பெயர்"},{"form":"மடந்தை"},{"form":"துயருறுமாயின்"}]},{"lineNumber":73,"text":"மன் பெருந் தெய்வம் வருதலும் உண்டு என","words":[{"form":"மன்"},{"form":"பெருந்"},{"form":"தெய்வம்"},{"form":"வருதலும்"},{"form":"உண்டு"},{"form":"என"}]},{"lineNumber":74,"text":"அஞ்சினேன் அரசன் தேவி!' என்று ஏத்தி","words":[{"form":"அஞ்சினேன்"},{"form":"அரசன்"},{"form":"தேவி!'"},{"form":"என்று"},{"form":"ஏத்தி"}]},{"lineNumber":75,"text":"'நல் மனம் பிறந்த நாடகக் கணிகையை","words":[{"form":"'நல்"},{"form":"மனம்"},{"form":"பிறந்த"},{"form":"நாடகக்"},{"form":"கணிகையை"}]},{"lineNumber":76,"text":"என் மனைத் தருக' என இராசமாதேவி","words":[{"form":"என்"},{"form":"மனைத்"},{"form":"தருக'"},{"form":"என"},{"form":"இராசமாதேவி"}]},{"lineNumber":77,"text":"'கள்ளும் பொய்யும் காமமும் கொலையும்","words":[{"form":"'கள்ளும்"},{"form":"பொய்யும்"},{"form":"காமமும்"},{"form":"கொலையும்"}]},{"lineNumber":78,"text":"உள்ளக் களவும் என்று உரவோர் துறந்தவை","words":[{"form":"உள்ளக்"},{"form":"களவும்"},{"form":"என்று"},{"form":"உரவோர்"},{"form":"துறந்தவை"}]},{"lineNumber":79,"text":"தலைமையாக் கொண்ட நின் தலைமை இல் வாழ்க்கை","words":[{"form":"தலைமையாக்"},{"form":"கொண்ட"},{"form":"நின்"},{"form":"தலைமை"},{"form":"இல்"},{"form":"வாழ்க்கை"}]},{"lineNumber":80,"text":"புலைமை என்று அஞ்சிப் போந்த பூங்கொடி ----------------------------------------------------------24-080","words":[{"form":"புலைமை"},{"form":"என்று"},{"form":"அஞ்சிப்"},{"form":"போந்த"},{"form":"பூங்கொடி"},{"form":"----------------------------------------------------------24-080"}]},{"lineNumber":81,"text":"நின்னொடு போந்து நின் மனைப் புகுதாள்","words":[{"form":"நின்னொடு"},{"form":"போந்து"},{"form":"நின்"},{"form":"மனைப்"},{"form":"புகுதாள்"}]},{"lineNumber":82,"text":"என்னொடு இருக்கும்' என்று ஈங்கு இவை சொல்வுழி","words":[{"form":"என்னொடு"},{"form":"இருக்கும்'"},{"form":"என்று"},{"form":"ஈங்கு"},{"form":"இவை"},{"form":"சொல்வுழி"}]},{"lineNumber":83,"text":"மணிமேகலை திறம் மாதவி கேட்டு","words":[{"form":"மணிமேகலை"},{"form":"திறம்"},{"form":"மாதவி"},{"form":"கேட்டு"}]},{"lineNumber":84,"text":"துணி கயம் துகள் படத் துளங்கிய அதுபோல்","words":[{"form":"துணி"},{"form":"கயம்"},{"form":"துகள்"},{"form":"படத்"},{"form":"துளங்கிய"},{"form":"அதுபோல்"}]},{"lineNumber":85,"text":"தௌியாச் சிந்தையள் சுதமதிக்கு உரைத்து","words":[{"form":"தௌியாச்"},{"form":"சிந்தையள்"},{"form":"சுதமதிக்கு"},{"form":"உரைத்து"}]},{"lineNumber":86,"text":"வளி எறி கொம்பின் வருந்தி மெய்ந் நடுங்கி","words":[{"form":"வளி"},{"form":"எறி"},{"form":"கொம்பின்"},{"form":"வருந்தி"},{"form":"மெய்ந்"},{"form":"நடுங்கி"}]},{"lineNumber":87,"text":"அறவணர் அடி வீழ்ந்து ஆங்கு அவர் தம்முடன்","words":[{"form":"அறவணர்"},{"form":"அடி"},{"form":"வீழ்ந்து"},{"form":"ஆங்கு"},{"form":"அவர்"},{"form":"தம்முடன்"}]},{"lineNumber":88,"text":"மற வேல் மன்னவன் தேவி தன்பால் வரத்","words":[{"form":"மற"},{"form":"வேல்"},{"form":"மன்னவன்"},{"form":"தேவி"},{"form":"தன்பால்"},{"form":"வரத்"}]},{"lineNumber":89,"text":"தேவியும் ஆயமும் சித்திராபதியும்","words":[{"form":"தேவியும்"},{"form":"ஆயமும்"},{"form":"சித்திராபதியும்"}]},{"lineNumber":90,"text":"மாதவி மகளும் மாதவர்க் காண்டலும் --------------------------------------------------------------24-090","words":[{"form":"மாதவி"},{"form":"மகளும்"},{"form":"மாதவர்க்"},{"form":"காண்டலும்"},{"form":"--------------------------------------------------------------24-090"}]},{"lineNumber":91,"text":"எழுந்து எதிர்சென்று ஆங்கு இணை வளைக் கையால்","words":[{"form":"எழுந்து"},{"form":"எதிர்சென்று"},{"form":"ஆங்கு"},{"form":"இணை"},{"form":"வளைக்"},{"form":"கையால்"}]},{"lineNumber":92,"text":"தொழும்தகை மாதவன் துணை அடி வணங்க","words":[{"form":"தொழும்தகை"},{"form":"மாதவன்"},{"form":"துணை"},{"form":"அடி"},{"form":"வணங்க"}]},{"lineNumber":93,"text":"'அறிவு உண்டாக' என்று ஆங்கு அவன் கூறலும்","words":[{"form":"'அறிவு"},{"form":"உண்டாக'"},{"form":"என்று"},{"form":"ஆங்கு"},{"form":"அவன்"},{"form":"கூறலும்"}]},{"lineNumber":94,"text":"இணை வளை நல்லாள் இராசமாதேவி","words":[{"form":"இணை"},{"form":"வளை"},{"form":"நல்லாள்"},{"form":"இராசமாதேவி"}]},{"lineNumber":95,"text":"அருந் தவர்க்கு அமைந்த ஆசனம் காட்டி","words":[{"form":"அருந்"},{"form":"தவர்க்கு"},{"form":"அமைந்த"},{"form":"ஆசனம்"},{"form":"காட்டி"}]},{"lineNumber":96,"text":"திருந்து அடி விளக்கிச் சிறப்புச் செய்த பின்","words":[{"form":"திருந்து"},{"form":"அடி"},{"form":"விளக்கிச்"},{"form":"சிறப்புச்"},{"form":"செய்த"},{"form":"பின்"}]},{"lineNumber":97,"text":"\"யாண்டு பல புக்க நும் இணை அடி வருந்த என்","words":[{"form":"\"யாண்டு"},{"form":"பல"},{"form":"புக்க"},{"form":"நும்"},{"form":"இணை"},{"form":"அடி"},{"form":"வருந்த"},{"form":"என்"}]},{"lineNumber":98,"text":"காண்தகு நல்வினை நும்மை ஈங்கு அழைத்தது","words":[{"form":"காண்தகு"},{"form":"நல்வினை"},{"form":"நும்மை"},{"form":"ஈங்கு"},{"form":"அழைத்தது"}]},{"lineNumber":99,"text":"நாத் தொலைவு இல்லைஆயினும் தளர்ந்து","words":[{"form":"நாத்"},{"form":"தொலைவு"},{"form":"இல்லைஆயினும்"},{"form":"தளர்ந்து"}]},{"lineNumber":100,"text":"மூத்த இவ் யாக்கை வாழ்க பல்லாண்டு!' என -------------------------------------------------------24-100","words":[{"form":"மூத்த"},{"form":"இவ்"},{"form":"யாக்கை"},{"form":"வாழ்க"},{"form":"பல்லாண்டு!'"},{"form":"என"},{"form":"-------------------------------------------------------24-100"}]},{"lineNumber":101,"text":"'தேவி கேளாய்! செய் தவ யாக்கையின்","words":[{"form":"'தேவி"},{"form":"கேளாய்!"},{"form":"செய்"},{"form":"தவ"},{"form":"யாக்கையின்"}]},{"lineNumber":102,"text":"மேவினேன் ஆயினும் வீழ் கதிர் போன்றேன்","words":[{"form":"மேவினேன்"},{"form":"ஆயினும்"},{"form":"வீழ்"},{"form":"கதிர்"},{"form":"போன்றேன்"}]},{"lineNumber":103,"text":"பிறந்தார் \"மூத்தார் பிணி நோய் உற்றார்","words":[{"form":"பிறந்தார்"},{"form":"\"மூத்தார்"},{"form":"பிணி"},{"form":"நோய்"},{"form":"உற்றார்"}]},{"lineNumber":104,"text":"இறந்தார்\" என்கை இயல்பே இது கேள்","words":[{"form":"இறந்தார்\""},{"form":"என்கை"},{"form":"இயல்பே"},{