neNumber":89,"text":"ஆங்கு அத் தாயரோடு அறவணர்த் தேர்ந்து","words":[{"form":"ஆங்கு"},{"form":"அத்"},{"form":"தாயரோடு"},{"form":"அறவணர்த்"},{"form":"தேர்ந்து"}]},{"lineNumber":90,"text":"பூங்கொடி கச்சி மா நகர் புக்கதும்.","words":[{"form":"பூங்கொடி"},{"form":"கச்சி"},{"form":"மா"},{"form":"நகர்"},{"form":"புக்கதும்."}]},{"lineNumber":91,"text":"புக்கு அவள் கொண்ட பொய் உருக் களைந்து","words":[{"form":"புக்கு"},{"form":"அவள்"},{"form":"கொண்ட"},{"form":"பொய்"},{"form":"உருக்"},{"form":"களைந்து"}]},{"lineNumber":92,"text":"மற்று அவர் பாதம் வணங்கிய வண்ணமும்","words":[{"form":"மற்று"},{"form":"அவர்"},{"form":"பாதம்"},{"form":"வணங்கிய"},{"form":"வண்ணமும்"}]},{"lineNumber":93,"text":"தவத் திறம் பூண்டு தருமம் கேட்டு","words":[{"form":"தவத்"},{"form":"திறம்"},{"form":"பூண்டு"},{"form":"தருமம்"},{"form":"கேட்டு"}]},{"lineNumber":94,"text":"'பவத் திறம் அறுக' என பாவை நோற்றதும்","words":[{"form":"'பவத்"},{"form":"திறம்"},{"form":"அறுக'"},{"form":"என"},{"form":"பாவை"},{"form":"நோற்றதும்"}]},{"lineNumber":95,"text":"இளங்கோ வேந்தன் அருளிக் கேட்ப","words":[{"form":"இளங்கோ"},{"form":"வேந்தன்"},{"form":"அருளிக்"},{"form":"கேட்ப"}]},{"lineNumber":96,"text":"வளம் கெழு கூல வாணிகன் சாத்தன்","words":[{"form":"வளம்"},{"form":"கெழு"},{"form":"கூல"},{"form":"வாணிகன்"},{"form":"சாத்தன்"}]},{"lineNumber":97,"text":"மா வண் தமிழ்த் திறம் மணிமேகலை துறவு","words":[{"form":"மா"},{"form":"வண்"},{"form":"தமிழ்த்"},{"form":"திறம்"},{"form":"மணிமேகலை"},{"form":"துறவு"}]},{"lineNumber":98,"text":"ஆறு ஐம் பாட்டினுள் அறிய வைத்தனன் என்","words":[{"form":"ஆறு"},{"form":"ஐம்"},{"form":"பாட்டினுள்"},{"form":"அறிய"},{"form":"வைத்தனன்"},{"form":"என்"}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AE%E0%AE%A3%E0%AE%BF%E0%AE%AE%E0%AF%87%E0%AE%95%E0%AE%B2%E0%AF%88","verified":false,"structure":{"level":"kadai","book":null,"chapter":"பதிகம்","chapterNumber":null,"number":null,"verseCount":null},"title":"பதிகம்"}
