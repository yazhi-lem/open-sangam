":"புனை"},{"form":"வேந்தற்குப்"},{"form":"பேர்"},{"form":"அளவு"},{"form":"இயற்றி"}]},{"lineNumber":117,"text":"ஊழி எண்ணி நீடு நின்று ஓங்கிய","words":[{"form":"ஊழி"},{"form":"எண்ணி"},{"form":"நீடு"},{"form":"நின்று"},{"form":"ஓங்கிய"}]},{"lineNumber":118,"text":"ஒரு பெருங் கோயில் திருமுகவாட்டி","words":[{"form":"ஒரு"},{"form":"பெருங்"},{"form":"கோயில்"},{"form":"திருமுகவாட்டி"}]},{"lineNumber":119,"text":"குண திசை மருங்கில் நாள் முதிர் மதியமும்","words":[{"form":"குண"},{"form":"திசை"},{"form":"மருங்கில்"},{"form":"நாள்"},{"form":"முதிர்"},{"form":"மதியமும்"}]},{"lineNumber":120,"text":"குட திசை மருங்கில் சென்று வீழ் கதிரும்","words":[{"form":"குட"},{"form":"திசை"},{"form":"மருங்கில்"},{"form":"சென்று"},{"form":"வீழ்"},{"form":"கதிரும்"}]},{"lineNumber":121,"text":"வெள்ளி வெண் தோட்டொடு பொன் தோடு ஆக","words":[{"form":"வெள்ளி"},{"form":"வெண்"},{"form":"தோட்டொடு"},{"form":"பொன்"},{"form":"தோடு"},{"form":"ஆக"}]},{"lineNumber":122,"text":"எள் அறு திருமுகம் பொலியப் பெய்தலும்","words":[{"form":"எள்"},{"form":"அறு"},{"form":"திருமுகம்"},{"form":"பொலியப்"},{"form":"பெய்தலும்"}]},{"lineNumber":123,"text":"அன்னச் சேவல் அயர்ந்து விளையாடிய","words":[{"form":"அன்னச்"},{"form":"சேவல்"},{"form":"அயர்ந்து"},{"form":"விளையாடிய"}]},{"lineNumber":124,"text":"தன்னுறு பெடையைத் தாமரை அடக்க","words":[{"form":"தன்னுறு"},{"form":"பெடையைத்"},{"form":"தாமரை"},{"form":"அடக்க"}]},{"lineNumber":125,"text":"பூம் பொதி சிதையக் கிழித்துப் பெடை கொண்டு","words":[{"form":"பூம்"},{"form":"பொதி"},{"form":"சிதையக்"},{"form":"கிழித்துப்"},{"form":"பெடை"},{"form":"கொண்டு"}]},{"lineNumber":126,"text":"ஓங்கு இருந் தெங்கின் உயர் மடல் ஏற","words":[{"form":"ஓங்கு"},{"form":"இருந்"},{"form":"தெங்கின்"},{"form":"உயர்"},{"form":"மடல்"},{"form":"ஏற"}]},{"lineNumber":127,"text":"அன்றில் பேடை அரிக் குரல் அழைஇ","words":[{"form":"அன்றில்"},{"form":"பேடை"},{"form":"அரிக்"},{"form":"குரல்"},{"form":"அழைஇ"}]},{"lineNumber":128,"text":"சென்று வீழ் பொழுது சேவற்கு இசைப்ப","words":[{"form":"சென்று"},{"form":"வீழ்"},{"form":"பொழுத