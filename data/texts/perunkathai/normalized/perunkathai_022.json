்மையிற்"}]},{"lineNumber":67,"text":"செய்வது துணியுஞ் சிந்தைச் சூழ்ச்சியன்","words":[{"form":"செய்வது"},{"form":"துணியுஞ்"},{"form":"சிந்தைச்"},{"form":"சூழ்ச்சியன்"}]},{"lineNumber":68,"text":"வெவ்வழி நிலமிசை வில்லேப் பாட்டிடை","words":[{"form":"வெவ்வழி"},{"form":"நிலமிசை"},{"form":"வில்லேப்"},{"form":"பாட்டிடை"}]},{"lineNumber":69,"text":"எவ்வெம் மருங்கினுந் தெரிவோ னவ்வழி","words":[{"form":"எவ்வெம்"},{"form":"மருங்கினுந்"},{"form":"தெரிவோ"},{"form":"னவ்வழி"}]},{"lineNumber":70,"text":"நல்காக் கரவ னடுவன் மேல்வர","words":[{"form":"நல்காக்"},{"form":"கரவ"},{"form":"னடுவன்"},{"form":"மேல்வர"}]},{"lineNumber":71,"text":"ஒல்காத் தவமிலா தொளித்ததுபோலக்","words":[{"form":"ஒல்காத்"},{"form":"தவமிலா"},{"form":"தொளித்ததுபோலக்"}]},{"lineNumber":72,"text":"குண்டுசுனை யடுக்கத்துக் கொழுங்கனி வீழ்ச்சிப்","words":[{"form":"குண்டுசுனை"},{"form":"யடுக்கத்துக்"},{"form":"கொழுங்கனி"},{"form":"வீழ்ச்சிப்"}]},{"lineNumber":73,"text":"பண்ணமை படைச்சுவர்க் கண்ணகன் றமைந்து","words":[{"form":"பண்ணமை"},{"form":"படைச்சுவர்க்"},{"form":"கண்ணகன்"},{"form":"றமைந்து"}]},{"lineNumber":74,"text":"நாற்பெரு வாயி லேற்ப வியற்றிக்","words":[{"form":"நாற்பெரு"},{"form":"வாயி"},{"form":"லேற்ப"},{"form":"வியற்றிக்"}]},{"lineNumber":75,"text":"கற்படை யமைத்துக் கடுமழை மறப்பினும்","words":[{"form":"கற்படை"},{"form":"யமைத்துக்"},{"form":"கடுமழை"},{"form":"மறப்பினும்"}]},{"lineNumber":76,"text":"உட்படு நீரோ டூற்றுடைத் தாகி","words":[{"form":"உட்படு"},{"form":"நீரோ"},{"form":"டூற்றுடைத்"},{"form":"தாகி"}]},{"lineNumber":77,"text":"வாசற வறியா வளப்பருங் குட்டத்துப்","words":[{"form":"வாசற"},{"form":"வறியா"},{"form":"வளப்பருங்"},{"form":"குட்டத்துப்"}]},{"lineNumber":78,"text":"பாசடைத் தாமரை யாம்பலொடு பயின்று","words":[{"form":"பாசடைத்"},{"form":"தாமரை"},{"form":"யாம்பலொடு"},{"form":"பயின்று"}]},{"lineNumber":79,"text":"புட்புகன் றுறையுமோர் பூம்பொக் கரணியை","words":[{"form":"புட்புகன்"},{"form":"றுறையுமோர்"},{"form":"பூம்பொக்"},{"form":"கரணியை"}]},{"lineNumber":80,"text":"முற்படக் கண்டே முகனம ருவகையன்","words":[{"for