,"text":"வாழ்வது வலியாள் சூழ்வன ளிருப்ப","words":[{"form":"வாழ்வது"},{"form":"வலியாள்"},{"form":"சூழ்வன"},{"form":"ளிருப்ப"}]},{"lineNumber":44,"text":"அரும்பொரு ணாவி னமைச்சன் சேதியர்","words":[{"form":"அரும்பொரு"},{"form":"ணாவி"},{"form":"னமைச்சன்"},{"form":"சேதியர்"}]},{"lineNumber":45,"text":"பெரும்பெய ரண்ணலைப் பொருந்துபு வணங்கிக்","words":[{"form":"பெரும்பெய"},{"form":"ரண்ணலைப்"},{"form":"பொருந்துபு"},{"form":"வணங்கிக்"}]},{"lineNumber":46,"text":"காவலன் கருதிய கட்டுரை யுணர்தி","words":[{"form":"காவலன்"},{"form":"கருதிய"},{"form":"கட்டுரை"},{"form":"யுணர்தி"}]},{"lineNumber":47,"text":"பூவலர் தாரோய் புனைகழ னோன்றாள்","words":[{"form":"பூவலர்"},{"form":"தாரோய்"},{"form":"புனைகழ"},{"form":"னோன்றாள்"}]},{"lineNumber":48,"text":"எம்மிறை மாற்ற மிசைப்பேன் யானெனத்","words":[{"form":"எம்மிறை"},{"form":"மாற்ற"},{"form":"மிசைப்பேன்"},{"form":"யானெனத்"}]},{"lineNumber":49,"text":"தன்னமர் தோழரொடு மன்னவன் கேட்பப்","words":[{"form":"தன்னமர்"},{"form":"தோழரொடு"},{"form":"மன்னவன்"},{"form":"கேட்பப்"}]},{"lineNumber":50,"text":"பயங்கெழு வையத் துயர்ந்த தொல்சீர்","words":[{"form":"பயங்கெழு"},{"form":"வையத்"},{"form":"துயர்ந்த"},{"form":"தொல்சீர்"}]},{"lineNumber":51,"text":"விழுத்திணைப் பிறந்துதம் மொழுக்கங் குன்றாப்","words":[{"form":"விழுத்திணைப்"},{"form":"பிறந்துதம்"},{"form":"மொழுக்கங்"},{"form":"குன்றாப்"}]},{"lineNumber":52,"text":"போரடு மன்னர் புலம்பு முந்துறீஇ","words":[{"form":"போரடு"},{"form":"மன்னர்"},{"form":"புலம்பு"},{"form":"முந்துறீஇ"}]},{"lineNumber":53,"text":"ஆரஞ ருழக்க லறிவெனப் படாது","words":[{"form":"ஆரஞ"},{"form":"ருழக்க"},{"form":"லறிவெனப்"},{"form":"படாது"}]},{"lineNumber":54,"text":"நீர்முதன் மண்ணகஞ் சுமந்த நிறைவலி","words":[{"form":"நீர்முதன்"},{"form":"மண்ணகஞ்"},{"form":"சுமந்த"},{"form":"நிறைவலி"}]},{"lineNumber":55,"text":"தான்முழுது கலங்கித் தளரு மாயின்","words":[{"form":"தான்முழுது"},{"form":"கலங்கித்"},{"form":"தளரு"},{"form":"மாயின்"}]},{"lineNumber":56,"text":"மலைமுத லெல்லா நிலைதளர்ந் தொடுங்கும்","words":[{"form":"மலைமுத"},{"form":"லெல்லா"},{"form":"நிலைதளர்ந்"},{"form":"தொடுங்கும்"}]},{"lineNumber":57,"text":"அலகைப் பல்லுயிர்க் கச்ச நீக்குநர்","words":[{"form":"அலகைப்"},{"form":"பல்லுயிர்க்"},{"form":"கச்ச"},{"form":"நீக்குநர்"}]},{"lineNumber":58,"text":"கவலை கொண்டுதங் காவலிற் றளரின்","words":[{"form":"கவலை"},{"form":"கொண்டுதங்"},{"form":"காவலிற்"},{"form":"றளரின்"}]},{"lineNumber":59,"text":"உலக மெல்லா நிலைதளர்ந் தழுயும்","words":[{"form":"உலக"},{"form":"மெல்லா"},{"form":"நிலைதளர்ந்"},{"form":"தழுயும்"}]},{"lineNumber":60,"text":"அற்றே யன்றிக் கொற்றக் கோமான்","words":[{"form":"அற்றே"},{"form":"யன்றிக்"},{"form":"கொற்றக்"},{"form":"கோமான்"}]},{"lineNumber":61,"text":"தானுந் தனிமையொ டென்றலை வந்தனன்","words":[{"form":"தானுந்"},{"form":"தனிமையொ"},{"form":"டென்றலை"},{"form":"வந்தனன்"}]},{"lineNumber":62,"text":"ஆனா வுவகையி னமைந்தபுக ழுடையன்","words":[{"form":"ஆனா"},{"form":"வுவகையி"},{"form":"னமைந்தபுக"},{"form":"ழுடையன்"}]},{"lineNumber":63,"text":"மேனாட் கொண்ட மிகுதுயர் நீக்கி","words":[{"form":"மேனாட்"},{"form":"கொண்ட"},{"form":"மிகுதுயர்"},{"form":"நீக்கி"}]},{"lineNumber":64,"text":"மறுத்தல் செல்லாச் சிறப்பு முந்துறீஇ","words":[{"form":"மறுத்தல்"},{"form":"செல்லாச்"},{"form":"சிறப்பு"},{"form":"முந்துறீஇ"}]},{"lineNumber":65,"text":"அற்றமி னண்பின் யாப்பே யன்றியோர்","words":[{"form":"அற்றமி"},{"form":"னண்பின்"},{"form":"யாப்பே"},{"form":"யன்றியோர்"}]},{"lineNumber":66,"text":"சுற்றப் பந்தமும் வேண்டினே னென்றனன்","words":[{"form":"சுற்றப்"},{"form":"பந்தமும்"},{"form":"வேண்டினே"},{"form":"னென்றனன்"}]},{"lineNumber":67,"text":"கொற்றவன் வலித்த திற்றென வுரைப்பச்","words":[{"form":"கொற்றவன்"},{"form":"வலித்த"},{"form":"திற்றென"},{"form":"வுரைப்பச்"}]},{"lineNumber":68,"text":"செருவடு குருசி லொருபக றானும்","words":[{"form":"செருவடு"},{"form":"குருசி"},{"form":"லொருபக"},{"form":"றானும்"}]},{"lineNumber":69,"text":"மறுமொழி கொடாஅன் மனத்தே நினைஇ","words":[{"form":"மறுமொழி"},{"form":"கொடாஅன்"},{"form":"மனத்தே"},{"form":"நினைஇ"}]},{"lineNumber":70,"text":"நறுமலர்க் கோதையை நாட்பூங் காவினுட்","words":[{"form":"நறுமலர்க்"