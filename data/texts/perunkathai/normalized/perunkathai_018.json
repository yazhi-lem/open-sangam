ineNumber":53,"text":"கணித்து மன்றது மணிப்பூண் மார்ப","words":[{"form":"கணித்து"},{"form":"மன்றது"},{"form":"மணிப்பூண்"},{"form":"மார்ப"}]},{"lineNumber":54,"text":"வலத்திற் கிடந்த வழிவகை தானே","words":[{"form":"வலத்திற்"},{"form":"கிடந்த"},{"form":"வழிவகை"},{"form":"தானே"}]},{"lineNumber":55,"text":"வளைந்த செலவிற் றாகித் தலைத்தலைக்","words":[{"form":"வளைந்த"},{"form":"செலவிற்"},{"form":"றாகித்"},{"form":"தலைத்தலைக்"}]},{"lineNumber":56,"text":"கடுஞ்சின வென்றிக் காவ லாடவர்","words":[{"form":"கடுஞ்சின"},{"form":"வென்றிக்"},{"form":"காவ"},{"form":"லாடவர்"}]},{"lineNumber":57,"text":"கொடுஞ்சிநற் றேருங் குதிரையும் யானையும்","words":[{"form":"கொடுஞ்சிநற்"},{"form":"றேருங்"},{"form":"குதிரையும்"},{"form":"யானையும்"}]},{"lineNumber":58,"text":"காலாட் குழாத்தொடு நால்வகைப் படையும்","words":[{"form":"காலாட்"},{"form":"குழாத்தொடு"},{"form":"நால்வகைப்"},{"form":"படையும்"}]},{"lineNumber":59,"text":"ஓருநிரல் செல்லு முள்ளகல் வுடைத்தாய்த்","words":[{"form":"ஓருநிரல்"},{"form":"செல்லு"},{"form":"முள்ளகல்"},{"form":"வுடைத்தாய்த்"}]},{"lineNumber":60,"text":"திருநிலை பெற்றுத் தீயோ ருன்னார்","words":[{"form":"திருநிலை"},{"form":"பெற்றுத்"},{"form":"தீயோ"},{"form":"ருன்னார்"}]},{"lineNumber":61,"text":"நருமதை காறு நாட்டக ம்பபால்","words":[{"form":"நருமதை"},{"form":"காறு"},{"form":"நாட்டக"},{"form":"ம்பபால்"}]},{"lineNumber":62,"text":"வஞ்சர் வாழு மஞ்சுவரு தீநிலத்","words":[{"form":"வஞ்சர்"},{"form":"வாழு"},{"form":"மஞ்சுவரு"},{"form":"தீநிலத்"}]},{"lineNumber":63,"text":"தகலிடந் தானும் பகலிடத் தியங்குநர்க்","words":[{"form":"தகலிடந்"},{"form":"தானும்"},{"form":"பகலிடத்"},{"form":"தியங்குநர்க்"}]},{"lineNumber":64,"text":"கின்ப மாகிய வேம வெண்குடை","words":[{"form":"கின்ப"},{"form":"மாகிய"},{"form":"வேம"},{"form":"வெண்குடை"}]},{"lineNumber":65,"text":"மன்பெருஞ் சிறப்பின் மண்ணகக் கிழமை","words":[{"form":"மன்பெருஞ்"},{"form":"சிறப்பின்"},{"form":"மண்ணகக்"},{"form":"கிழமை"}]},{"lineNumber":66,"text":"ஒருகோ லோச்சிய திருவார் மார்பநின்","words":[{"form":"ஒருகோ"},{"form":"லோச்சிய"},{"form":"திருவார்"},{"form":"மார்பநின்"}]},{"lineNumber":67,"text":"முன்னோர் காலைப் பன்னூல் பயிற்றிய","words":[{"form":"முன்னோர்"},{"form":"காலைப்"},{"form":"பன்னூல்"},{"form":"பயிற்றிய"}]},{"lineNumber":68,"text":"நல்லிசை நாட்டத் துல்லியன் கண்ட","words":[{"form":"நல்லிசை"},{"form":"நாட்டத்"},{"form":"துல்லியன்"},{"form":"கண்ட"}]},{"lineNumber":69,"text":"குளமும் பொய்கையுங் கூவலும் வாவியும்","words":[{"form":"குளமும்"},{"form":"பொய்கையுங்"},{"form":"கூவலும்"},{"form":"வாவியும்"}]},{"lineNumber":70,"text":"அளவிறந் தினியவை யசைவிடத் துடைத்தாய்ப்","words":[{"form":"அளவிறந்"},{"form":"தினியவை"},{"form":"யசைவிடத்"},{"form":"துடைத்தாய்ப்"}]},{"lineNumber":71,"text":"பயப்பறு பாலை நிலனு மொருபால்","words":[{"form":"பயப்பறு"},{"form":"பாலை"},{"form":"நிலனு"},{"form":"மொருபால்"}]},{"lineNumber":72,"text":"இகக்க லாகா விரண்டினு ளுவப்பதை","words":[{"form":"இகக்க"},{"form":"லாகா"},{"form":"விரண்டினு"},{"form":"ளுவப்பதை"}]},{"lineNumber":73,"text":"ஓட்டுக வல்விரைந் தென்றலி னுதயணன்","words":[{"form":"ஓட்டுக"},{"form":"வல்விரைந்"},{"form":"தென்றலி"},{"form":"னுதயணன்"}]},{"lineNumber":74,"text":"காட்டுப் பெருவழி கடத்தன் மேவான்","words":[{"form":"காட்டுப்"},{"form":"பெருவழி"},{"form":"கடத்தன்"},{"form":"மேவான்"}]},{"lineNumber":75,"text":"நாட்டுப் பெருவழி நணுகக் காட்டிப்","words":[{"form":"நாட்டுப்"},{"form":"பெருவழி"},{"form":"நணுகக்"},{"form":"காட்டிப்"}]},{"lineNumber":76,"text":"பொருள்வயிற் பிரிவோர் வரவெதி ரேற்கும்","words":[{"form":"பொருள்வயிற்"},{"form":"பிரிவோர்"},{"form":"வரவெதி"},{"form":"ரேற்கும்"}]},{"lineNumber":77,"text":"கற்புடை மாதரிற் கதுமென வுரறி","words":[{"form":"கற்புடை"},{"form":"மாதரிற்"},{"form":"கதுமென"},{"form":"வுரறி"}]},{"lineNumber":78,"text":"முற்றுநீர் வையக முழுது முவப்பக்","words":[{"form":"முற்றுநீர்"},{"form":"வையக"},{"form":"முழுது"},{"form":"முவப்பக்"}]},{"lineNumber":79,"text":"கருவி மாமழை பருவமொ டெதிரப்","words":[{"form":"கருவி"},{"form":"மாமழை"},{"form":"பருவமொ"},{"form":"டெதிரப்"}]},{"lineNumber":80,"text":"பரவைப் பௌவம் பருகுபு நிமிர்ந்து","words":[{"form":"பர