orm":"ஒண்ணிறப்"},{"form":"போனக"},{"form":"மண்ணக"},{"form":"மலிர"}]},{"lineNumber":45,"text":"அரிவைய ரடுமடை யமிழ்துகொண் டோச்சி","words":[{"form":"அரிவைய"},{"form":"ரடுமடை"},{"form":"யமிழ்துகொண்"},{"form":"டோச்சி"}]},{"lineNumber":46,"text":"பஞ்ச வாசமொடு பாகுவலத் திரீஇ","words":[{"form":"பஞ்ச"},{"form":"வாசமொடு"},{"form":"பாகுவலத்"},{"form":"திரீஇ"}]},{"lineNumber":47,"text":"அஞ்செஞ் சாந்தமொடு மஞ்ச ணீவி","words":[{"form":"அஞ்செஞ்"},{"form":"சாந்தமொடு"},{"form":"மஞ்ச"},{"form":"ணீவி"}]},{"lineNumber":48,"text":"இருப்பக னிறைந்த நெருப்புநிறை சுழற்றித்","words":[{"form":"இருப்பக"},{"form":"னிறைந்த"},{"form":"நெருப்புநிறை"},{"form":"சுழற்றித்"}]},{"lineNumber":49,"text":"தேவர் தூம மேவர வெடுப்பி","words":[{"form":"தேவர்"},{"form":"தூம"},{"form":"மேவர"},{"form":"வெடுப்பி"}]},{"lineNumber":50,"text":"மலையினீ ராயினு மண்ணினீ ராயினும்","words":[{"form":"மலையினீ"},{"form":"ராயினு"},{"form":"மண்ணினீ"},{"form":"ராயினும்"}]},{"lineNumber":51,"text":"அலைதிரைப் பௌவத் தகத்தினீ ராயினும்","words":[{"form":"அலைதிரைப்"},{"form":"பௌவத்"},{"form":"தகத்தினீ"},{"form":"ராயினும்"}]},{"lineNumber":52,"text":"விசும்பினீ ராயினும் விரும்புபு வந்துநும்","words":[{"form":"விசும்பினீ"},{"form":"ராயினும்"},{"form":"விரும்புபு"},{"form":"வந்துநும்"}]},{"lineNumber":53,"text":"பசும்பொ னுலகம் பற்றுவிட் டொழிந்து","words":[{"form":"பசும்பொ"},{"form":"னுலகம்"},{"form":"பற்றுவிட்"},{"form":"டொழிந்து"}]},{"lineNumber":54,"text":"குடைநிழற் றானைக் கொற்றவன் மடமகள்","words":[{"form":"குடைநிழற்"},{"form":"றானைக்"},{"form":"கொற்றவன்"},{"form":"மடமகள்"}]},{"lineNumber":55,"text":"மடையமைந் துண்டு மங்கலந் தம்மென","words":[{"form":"மடையமைந்"},{"form":"துண்டு"},{"form":"மங்கலந்"},{"form":"தம்மென"}]},{"lineNumber":56,"text":"ஒப்பக் கூறிச் செப்புவன ரளிப்பக்","words":[{"form":"ஒப்பக்"},{"form":"கூறிச்"},{"form":"செப்புவன"},{"form":"ரளிப்பக்"}]},{"lineNumber":57,"text":"கன்னி மகளிர் துன்னுவனர் சூழ","words":[{"form":"கன்னி"},{"form":"மகளிர்"},{"form":"துன்னுவனர்"},{"form":"சூழ"}]},{"lineNumber":58,"text":"நான்முகக் கடவுளொடு த