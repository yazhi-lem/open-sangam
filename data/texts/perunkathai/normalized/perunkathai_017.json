"நறுந்த ணாற்றம் பொதிந்த நன்மலர்த்","words":[{"form":"நறுந்த"},{"form":"ணாற்றம்"},{"form":"பொதிந்த"},{"form":"நன்மலர்த்"}]},{"lineNumber":55,"text":"தடங்கயந் துறந்த தன்மைய வாகிக்","words":[{"form":"தடங்கயந்"},{"form":"துறந்த"},{"form":"தன்மைய"},{"form":"வாகிக்"}]},{"lineNumber":56,"text":"குடம்பை சேர்ந்து குரல்விளி பயிற்றிப்","words":[{"form":"குடம்பை"},{"form":"சேர்ந்து"},{"form":"குரல்விளி"},{"form":"பயிற்றிப்"}]},{"lineNumber":57,"text":"புட்புலம் புறுத்த புன்கண் மாலை","words":[{"form":"புட்புலம்"},{"form":"புறுத்த"},{"form":"புன்கண்"},{"form":"மாலை"}]},{"lineNumber":58,"text":"கட்புல மருங்கிற்கலந்த ஞாயிற்று","words":[{"form":"கட்புல"},{"form":"மருங்கிற்கலந்த"},{"form":"ஞாயிற்று"}]},{"lineNumber":59,"text":"வெப்ப நீக்கித் தட்பந் தான் செயக்","words":[{"form":"வெப்ப"},{"form":"நீக்கித்"},{"form":"தட்பந்"},{"form":"தான்"},{"form":"செயக்"}]},{"lineNumber":60,"text":"கண்ணுறு பிறங்கற் கருவரை நுனித்தலை","words":[{"form":"கண்ணுறு"},{"form":"பிறங்கற்"},{"form":"கருவரை"},{"form":"நுனித்தலை"}]},{"lineNumber":61,"text":"வெண்ணிற வருவி வீழ்ச்சி யேய்ப்ப","words":[{"form":"வெண்ணிற"},{"form":"வருவி"},{"form":"வீழ்ச்சி"},{"form":"யேய்ப்ப"}]},{"lineNumber":62,"text":"மத்தக மருங்கின் மாலையொடு கிடந்த","words":[{"form":"மத்தக"},{"form":"மருங்கின்"},{"form":"மாலையொடு"},{"form":"கிடந்த"}]},{"lineNumber":63,"text":"நித்திலத் தாம நிலையின் வழாமை","words":[{"form":"நித்திலத்"},{"form":"தாம"},{"form":"நிலையின்"},{"form":"வழாமை"}]},{"lineNumber":64,"text":"வைத்த தலையிற் றாக வலிசிறந்து","words":[{"form":"வைத்த"},{"form":"தலையிற்"},{"form":"றாக"},{"form":"வலிசிறந்து"}]},{"lineNumber":65,"text":"வித்தகக் கோலத்து வீழ்ந்த கிழவற்குப்","words":[{"form":"வித்தகக்"},{"form":"கோலத்து"},{"form":"வீழ்ந்த"},{"form":"கிழவற்குப்"}]},{"lineNumber":66,"text":"பத்தினி யாகிய பைந்தொடிப் பணைத்தோட்","words":[{"form":"பத்தினி"},{"form":"யாகிய"},{"form":"பைந்தொடிப்"},{"form":"பணைத்தோட்"}]},{"lineNumber":67,"text":"டத்தரி நெடுங்கட் டத்தை தம்மிறை","words":[{"form":"டத்தரி"},{"form":"நெடுங்கட்"},{"form":"டத்தை"},{"form"