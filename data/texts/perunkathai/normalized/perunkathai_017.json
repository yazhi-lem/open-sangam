"lineNumber":95,"text":"மெல்விரன் மெலிவுகொண் டுள்ளகத் தொடுங்கப்","words":[{"form":"மெல்விரன்"},{"form":"மெலிவுகொண்"},{"form":"டுள்ளகத்"},{"form":"தொடுங்கப்"}]},{"lineNumber":96,"text":"பிடித்துவலம் வந்து வடுத்தீர் நோனபொடு","words":[{"form":"பிடித்துவலம்"},{"form":"வந்து"},{"form":"வடுத்தீர்"},{"form":"நோனபொடு"}]},{"lineNumber":97,"text":"வழுவில் வாலொளி வடமீன் காட்டி","words":[{"form":"வழுவில்"},{"form":"வாலொளி"},{"form":"வடமீன்"},{"form":"காட்டி"}]},{"lineNumber":98,"text":"உழுவ லன்பி னுதயண குமரன்","words":[{"form":"உழுவ"},{"form":"லன்பி"},{"form":"னுதயண"},{"form":"குமரன்"}]},{"lineNumber":99,"text":"அருமறை யாளர்க் கருநிதி யார்த்திப்","words":[{"form":"அருமறை"},{"form":"யாளர்க்"},{"form":"கருநிதி"},{"form":"யார்த்திப்"}]},{"lineNumber":100,"text":"பெருமறை விளங்கப் பெற்றனன் கொள்ளக்","words":[{"form":"பெருமறை"},{"form":"விளங்கப்"},{"form":"பெற்றனன்"},{"form":"கொள்ளக்"}]},{"lineNumber":101,"text":"கொடுத்தில னென்பது கூறி னல்லதை","words":[{"form":"கொடுத்தில"},{"form":"னென்பது"},{"form":"கூறி"},{"form":"னல்லதை"}]},{"lineNumber":102,"text":"அடுத்தனன் கண்டா யணிமுடி யண்ணல்","words":[{"form":"அடுத்தனன்"},{"form":"கண்டா"},{"form":"யணிமுடி"},{"form":"யண்ணல்"}]},{"lineNumber":103,"text":"வையத் தேனோர் வல்ல ரல்லாத்","words":[{"form":"வையத்"},{"form":"தேனோர்"},{"form":"வல்ல"},{"form":"ரல்லாத்"}]},{"lineNumber":104,"text":"தெய்வப் பேரியாழ் கைவயிற் றரீஇ","words":[{"form":"தெய்வப்"},{"form":"பேரியாழ்"},{"form":"கைவயிற்"},{"form":"றரீஇ"}]},{"lineNumber":105,"text":"எழுவியல் கரணம் வழுவிலன் காட்டுநின்","words":[{"form":"எழுவியல்"},{"form":"கரணம்"},{"form":"வழுவிலன்"},{"form":"காட்டுநின்"}]},{"lineNumber":106,"text":"ஆசா னிவனென வருளிய வச்சொற்","words":[{"form":"ஆசா"},{"form":"னிவனென"},{"form":"வருளிய"},{"form":"வச்சொற்"}]},{"lineNumber":107,"text":"றூசார்ந்து துளும்புங் காசுவிரி கலாபத்துப்","words":[{"form":"றூசார்ந்து"},{"form":"துளும்புங்"},{"form":"காசுவிரி"},{"form":"கலாபத்துப்"}]},{"lineNumber":108,"text":"பைவிரி யல்குற் பாவாய் மற்றிது","words":[{"form":"பைவிரி"},{"form":"யல்குற்"},{