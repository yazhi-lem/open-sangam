:"அன்னவன் மதித்துத் தன்மிகத் தருக்கும்","words":[{"form":"அன்னவன்"},{"form":"மதித்துத்"},{"form":"தன்மிகத்"},{"form":"தருக்கும்"}]},{"lineNumber":83,"text":"பெருமீக் கூற்றமும் பேணான் பிறரொடு","words":[{"form":"பெருமீக்"},{"form":"கூற்றமும்"},{"form":"பேணான்"},{"form":"பிறரொடு"}]},{"lineNumber":84,"text":"செருமீக் கூற்றமுஞ் செய்கையும் வேண்டான்","words":[{"form":"செருமீக்"},{"form":"கூற்றமுஞ்"},{"form":"செய்கையும்"},{"form":"வேண்டான்"}]},{"lineNumber":85,"text":"ஒருதலை யாக வாற்றலன் மற்றிவண்","words":[{"form":"ஒருதலை"},{"form":"யாக"},{"form":"வாற்றலன்"},{"form":"மற்றிவண்"}]},{"lineNumber":86,"text":"பழிதலை நம்மேல் வருதலு மின்றி","words":[{"form":"பழிதலை"},{"form":"நம்மேல்"},{"form":"வருதலு"},{"form":"மின்றி"}]},{"lineNumber":87,"text":"நாமு மெண்ணி விட்டன மாகத்","words":[{"form":"நாமு"},{"form":"மெண்ணி"},{"form":"விட்டன"},{"form":"மாகத்"}]},{"lineNumber":88,"text":"தானே சென்று தன்வலி யறியான்","words":[{"form":"தானே"},{"form":"சென்று"},{"form":"தன்வலி"},{"form":"யறியான்"}]},{"lineNumber":89,"text":"அழியினு நமக்குக் கழிவதொன் றில்லை","words":[{"form":"அழியினு"},{"form":"நமக்குக்"},{"form":"கழிவதொன்"},{"form":"றில்லை"}]},{"lineNumber":90,"text":"ஆனிலைப் படாஅ தீனிலைக் கண்ணே","words":[{"form":"ஆனிலைப்"},{"form":"படாஅ"},{"form":"தீனிலைக்"},{"form":"கண்ணே"}]},{"lineNumber":91,"text":"பற்றா மன்னர் படையொடு புணரின்","words":[{"form":"பற்றா"},{"form":"மன்னர்"},{"form":"படையொடு"},{"form":"புணரின்"}]},{"lineNumber":92,"text":"அற்றப் படீஇய ரதனினு முவந்துமென்","words":[{"form":"அற்றப்"},{"form":"படீஇய"},{"form":"ரதனினு"},{"form":"முவந்துமென்"}]},{"lineNumber":93,"text":"றின்னவை யெல்லாந் திண்ணிதி னுரைத்தனன்","words":[{"form":"றின்னவை"},{"form":"யெல்லாந்"},{"form":"திண்ணிதி"},{"form":"னுரைத்தனன்"}]},{"lineNumber":94,"text":"தன்னொடு தொடர்ந்த மன்னரைத் தொகுத்துத்","words":[{"form":"தன்னொடு"},{"form":"தொடர்ந்த"},{"form":"மன்னரைத்"},{"form":"தொகுத்துத்"}]},{"lineNumber":95,"text":"தானிவண் வாரா னாயினும் யானிவட்","words":[{"form":"தானிவண்"},{"form":"வாரா"},{"form":"னாயினும்"},{"form":"யானிவட்"}