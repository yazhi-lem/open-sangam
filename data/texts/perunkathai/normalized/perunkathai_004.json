s":[{"form":"ஒழுகி"},{"form":"நிலம்பெறாஅ"},{"form":"தொசிந்து"},{"form":"கடைபுடைத்"}]},{"lineNumber":179,"text":"தெழுதுநுண் புருவ மேற்றி யியைவித்","words":[{"form":"தெழுதுநுண்"},{"form":"புருவ"},{"form":"மேற்றி"},{"form":"யியைவித்"}]},{"lineNumber":180,"text":"திலமலர்ச் செவ்வா யொப்ப விதழ்விடுத்து","words":[{"form":"திலமலர்ச்"},{"form":"செவ்வா"},{"form":"யொப்ப"},{"form":"விதழ்விடுத்து"}]},{"lineNumber":181,"text":"நரம்பிசை தள்ளி வறிதினிற் சுவைத்து","words":[{"form":"நரம்பிசை"},{"form":"தள்ளி"},{"form":"வறிதினிற்"},{"form":"சுவைத்து"}]},{"lineNumber":182,"text":"மகிழின் மம்ம ரெய்தி முகிழின்","words":[{"form":"மகிழின்"},{"form":"மம்ம"},{"form":"ரெய்தி"},{"form":"முகிழின்"}]},{"lineNumber":183,"text":"கால மன்றியுங் கையி னெரித்த","words":[{"form":"கால"},{"form":"மன்றியுங்"},{"form":"கையி"},{"form":"னெரித்த"}]},{"lineNumber":184,"text":"கழுநீர்க் குவளைப் பெரும்பொதி யவிழ்ந்த","words":[{"form":"கழுநீர்க்"},{"form":"குவளைப்"},{"form":"பெரும்பொதி"},{"form":"யவிழ்ந்த"}]},{"lineNumber":185,"text":"வள்ளிதழ் வகைய வாகி யொள்ளிதழ்","words":[{"form":"வள்ளிதழ்"},{"form":"வகைய"},{"form":"வாகி"},{"form":"யொள்ளிதழ்"}]},{"lineNumber":186,"text":"செஞ்சிவப் புறுத்த சிதரரி மழைக்கண்","words":[{"form":"செஞ்சிவப்"},{"form":"புறுத்த"},{"form":"சிதரரி"},{"form":"மழைக்கண்"}]},{"lineNumber":187,"text":"கொழுங்கடை யிடுக நோக்கி மணிபிறழ","words":[{"form":"கொழுங்கடை"},{"form":"யிடுக"},{"form":"நோக்கி"},{"form":"மணிபிறழ"}]},{"lineNumber":188,"text":"விருப்புள் கூர விம்மி வெய்துயிர்த்","words":[{"form":"விருப்புள்"},{"form":"கூர"},{"form":"விம்மி"},{"form":"வெய்துயிர்த்"}]},{"lineNumber":189,"text":"தெருத்தஞ் சிறிய கோட்டி ய்ம்மினும்","words":[{"form":"தெருத்தஞ்"},{"form":"சிறிய"},{"form":"கோட்டி"},{"form":"ய்ம்மினும்"}]},{"lineNumber":190,"text":"திருத்தஞ் சான்றநுந் துணைவியில் செல்கெனப்","words":[{"form":"திருத்தஞ்"},{"form":"சான்றநுந்"},{"form":"துணைவியில்"},{"form":"செல்கெனப்"}]},{"lineNumber":191,"text":"புலவித் தண்டந் தமர்வயி னேற்றி","words":[{"form":"புலவித்"},{"form":"தண்டந்"},{"form":"தமர்வயி"},{"form":"னேற்றி"}]},{"lineNumber":192,"text":"இல்லை யாயினுஞ் சொல்வகை செருக்கித்","words":[{"form":"இல்லை"},{"form":"யாயினுஞ்"},{"form":"சொல்வகை"},{"form":"செருக்கித்"}]},{"lineNumber":193,"text":"தண்டிக் கொண்டு பெண்டிரைப் பொறாது","words":[{"form":"தண்டிக்"},{"form":"கொண்டு"},{"form":"பெண்டிரைப்"},{"form":"பொறாது"}]},{"lineNumber":194,"text":"செயிர்வுள் ளுறுத்த நோக்கமொடு நறவின்","words":[{"form":"செயிர்வுள்"},{"form":"ளுறுத்த"},{"form":"நோக்கமொடு"},{"form":"நறவின்"}]},{"lineNumber":195,"text":"வாசங் கமழு மோசைய வாகிக்","words":[{"form":"வாசங்"},{"form":"கமழு"},{"form":"மோசைய"},{"form":"வாகிக்"}]},{"lineNumber":196,"text":"கிளிபயி ரன்ன களிப்பயின் மழலை","words":[{"form":"கிளிபயி"},{"form":"ரன்ன"},{"form":"களிப்பயின்"},{"form":"மழலை"}]},{"lineNumber":197,"text":"எய்தா வொழுக்கமொ டைதவட் பயிற்றி","words":[{"form":"எய்தா"},{"form":"வொழுக்கமொ"},{"form":"டைதவட்"},{"form":"பயிற்றி"}]},{"lineNumber":198,"text":"எயிறு வெளிப்படா திறைஞ்சி ஞிமிறினம்","words":[{"form":"எயிறு"},{"form":"வெளிப்படா"},{"form":"திறைஞ்சி"},{"form":"ஞிமிறினம்"}]},{"lineNumber":199,"text":"மூசின கரிய கோதையிற் புடைத்துப்","words":[{"form":"மூசின"},{"form":"கரிய"},{"form":"கோதையிற்"},{"form":"புடைத்துப்"}]},{"lineNumber":200,"text":"பூங்குழை மகளிர் புலவிகொ டிருமுகம்","words":[{"form":"பூங்குழை"},{"form":"மகளிர்"},{"form":"புலவிகொ"},{"form":"டிருமுகம்"}]},{"lineNumber":201,"text":"தேர்ந்துணர் காட்சியிற் றிரிந்துநலங் கரியப்","words":[{"form":"தேர்ந்துணர்"},{"form":"காட்சியிற்"},{"form":"றிரிந்துநலங்"},{"form":"கரியப்"}]},{"lineNumber":202,"text":"பூந்துகிற் றானை பற்றிக் காய்ந்தது","words":[{"form":"பூந்துகிற்"},{"form":"றானை"},{"form":"பற்றிக்"},{"form":"காய்ந்தது"}]},{"lineNumber":203,"text":"காட்டினை சென்மோ மீட்டின தெளிகெனப்","words":[{"form":"காட்டினை"},{"form":"சென்மோ"},{"form":"மீட்டின"},{"form":"தெளிகெனப்"}]},{"lineNumber":204,"text":"படிற்றியல் களைஇப் பணிமொழிக் கிளவி","words":[{"form":"படிற்றியல்"},{"form":"களைஇப்"},{"form":"பணிமொழிக்"},{"form":"கிளவி"}]},{"lineNumber":205,"text":"நடுக்குறு துயரமொடு நயவரப் பயிற்றிக்","words":[{"form":"நடுக்குறு"},{"form":"துயரமொடு"},{"form":"நயவரப்"},{"form":"பயிற்றிக்"}]},{"lineNumber":206,"text":"குவிப்பூங் கையிணை கூப்பித் திருக்குழல்","words":[{"form":"குவிப்பூங்"},{"form":"கையிணை"},{"form":"கூப்பித்"},{"form":"திருக்குழல்"}]},{"lineNumber":207,"text":"நானப் பங்கி கரமிசைத் திவளப்","words":[{"form":"நானப்"},{"form":"பங்கி"},{"form":"கரமிசைத்"},{"form":"திவளப்"}]},{"lineNumber":208,"text":"பரட்டசை கிண்கிணிப் பக்கம் புல்லி","words":[{"form":"பரட்டசை"},{"form":"கிண்கிணிப்"},{"form":"பக்கம்"},{"form":"புல்லி"}]},{"lineNumber":209,"text":"அரத்தகத் தீரத் தைதுகொண் டெழுதிய","words":[{"form":"அரத்தகத்"},{"form":"தீரத்"},{"form":"தைதுகொண்"},{"form":"டெழுதிய"}]},{"lineNumber":210,"text":"சீறடிச் சுவட்டெழுத் தேறிய சென்னியர்","words":[{"form":"சீறடிச்"},{"form":"சுவட்டெழுத்"},{"form":"தேறிய"},{"form":"சென்னியர்"}]},{"lineNumber":211,"text":"நாட்போது நயந்த வேடகைய வாயினும்","words":[{"form":"நாட்போது"},{"form":"நயந்த"},{"form":"வேடகைய"},{"form":"வாயினும்"}]},{"lineNumber":212,"text":"முகைப்பதம் பார்க்கும் வண்டினம் போலத்","words":[{"form":"முகைப்பதம்"},{"form":"பார்க்கும்"},{"form":"வண்டினம்"},{"form":"போலத்"}]},{"lineNumber":213,"text":"தகைப்பருங் காமத்துத் தாம்வீழ் மகளிர்","words":[{"form":"தகைப்பருங்"},{"form":"காமத்துத்"},{"form":"தாம்வீழ்"},{"form":"மகளிர்"}]},{"lineNumber":214,"text":"நகைப்பதம் பார்க்கு நனிநா கரிகத்துச்","words":[{"form":"நகைப்பதம்"},{"form":"பார்க்கு"},{"form":"நனிநா"},{"form":"கரிகத்துச்"}]},{"lineNumber":215,"text":"சொல்லி னுண்பொருள் காட்டி யில்லின்","words":[{"form":"சொல்லி"},{"form":"னுண்பொருள்"},{"form":"காட்டி"},{"form":"யில்லின்"}]},{"lineNumber":216,"text":"படுகாழ்ப் படுத்துத் தேய்வை யுறீஇக்","words":[{"form":"படுகாழ்ப்"},{"form":"படுத்துத்"},{"form":"தேய்வை"},{"form":"யுறீஇக்"}]},{"lineNumber":217,"text":"கலுழி நீக்குங் கம்மியர் போல","words":[{"form":"கலுழி"},{"form":"நீக்குங்"},{"form":"கம்மியர்"},{"form":"போல"}]},{"lineNumber":218,"text":"மகர வீணையின் மனமாசு கழீஇ","words":[{"form":"மகர"},{"form":"வீணையின்"},{"form":"மனமாசு"},{"form":"கழீஇ"}]},{"lineNumber":219,"text":"நகர நம்பியர் திரிதரு மறுகின்","words":[{"form":"நகர"},{"form":"நம்பியர்"},{"form":"திரிதரு"},{"form":"மறுகின்"}]},{"lineNumber":220,"text":"ஆணையிற் கொண்டுதன் னரசியல் செய்தோன்","words":[{"form":"ஆணையிற்"},{"form":"கொண்டுதன்"},{"form":"னரசியல்"},{"form":"செய்தோன்"}]},{"lineNumber":221,"text":"காம விருந்தினன் கலையிற் கிகந்தன்னஃ","words":[{"form":"காம"},{"form":"விருந்தினன்"},{"form":"கலையிற்"},{"form":"கிகந்தன்னஃ"}]},{"lineNumber":222,"text":"பிழைக்கவும் பெறூஉம் பெண்டிர் மாட்டென","words":[{"form":"பிழைக்கவும்"},{"form":"பெறூஉம்"},{"form":"பெண்டிர்"},{"form":"மாட்டென"}]},{"lineNumber":223,"text":"உரைத்தகு கிளவி யோம்பார் பயிற்றி","words":[{"form":"உரைத்தகு"},{"form":"கிளவி"},{"form":"யோம்பார்"},{"form":"பயிற்றி"}]},{"lineNumber":224,"text":"நடநவின் மகளிர் நலத்திடை நம்பி","words":[{"form":"நடநவின்"},{"form":"மகளிர்"},{"form":"நலத்திடை"},{"form":"நம்பி"}]},{"lineNumber":225,"text":"விருந்தினன் போன்மெனப் புரிந்தலர் தூற்றி","words":[{"form":"விருந்தினன்"},{"form":"போன்மெனப்"},{"form":"புரிந்தலர்"},{"form":"தூற்றி"}]},{"lineNumber":226,"text":"விடருந் தூர்த்தரும் விட்டே றுரைப்பத்","words":[{"form":"விடருந்"},{"form":"தூர்த்தரும்"},{"form":"விட்டே"},{"form":"றுரைப்பத்"}]},{"lineNumber":227,"text":"தரும நுவலாது தத்துவ மொரீஇக்","words":[{"form":"தரும"},{"form":"நுவலாது"},{"form":"தத்துவ"},{"form":"மொரீஇக்"}]},{"lineNumber":228,"text":"கரும நுதலிய கள்ளக் காமம்","words":[{"form":"கரும"},{"form":"நுதலிய"},{"form":"கள்ளக்"},{"form":"காமம்"}]},{"lineNumber":229,"text":"எத்துறை மாக்களு மெய்க்மொளப் பரப்பி","words":[{"form":"எத்துறை"},{"form":"மாக்களு"},{"form":"மெய்க்மொளப்"},{"form":"பரப்பி"}]},{"lineNumber":230,"text":"வனப்பு மிளமையும் வரம்பில் கல்வியும்","words":[{"form":"வனப்பு"},{"form":"மிளமையும்"},{"form":"வரம்பில்"},{"form":"கல்வியும்"}]},{"lineNumber":231,"text":"தனக்குநிக ரில்லாத் தன்மைய னாதலிற்","words":[{"form":"தனக்குநிக"},{"form":"ரில்லாத்"},{"form":"தன்மைய"},{"form":"னாதலிற்"}]},{"lineNumber":232,"text":"பொருந்தாப் புற