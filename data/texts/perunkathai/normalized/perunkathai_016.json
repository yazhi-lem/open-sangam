er":173,"text":"வேண்டிடந் தோறுந் தூண்டுதிரிக் மொளீஇக்","words":[{"form":"வேண்டிடந்"},{"form":"தோறுந்"},{"form":"தூண்டுதிரிக்"},{"form":"மொளீஇக்"}]},{"lineNumber":174,"text":"கைவயிற் கொண்ட நெய்யகற் சொரியும்","words":[{"form":"கைவயிற்"},{"form":"கொண்ட"},{"form":"நெய்யகற்"},{"form":"சொரியும்"}]},{"lineNumber":175,"text":"யவனப் பாவை யணிவிளக் கழலத்","words":[{"form":"யவனப்"},{"form":"பாவை"},{"form":"யணிவிளக்"},{"form":"கழலத்"}]},{"lineNumber":176,"text":"திருந்துசா லேகமொடு பொருந்துகத வொற்றிப்","words":[{"form":"திருந்துசா"},{"form":"லேகமொடு"},{"form":"பொருந்துகத"},{"form":"வொற்றிப்"}]},{"lineNumber":177,"text":"பளிக்குமணி யிழிகைப் பவழக் கைவினைப்","words":[{"form":"பளிக்குமணி"},{"form":"யிழிகைப்"},{"form":"பவழக்"},{"form":"கைவினைப்"}]},{"lineNumber":178,"text":"புலிக்கா லமளிப் பொங்குபட் டசைஇ","words":[{"form":"புலிக்கா"},{"form":"லமளிப்"},{"form":"பொங்குபட்"},{"form":"டசைஇ"}]},{"lineNumber":179,"text":"எலிப்பூம் போர்வையொடு மயிர்ப்படம் விரித்துக்","words":[{"form":"எலிப்பூம்"},{"form":"போர்வையொடு"},{"form":"மயிர்ப்படம்"},{"form":"விரித்துக்"}]},{"lineNumber":180,"text":"கலத்தி னல்லது காலின் வாரா","words":[{"form":"கலத்தி"},{"form":"னல்லது"},{"form":"காலின்"},{"form":"வாரா"}]},{"lineNumber":181,"text":"நலத்தகு பல்படை யழற்றற் குரியவை","words":[{"form":"நலத்தகு"},{"form":"பல்படை"},{"form":"யழற்றற்"},{"form":"குரியவை"}]},{"lineNumber":182,"text":"ஆய்வனர் படுத்த வம்பூம் பள்ளியுட்","words":[{"form":"ஆய்வனர்"},{"form":"படுத்த"},{"form":"வம்பூம்"},{"form":"பள்ளியுட்"}]},{"lineNumber":183,"text":"பெருமூ தாட்டியர் பேணுவனர் சூழத்","words":[{"form":"பெருமூ"},{"form":"தாட்டியர்"},{"form":"பேணுவனர்"},{"form":"சூழத்"}]},{"lineNumber":184,"text":"திருமா தேவி யருநக ருற்ற","words":[{"form":"திருமா"},{"form":"தேவி"},{"form":"யருநக"},{"form":"ருற்ற"}]},{"lineNumber":185,"text":"ஆகுலப் பூசலு மழலு மற்றிவை","words":[{"form":"ஆகுலப்"},{"form":"பூசலு"},{"form":"மழலு"},{"form":"மற்றிவை"}]},{"lineNumber":186,"text":"காவல னறிந்த கருத்தின னாகியென்","words":[{"form":"காவல"},{"form":"னறிந்த"},{"form":"க