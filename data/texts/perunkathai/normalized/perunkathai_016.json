ூந் தானை யடிமுதற் றடவர","words":[{"form":"அம்பூந்"},{"form":"தானை"},{"form":"யடிமுதற்"},{"form":"றடவர"}]},{"lineNumber":201,"text":"வெம்போர் வேந்தன் மெல்லென விழிந்து","words":[{"form":"வெம்போர்"},{"form":"வேந்தன்"},{"form":"மெல்லென"},{"form":"விழிந்து"}]},{"lineNumber":202,"text":"நெடுவெண் டிங்க ளகடுறத் தழுவும்","words":[{"form":"நெடுவெண்"},{"form":"டிங்க"},{"form":"ளகடுறத்"},{"form":"தழுவும்"}]},{"lineNumber":203,"text":"கடிவெண் மாடத்துக் கன்னியங் கடிமனை","words":[{"form":"கடிவெண்"},{"form":"மாடத்துக்"},{"form":"கன்னியங்"},{"form":"கடிமனை"}]},{"lineNumber":204,"text":"இல்லாத் தன்மையிற் புல்லெனத் தோன்றும்","words":[{"form":"இல்லாத்"},{"form":"தன்மையிற்"},{"form":"புல்லெனத்"},{"form":"தோன்றும்"}]},{"lineNumber":205,"text":"பையுட் செல்வத்துக் கையற வெய்திப்","words":[{"form":"பையுட்"},{"form":"செல்வத்துக்"},{"form":"கையற"},{"form":"வெய்திப்"}]},{"lineNumber":206,"text":"பொன்னு மணியும் புகரறப் புனைந்த","words":[{"form":"பொன்னு"},{"form":"மணியும்"},{"form":"புகரறப்"},{"form":"புனைந்த"}]},{"lineNumber":207,"text":"தொன்னா டமரத் துணைமுதற் பொறித்த","words":[{"form":"தொன்னா"},{"form":"டமரத்"},{"form":"துணைமுதற்"},{"form":"பொறித்த"}]},{"lineNumber":208,"text":"தோடமை கொளுவத் தூடுற வளைஇத்","words":[{"form":"தோடமை"},{"form":"கொளுவத்"},{"form":"தூடுற"},{"form":"வளைஇத்"}]},{"lineNumber":209,"text":"தாழ்காழ் நகையொடு தாமந் துயல்வரும்","words":[{"form":"தாழ்காழ்"},{"form":"நகையொடு"},{"form":"தாமந்"},{"form":"துயல்வரும்"}]},{"lineNumber":210,"text":"மாசி றிண்ணிலை வாயிற் பேரறைப்","words":[{"form":"மாசி"},{"form":"றிண்ணிலை"},{"form":"வாயிற்"},{"form":"பேரறைப்"}]},{"lineNumber":211,"text":"பள்ளி மண்டபத் தொள்ளொளி கிளரத்","words":[{"form":"பள்ளி"},{"form":"மண்டபத்"},{"form":"தொள்ளொளி"},{"form":"கிளரத்"}]},{"lineNumber":212,"text":"திருவுகொ ளுரோணி யுருவுநலம் விரும்பிய","words":[{"form":"திருவுகொ"},{"form":"ளுரோணி"},{"form":"யுருவுநலம்"},{"form":"விரும்பிய"}]},{"lineNumber":213,"text":"விரிகதிர்ச் செல்வனின் வியப்பத் தோன்றிப்","words":[{"form":"விரிகதிர்ச்"},{"form":"செல்வனின்"},{"form":"வியப்பத்"},{"form":"தோன்றிப்"}]},{"lineNumber":214,"text":"பாயல் கொள்ளான் பட்டத் தேவி","words":[{"form":"பாயல்"},{"form":"கொள்ளான்"},{"form":"பட்டத்"},{"form":"தேவி"}]},{"lineNumber":215,"text":"சாயற் செல்வந் தலையளித் தோம்பி","words":[{"form":"சாயற்"},{"form":"செல்வந்"},{"form":"தலையளித்"},{"form":"தோம்பி"}]},{"lineNumber":216,"text":"அணியிய லமிர்த மாற்றிய பின்னவட்","words":[{"form":"அணியிய"},{"form":"லமிர்த"},{"form":"மாற்றிய"},{"form":"பின்னவட்"}]},{"lineNumber":217,"text":"டெளியக் காட்டுந் தெரிவின னாகிப்","words":[{"form":"டெளியக்"},{"form":"காட்டுந்"},{"form":"தெரிவின"},{"form":"னாகிப்"}]},{"lineNumber":218,"text":"பூங்கொடி புனைந்த வீங்குமுலை யாகத்து","words":[{"form":"பூங்கொடி"},{"form":"புனைந்த"},{"form":"வீங்குமுலை"},{"form":"யாகத்து"}]},{"lineNumber":219,"text":"வாங்கமைப் பணைத்தோள் வாசவ தத்தையை","words":[{"form":"வாங்கமைப்"},{"form":"பணைத்தோள்"},{"form":"வாசவ"},{"form":"தத்தையை"}]},{"lineNumber":220,"text":"நல்லியாழ் நவிற்றிய நளிமணிக் கொடும்பூண்","words":[{"form":"நல்லியாழ்"},{"form":"நவிற்றிய"},{"form":"நளிமணிக்"},{"form":"கொடும்பூண்"}]},{"lineNumber":221,"text":"உறுவரை மார்பி னுதயண குமரன்","words":[{"form":"உறுவரை"},{"form":"மார்பி"},{"form":"னுதயண"},{"form":"குமரன்"}]},{"lineNumber":222,"text":"மறுவி றொன்று மனைவளந் தரூஉம்","words":[{"form":"மறுவி"},{"form":"றொன்று"},{"form":"மனைவளந்"},{"form":"தரூஉம்"}]},{"lineNumber":223,"text":"செல்வி யாகச் சிறப்பொடு சேர்த்தியவன்","words":[{"form":"செல்வி"},{"form":"யாகச்"},{"form":"சிறப்பொடு"},{"form":"சேர்த்தியவன்"}]},{"lineNumber":224,"text":"நாட்டகம் புகுத்தற்கு வேட்ட தென்மனன்","words":[{"form":"நாட்டகம்"},{"form":"புகுத்தற்கு"},{"form":"வேட்ட"},{"form":"தென்மனன்"}]},{"lineNumber":225,"text":"ஒண்குழை மடவோ யுவத்தி நோவென","words":[{"form":"ஒண்குழை"},{"form":"மடவோ"},{"form":"யுவத்தி"},{"form":"நோவென"}]},{"lineNumber":226,"text":"அருமையிற் பெற்றநும் மடித்தி தன்வயிற்","words":[{"form":"அருமையிற்"},{"form":"பெற்றநும்"},{"form":"மடித்தி"},{"form":"தன்வயிற்"}]},{"lineNumber":227,"text":"றிருமணச் சூழ்ச்சி யெழுமைத் தாயினும்","word