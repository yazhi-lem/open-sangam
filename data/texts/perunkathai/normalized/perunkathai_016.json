:"தற்றமும் பிறவு மொற்றுவன னோக்கி","words":[{"form":"தற்றமும்"},{"form":"பிறவு"},{"form":"மொற்றுவன"},{"form":"னோக்கி"}]},{"lineNumber":119,"text":"வள்ளி மருங்கின் வயங்கிழைத் தழீஇ","words":[{"form":"வள்ளி"},{"form":"மருங்கின்"},{"form":"வயங்கிழைத்"},{"form":"தழீஇ"}]},{"lineNumber":120,"text":"எள்ளி யிறந்த வின்னா மன்னனைப்","words":[{"form":"எள்ளி"},{"form":"யிறந்த"},{"form":"வின்னா"},{"form":"மன்னனைப்"}]},{"lineNumber":121,"text":"பற்றுபு தம்மெனப் படையுறப் படுத்து","words":[{"form":"பற்றுபு"},{"form":"தம்மெனப்"},{"form":"படையுறப்"},{"form":"படுத்து"}]},{"lineNumber":122,"text":"ஞாலந் தரும்பொரு ளியற்பட நாடிய","words":[{"form":"ஞாலந்"},{"form":"தரும்பொரு"},{"form":"ளியற்பட"},{"form":"நாடிய"}]},{"lineNumber":123,"text":"சாலங் காயனைத் தலைக்கை யாக்கப்","words":[{"form":"சாலங்"},{"form":"காயனைத்"},{"form":"தலைக்கை"},{"form":"யாக்கப்"}]},{"lineNumber":124,"text":"பல்பொருள் பொதிந்த பயந்தெரி பனுவற்","words":[{"form":"பல்பொருள்"},{"form":"பொதிந்த"},{"form":"பயந்தெரி"},{"form":"பனுவற்"}]},{"lineNumber":125,"text":"பரதகன் றன்னொடு பயந்தீர் நணபின்","words":[{"form":"பரதகன்"},{"form":"றன்னொடு"},{"form":"பயந்தீர்"},{"form":"நணபின்"}]},{"lineNumber":126,"text":"மந்திர மாக்களு மந்த ணாளரும்","words":[{"form":"மந்திர"},{"form":"மாக்களு"},{"form":"மந்த"},{"form":"ணாளரும்"}]},{"lineNumber":127,"text":"அகத்தாற் குழீஇய வ்வைய னாதலின்","words":[{"form":"அகத்தாற்"},{"form":"குழீஇய"},{"form":"வ்வைய"},{"form":"னாதலின்"}]},{"lineNumber":128,"text":"முகைத்தார் வேந்தற்கு முகத்தெழு பெருஞ்சினம்","words":[{"form":"முகைத்தார்"},{"form":"வேந்தற்கு"},{"form":"முகத்தெழு"},{"form":"பெருஞ்சினம்"}]},{"lineNumber":129,"text":"புனற்படு நெருப்பிற் பொம்மென வுரறி","words":[{"form":"புனற்படு"},{"form":"நெருப்பிற்"},{"form":"பொம்மென"},{"form":"வுரறி"}]},{"lineNumber":130,"text":"ஆறிய வண்ண மணிமுக நோக்கித்","words":[{"form":"ஆறிய"},{"form":"வண்ண"},{"form":"மணிமுக"},{"form":"நோக்கித்"}]},{"lineNumber":131,"text":"தெளிதரு கிளவி செவ்விதிற் கேட்ப","words":[{"form":"தெளிதரு"},{"form":"கிளவி"},{"form":"செவ்விதிற்"},{"form":"