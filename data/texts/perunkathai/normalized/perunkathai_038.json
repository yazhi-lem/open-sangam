்","words":[{"form":"அச்ச"},{"form":"வகையினு"},{"form":"மந்தரச்"},{"form":"செலவினும்"}]},{"lineNumber":69,"text":"பொற்றொடி மாதர் பொறைநோய் கூர","words":[{"form":"பொற்றொடி"},{"form":"மாதர்"},{"form":"பொறைநோய்"},{"form":"கூர"}]},{"lineNumber":70,"text":"எல்லாக் கோளு நல்வழி நோக்கத்","words":[{"form":"எல்லாக்"},{"form":"கோளு"},{"form":"நல்வழி"},{"form":"நோக்கத்"}]},{"lineNumber":71,"text":"திருமணி விளக்கத் திசைநின் றழலப்","words":[{"form":"திருமணி"},{"form":"விளக்கத்"},{"form":"திசைநின்"},{"form":"றழலப்"}]},{"lineNumber":72,"text":"பெருமணிப் பாவையிற் பிறந்தனை கிடந்தோய்","words":[{"form":"பெருமணிப்"},{"form":"பாவையிற்"},{"form":"பிறந்தனை"},{"form":"கிடந்தோய்"}]},{"lineNumber":73,"text":"திருமெய் தழீஇ யருமைத் தாக","words":[{"form":"திருமெய்"},{"form":"தழீஇ"},{"form":"யருமைத்"},{"form":"தாக"}]},{"lineNumber":74,"text":"நிகழ்ந்ததை யறியாள் கவன்றன ளிரங்க","words":[{"form":"நிகழ்ந்ததை"},{"form":"யறியாள்"},{"form":"கவன்றன"},{"form":"ளிரங்க"}]},{"lineNumber":75,"text":"ஆத்திரை போந்த வருந்தவன் கண்டுதன்","words":[{"form":"ஆத்திரை"},{"form":"போந்த"},{"form":"வருந்தவன்"},{"form":"கண்டுதன்"}]},{"lineNumber":76,"text":"ஆத்த காதன்மக ளாவ தறிந்துசென்","words":[{"form":"ஆத்த"},{"form":"காதன்மக"},{"form":"ளாவ"},{"form":"தறிந்துசென்"}]},{"lineNumber":77,"text":"றஞ்ச லோம்பென நெஞ்சகம் புகலப்","words":[{"form":"றஞ்ச"},{"form":"லோம்பென"},{"form":"நெஞ்சகம்"},{"form":"புகலப்"}]},{"lineNumber":78,"text":"பள்ளிக் கொண்டுபுக் குள்ளழி வோம்பி","words":[{"form":"பள்ளிக்"},{"form":"கொண்டுபுக்"},{"form":"குள்ளழி"},{"form":"வோம்பி"}]},{"lineNumber":79,"text":"அதிரா ஞாலத் தரசுவீற் றிருந்த","words":[{"form":"அதிரா"},{"form":"ஞாலத்"},{"form":"தரசுவீற்"},{"form":"றிருந்த"}]},{"lineNumber":80,"text":"கதையுரைக் கெல்லாங் காரண னாதலிற்","words":[{"form":"கதையுரைக்"},{"form":"கெல்லாங்"},{"form":"காரண"},{"form":"னாதலிற்"}]},{"lineNumber":81,"text":"புதையிரு ளகற்றும் பொங்கொளி மண்டிலம்","words":[{"form":"புதையிரு"},{"form":"ளகற்றும்"},{"form":"பொங்கொளி"},{"form":"மண்டிலம்"}]},{"lineNumber":82,"text":"உதய மிவர்தர வுதித்த