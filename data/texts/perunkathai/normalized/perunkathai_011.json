் ணாற்ற முடையவை நாடி","words":[{"form":"நறுந்தண்"},{"form":"ணாற்ற"},{"form":"முடையவை"},{"form":"நாடி"}]},{"lineNumber":79,"text":"எறிந்துந் தூவியு மெற்றியுந் தெளித்தும்","words":[{"form":"எறிந்துந்"},{"form":"தூவியு"},{"form":"மெற்றியுந்"},{"form":"தெளித்தும்"}]},{"lineNumber":80,"text":"பல்லோர் பல்சிறப் பயர்வன ரேத்தி","words":[{"form":"பல்லோர்"},{"form":"பல்சிறப்"},{"form":"பயர்வன"},{"form":"ரேத்தி"}]},{"lineNumber":81,"text":"வெல்போர் வேந்தன் மடமகள் விரும்பி","words":[{"form":"வெல்போர்"},{"form":"வேந்தன்"},{"form":"மடமகள்"},{"form":"விரும்பி"}]},{"lineNumber":82,"text":"நில்லாத் தண்புன னெடுங்கோட் டொருசார்த்","words":[{"form":"நில்லாத்"},{"form":"தண்புன"},{"form":"னெடுங்கோட்"},{"form":"டொருசார்த்"}]},{"lineNumber":83,"text":"துறையமைத் தியற்றிய குறைவில் கூடத்","words":[{"form":"துறையமைத்"},{"form":"தியற்றிய"},{"form":"குறைவில்"},{"form":"கூடத்"}]},{"lineNumber":84,"text":"தம்புகை மருங்கிற் செஞ்சுடர் மழுங்கச்","words":[{"form":"தம்புகை"},{"form":"மருங்கிற்"},{"form":"செஞ்சுடர்"},{"form":"மழுங்கச்"}]},{"lineNumber":85,"text":"சீயமு மேறும் பாய்பரிப் புரவியும்","words":[{"form":"சீயமு"},{"form":"மேறும்"},{"form":"பாய்பரிப்"},{"form":"புரவியும்"}]},{"lineNumber":86,"text":"யானையும் புலியு மன்னமு மகன்றிலும்","words":[{"form":"யானையும்"},{"form":"புலியு"},{"form":"மன்னமு"},{"form":"மகன்றிலும்"}]},{"lineNumber":87,"text":"ஏனைய பிறவு மேஎ ருடையன","words":[{"form":"ஏனைய"},{"form":"பிறவு"},{"form":"மேஎ"},{"form":"ருடையன"}]},{"lineNumber":88,"text":"புனைவுகொண் டேற்றி வினைவல ரியற்றிய","words":[{"form":"புனைவுகொண்"},{"form":"டேற்றி"},{"form":"வினைவல"},{"form":"ரியற்றிய"}]},{"lineNumber":89,"text":"கனல்சேர் புகையக லேந்திய கையின்","words":[{"form":"கனல்சேர்"},{"form":"புகையக"},{"form":"லேந்திய"},{"form":"கையின்"}]},{"lineNumber":90,"text":"மூதறி பெண்டிர் காதலொடு பரவி","words":[{"form":"மூதறி"},{"form":"பெண்டிர்"},{"form":"காதலொடு"},{"form":"பரவி"}]},{"lineNumber":91,"text":"நீர்கால் கழீஇய வார்மண லெக்கர்","words":[{"form":"நீர்கால்"},{"form":"கழீஇய"},{"form":"வார்மண"},{"form":"லெக்கர