:106,"text":"இன்ப விருக்கையுள் யாழிடந் தழீஇ","words":[{"form":"இன்ப"},{"form":"விருக்கையுள்"},{"form":"யாழிடந்"},{"form":"தழீஇ"}]},{"lineNumber":107,"text":"மெய்வழி வெந்நோய் நீங்கப் பையெனச்","words":[{"form":"மெய்வழி"},{"form":"வெந்நோய்"},{"form":"நீங்கப்"},{"form":"பையெனச்"}]},{"lineNumber":108,"text":"செவ்வழி யியக்கலிற் சேதியர் பெருமகன்","words":[{"form":"செவ்வழி"},{"form":"யியக்கலிற்"},{"form":"சேதியர்"},{"form":"பெருமகன்"}]},{"lineNumber":109,"text":"வழிப்பெருந் தேவியொடு வான்றோய் கோயிற்","words":[{"form":"வழிப்பெருந்"},{"form":"தேவியொடு"},{"form":"வான்றோய்"},{"form":"கோயிற்"}]},{"lineNumber":110,"text":"பழிப்பில் பள்ளியுட் பயின்றுவிளை யாடி","words":[{"form":"பழிப்பில்"},{"form":"பள்ளியுட்"},{"form":"பயின்றுவிளை"},{"form":"யாடி"}]},{"lineNumber":111,"text":"அரிச்சா லேக மகற்றின னிருந்துழி","words":[{"form":"அரிச்சா"},{"form":"லேக"},{"form":"மகற்றின"},{"form":"னிருந்துழி"}]},{"lineNumber":112,"text":"ஈண்டையெம் பெருமகன் வேண்டா யாகி","words":[{"form":"ஈண்டையெம்"},{"form":"பெருமகன்"},{"form":"வேண்டா"},{"form":"யாகி"}]},{"lineNumber":113,"text":"மறந்தனை யெம்வயின் வலிதுநின் மனனென","words":[{"form":"மறந்தனை"},{"form":"யெம்வயின்"},{"form":"வலிதுநின்"},{"form":"மனனென"}]},{"lineNumber":114,"text":"இறந்தவை கூறி யிரங்குவ தொப்பத்","words":[{"form":"இறந்தவை"},{"form":"கூறி"},{"form":"யிரங்குவ"},{"form":"தொப்பத்"}]},{"lineNumber":115,"text":"தொடைப்பெரும் பண்ணொலி துவைத்துச்செவிக் கிசைப்பக்","words":[{"form":"தொடைப்பெரும்"},{"form":"பண்ணொலி"},{"form":"துவைத்துச்செவிக்"},{"form":"கிசைப்பக்"}]},{"lineNumber":116,"text":"கொடைப்பெரு வேந்தன் குளிர்ந்தன னாகியென்","words":[{"form":"கொடைப்பெரு"},{"form":"வேந்தன்"},{"form":"குளிர்ந்தன"},{"form":"னாகியென்"}]},{"lineNumber":117,"text":"படைப்பருங் பேரியாழ்ப் பண்ணொலி யிதுவென்","words":[{"form":"படைப்பருங்"},{"form":"பேரியாழ்ப்"},{"form":"பண்ணொலி"},{"form":"யிதுவென்"}]},{"lineNumber":118,"text":"ஓர்த்த செவியன் றேர்ச்சியிற் றெளிந்து","words":[{"form":"ஓர்த்த"},{"form":"செவியன்"},{"form":"றேர்ச்சியிற்"},{"form":"றெளிந்து"}]},{"lineNumber":119,"te