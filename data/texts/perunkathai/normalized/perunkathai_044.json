mber":105,"text":"இருங்கட லுடுத்தவிப் பெருங்கண் ஞாலத்துத்","words":[{"form":"இருங்கட"},{"form":"லுடுத்தவிப்"},{"form":"பெருங்கண்"},{"form":"ஞாலத்துத்"}]},{"lineNumber":106,"text":"தன்னி னல்லது தாமீக் கூரிய","words":[{"form":"தன்னி"},{"form":"னல்லது"},{"form":"தாமீக்"},{"form":"கூரிய"}]},{"lineNumber":107,"text":"மன்னரை வணக்கு மறமாச் சேனன்","words":[{"form":"மன்னரை"},{"form":"வணக்கு"},{"form":"மறமாச்"},{"form":"சேனன்"}]},{"lineNumber":108,"text":"காதன் மகளே மாதர் மடவோய்","words":[{"form":"காதன்"},{"form":"மகளே"},{"form":"மாதர்"},{"form":"மடவோய்"}]},{"lineNumber":109,"text":"வத்தவர் பெருமகன் வரைபுரை யகலத்து","words":[{"form":"வத்தவர்"},{"form":"பெருமகன்"},{"form":"வரைபுரை"},{"form":"யகலத்து"}]},{"lineNumber":110,"text":"வித்தக நறுந்தார் விருப்பொடு பொருந்தி","words":[{"form":"வித்தக"},{"form":"நறுந்தார்"},{"form":"விருப்பொடு"},{"form":"பொருந்தி"}]},{"lineNumber":111,"text":"நுகர்தற் கமைந்த புகர்தீர் பொம்மற்","words":[{"form":"நுகர்தற்"},{"form":"கமைந்த"},{"form":"புகர்தீர்"},{"form":"பொம்மற்"}]},{"lineNumber":112,"text":"கோல வனமுலைக் கொடிபுரை மருங்குல்","words":[{"form":"கோல"},{"form":"வனமுலைக்"},{"form":"கொடிபுரை"},{"form":"மருங்குல்"}]},{"lineNumber":113,"text":"வால்வளைப் பணைத்தோள் வாசவ தத்தாய்","words":[{"form":"வால்வளைப்"},{"form":"பணைத்தோள்"},{"form":"வாசவ"},{"form":"தத்தாய்"}]},{"lineNumber":114,"text":"உருளிக் கேண்மோ வரசியல் வழாஅ","words":[{"form":"உருளிக்"},{"form":"கேண்மோ"},{"form":"வரசியல்"},{"form":"வழாஅ"}]},{"lineNumber":115,"text":"இருளறு செங்கோ லேய ரிறைவன்","words":[{"form":"இருளறு"},{"form":"செங்கோ"},{"form":"லேய"},{"form":"ரிறைவன்"}]},{"lineNumber":116,"text":"சேனை நாப்பணும் பெருமான் செய்த","words":[{"form":"சேனை"},{"form":"நாப்பணும்"},{"form":"பெருமான்"},{"form":"செய்த"}]},{"lineNumber":117,"text":"யானை மாயத் தருந்தளைப் படுதலிற்","words":[{"form":"யானை"},{"form":"மாயத்"},{"form":"தருந்தளைப்"},{"form":"படுதலிற்"}]},{"lineNumber":118,"text":"கொங்கலர் நறுந்தார்க் கோல மார்பிற்","words":[{"form":"கொங்கலர்"},{"form":"நறுந்தார்க்"},{"form":"கோல"},{"form":"மார்பிற்"}]},{"lineNumber":119,"text":"பிங்கல கடகர் பெற்றியிற் பிழைப்பப்","words":[{"form":"பிங்கல"},{"form":"கடகர்"},{"form":"பெற்றியிற்"},{"form":"பிழைப்பப்"}]},{"lineNumber":120,"text":"பாஞ்சால ராயன் பரந்த படையொடு","words":[{"form":"பாஞ்சால"},{"form":"ராயன்"},{"form":"பரந்த"},{"form":"படையொடு"}]},{"lineNumber":121,"text":"மாண்கோ சம்பி வௌவியது மறியான்","words":[{"form":"மாண்கோ"},{"form":"சம்பி"},{"form":"வௌவியது"},{"form":"மறியான்"}]},{"lineNumber":122,"text":"அருஞ்சுழி நீத்தத் தாழு மொருவன்","words":[{"form":"அருஞ்சுழி"},{"form":"நீத்தத்"},{"form":"தாழு"},{"form":"மொருவன்"}]},{"lineNumber":123,"text":"பெரும்புணை பெற்ற பெற்றி போல","words":[{"form":"பெரும்புணை"},{"form":"பெற்ற"},{"form":"பெற்றி"},{"form":"போல"}]},{"lineNumber":124,"text":"நிற்பெறு சிறப்பொடு நெடுநகர் புகல","words":[{"form":"நிற்பெறு"},{"form":"சிறப்பொடு"},{"form":"நெடுநகர்"},{"form":"புகல"}]},{"lineNumber":125,"text":"முற்படத் தோன்றிய முகைப்பூண் மார்வன்","words":[{"form":"முற்படத்"},{"form":"தோன்றிய"},{"form":"முகைப்பூண்"},{"form":"மார்வன்"}]},{"lineNumber":126,"text":"தற்படு துயரந் தன்மனத் தணையான்","words":[{"form":"தற்படு"},{"form":"துயரந்"},{"form":"தன்மனத்"},{"form":"தணையான்"}]},{"lineNumber":127,"text":"மட்டுறு கோதாய் மற்றுநின் வனமுலை","words":[{"form":"மட்டுறு"},{"form":"கோதாய்"},{"form":"மற்றுநின்"},{"form":"வனமுலை"}]},{"lineNumber":128,"text":"விட்டுறை வாற்றா வேட்கையிற் கெழுமிப்","words":[{"form":"விட்டுறை"},{"form":"வாற்றா"},{"form":"வேட்கையிற்"},{"form":"கெழுமிப்"}]},{"lineNumber":129,"text":"பட்டுறை பிரியாப் படிமையி னவ்வழி","words":[{"form":"பட்டுறை"},{"form":"பிரியாப்"},{"form":"படிமையி"},{"form":"னவ்வழி"}]},{"lineNumber":130,"text":"ஒட்டிடை விட்டபி னல்லதை யொழிதல்","words":[{"form":"ஒட்டிடை"},{"form":"விட்டபி"},{"form":"னல்லதை"},{"form":"யொழிதல்"}]},{"lineNumber":131,"text":"வாணுதன் மடவோ யரிதுமற் றதனாற்","words":[{"form":"வாணுதன்"},{"form":"மடவோ"},{"form":"யரிதுமற்"},{"form":"றதனாற்"}]},{"lineNumber":132,"text":"சேண்வரு பெருங்குடிச் சிறுசொ னீங்க","words":[{"form":"சேண்வரு"},{"form":"பெருங்கு