rm":"முதுமரத்"},{"form":"துச்சிச்"},{"form":"சேக்கும்"}]},{"lineNumber":88,"text":"து… க… ரக் குரலளைஇச்","words":[{"form":"து…"},{"form":"க…"},{"form":"ரக்"},{"form":"குரலளைஇச்"}]},{"lineNumber":89,"text":"சேக்கை நல்லியாழ் செவ்வழி பண்ணிச்","words":[{"form":"சேக்கை"},{"form":"நல்லியாழ்"},{"form":"செவ்வழி"},{"form":"பண்ணிச்"}]},{"lineNumber":90,"text":"செறிவிரற் பாணியி னறிவரப்பாடவும்","words":[{"form":"செறிவிரற்"},{"form":"பாணியி"},{"form":"னறிவரப்பாடவும்"}]},{"lineNumber":91,"text":"அகினா றங்கை சிவப்ப நல்லோர்","words":[{"form":"அகினா"},{"form":"றங்கை"},{"form":"சிவப்ப"},{"form":"நல்லோர்"}]},{"lineNumber":92,"text":"துகிலின் வெண்கிழித் துய்க்கடை நிமிடி","words":[{"form":"துகிலின்"},{"form":"வெண்கிழித்"},{"form":"துய்க்கடை"},{"form":"நிமிடி"}]},{"lineNumber":93,"text":"உள்ளிழு துறீஇய வொள்ளடர்ப் பாண்டிற்","words":[{"form":"உள்ளிழு"},{"form":"துறீஇய"},{"form":"வொள்ளடர்ப்"},{"form":"பாண்டிற்"}]},{"lineNumber":94,"text":"றிரிதலைக் கொளீஇ யெரிதரு மாலை","words":[{"form":"றிரிதலைக்"},{"form":"கொளீஇ"},{"form":"யெரிதரு"},{"form":"மாலை"}]},{"lineNumber":95,"text":"வெந்துயர்க் கண்ணின் வேலிட் டதுபோல்","words":[{"form":"வெந்துயர்க்"},{"form":"கண்ணின்"},{"form":"வேலிட்"},{"form":"டதுபோல்"}]},{"lineNumber":96,"text":"வந்திறுத் தன்றால் வலியெனக் கில்லெனக்","words":[{"form":"வந்திறுத்"},{"form":"தன்றால்"},{"form":"வலியெனக்"},{"form":"கில்லெனக்"}]},{"lineNumber":97,"text":"கையறு குருசிலை வைகிய தெழுவென","words":[{"form":"கையறு"},{"form":"குருசிலை"},{"form":"வைகிய"},{"form":"தெழுவென"}]},{"lineNumber":98,"text":"இலங்குசுடர் விளக்கொ டெதிர்வந் தேத்திப்","words":[{"form":"இலங்குசுடர்"},{"form":"விளக்கொ"},{"form":"டெதிர்வந்"},{"form":"தேத்திப்"}]},{"lineNumber":99,"text":"புறங்காப் பிளையர் புரிந்தகம் படுப்ப","words":[{"form":"புறங்காப்"},{"form":"பிளையர்"},{"form":"புரிந்தகம்"},{"form":"படுப்ப"}]},{"lineNumber":100,"text":"எண்ணா லிலக்கணத்து நுண்ணூல் வாங்கித்","words":[{"form":"எண்ணா"},{"form":"லிலக்கணத்து"},{"form":"நுண்ணூல்"},{"form":"வாங்கித்"}]},{"lineNumber":101,"text":"திணைவிதி யாள ரிணையற வ