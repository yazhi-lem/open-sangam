er":81,"text":"பேரவ ளுரைத்தலிற் பெருமக னோக்கித்","words":[{"form":"பேரவ"},{"form":"ளுரைத்தலிற்"},{"form":"பெருமக"},{"form":"னோக்கித்"}]},{"lineNumber":82,"text":"துன்பமு யின்பமுந் துறக்க லாற்றா","words":[{"form":"துன்பமு"},{"form":"யின்பமுந்"},{"form":"துறக்க"},{"form":"லாற்றா"}]},{"lineNumber":83,"text":"மன்பெருந் தேவியொடு செலவுள மமர்தலின்","words":[{"form":"மன்பெருந்"},{"form":"தேவியொடு"},{"form":"செலவுள"},{"form":"மமர்தலின்"}]},{"lineNumber":84,"text":"மற்றதை யுணர்த்தி முற்றிழை யெழுகெனப்","words":[{"form":"மற்றதை"},{"form":"யுணர்த்தி"},{"form":"முற்றிழை"},{"form":"யெழுகெனப்"}]},{"lineNumber":85,"text":"பற்றுந ளுடனே பறந்துவிசும் பிவர","words":[{"form":"பற்றுந"},{"form":"ளுடனே"},{"form":"பறந்துவிசும்"},{"form":"பிவர"}]},{"lineNumber":86,"text":"மேலுங் கீழு மேவர நோக்கி","words":[{"form":"மேலுங்"},{"form":"கீழு"},{"form":"மேவர"},{"form":"நோக்கி"}]},{"lineNumber":87,"text":"மாசறு மகளிர் மம்ம ரெய்தி","words":[{"form":"மாசறு"},{"form":"மகளிர்"},{"form":"மம்ம"},{"form":"ரெய்தி"}]},{"lineNumber":88,"text":"ஆனாக் கனவிடை மாநிதிக் கிழவன்","words":[{"form":"ஆனாக்"},{"form":"கனவிடை"},{"form":"மாநிதிக்"},{"form":"கிழவன்"}]},{"lineNumber":89,"text":"விளங்கவை நாப்பட் டுளங்கினர் புகுதலின்","words":[{"form":"விளங்கவை"},{"form":"நாப்பட்"},{"form":"டுளங்கினர்"},{"form":"புகுதலின்"}]},{"lineNumber":90,"text":"அரிமா சுமந்த வமளி காட்டத்","words":[{"form":"அரிமா"},{"form":"சுமந்த"},{"form":"வமளி"},{"form":"காட்டத்"}]},{"lineNumber":91,"text":"திருமா ணாகத்துத் தேவியொ டேறி","words":[{"form":"திருமா"},{"form":"ணாகத்துத்"},{"form":"தேவியொ"},{"form":"டேறி"}]},{"lineNumber":92,"text":"இருந்த பொழுதிற் பொருந்திய வல்லியுள்","words":[{"form":"இருந்த"},{"form":"பொழுதிற்"},{"form":"பொருந்திய"},{"form":"வல்லியுள்"}]},{"lineNumber":93,"text":"வெள்ளேறு கிடந்த வேண்டா மரைப்பூக்","words":[{"form":"வெள்ளேறு"},{"form":"கிடந்த"},{"form":"வேண்டா"},{"form":"மரைப்பூக்"}]},{"lineNumber":94,"text":"கொள்வழி யெழுதிய கொடுஞ்சி யுடைத்தேர்ப்","words":[{"form":"கொள்வழி"},{"form":"யெழுதிய"},{"form":"கொடுஞ்சி"},{"form":"ய