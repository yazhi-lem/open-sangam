text":"ஐவகைச் சோதிட ரணிபெறு கற்பம்","words":[{"form":"ஐவகைச்"},{"form":"சோதிட"},{"form":"ரணிபெறு"},{"form":"கற்பம்"}]},{"lineNumber":190,"text":"கைவைத் தொழியக் கடந்துசென் றுப்பால்","words":[{"form":"கைவைத்"},{"form":"தொழியக்"},{"form":"கடந்துசென்"},{"form":"றுப்பால்"}]},{"lineNumber":191,"text":"அமரா பதியு மந்தரத் தெல்லையும்","words":[{"form":"அமரா"},{"form":"பதியு"},{"form":"மந்தரத்"},{"form":"தெல்லையும்"}]},{"lineNumber":192,"text":"நுகர்பூங் காவு நோக்குபு வருதற்","words":[{"form":"நுகர்பூங்"},{"form":"காவு"},{"form":"நோக்குபு"},{"form":"வருதற்"}]},{"lineNumber":193,"text":"குற்றதென் மனனெனு முணர்வின ளாகி","words":[{"form":"குற்றதென்"},{"form":"மனனெனு"},{"form":"முணர்வின"},{"form":"ளாகி"}]},{"lineNumber":194,"text":"மற்றுப்பிறர்க் குரையாண் மனத்தே யடக்கி","words":[{"form":"மற்றுப்பிறர்க்"},{"form":"குரையாண்"},{"form":"மனத்தே"},{"form":"யடக்கி"}]},{"lineNumber":195,"text":"ஈர்க்கொடு பிறந்த விளந்தளிர் போல","words":[{"form":"ஈர்க்கொடு"},{"form":"பிறந்த"},{"form":"விளந்தளிர்"},{"form":"போல"}]},{"lineNumber":196,"text":"மாக்கே ழாகமு மருங்குலும் வருந்த","words":[{"form":"மாக்கே"},{"form":"ழாகமு"},{"form":"மருங்குலும்"},{"form":"வருந்த"}]},{"lineNumber":197,"text":"முலைக்கண் மறுப்பத் தலைக்கவி னெய்தி","words":[{"form":"முலைக்கண்"},{"form":"மறுப்பத்"},{"form":"தலைக்கவி"},{"form":"னெய்தி"}]},{"lineNumber":198,"text":"வளம்பாற் றன்மையின் வந்துபுடை யடுத்த","words":[{"form":"வளம்பாற்"},{"form":"றன்மையின்"},{"form":"வந்துபுடை"},{"form":"யடுத்த"}]},{"lineNumber":199,"text":"இளம்பாற் கெதிர்ந்த விடத்த வாகிய","words":[{"form":"இளம்பாற்"},{"form":"கெதிர்ந்த"},{"form":"விடத்த"},{"form":"வாகிய"}]},{"lineNumber":200,"text":"முலைபொறை யாற்றா முனிவின் றலையும்","words":[{"form":"முலைபொறை"},{"form":"யாற்றா"},{"form":"முனிவின்"},{"form":"றலையும்"}]},{"lineNumber":201,"text":"மலைபொறுத் தென்ன மகனையுந் தாங்கி","words":[{"form":"மலைபொறுத்"},{"form":"தென்ன"},{"form":"மகனையுந்"},{"form":"தாங்கி"}]},{"lineNumber":202,"text":"நொந்துபுற மெலிந்த தன்றியு மந்தரத்","words":[{"form":"நொந்துபுற"},{"form":"மெல