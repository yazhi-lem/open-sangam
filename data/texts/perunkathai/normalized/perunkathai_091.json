"உயர்ந்தோர்"},{"form":"கொள்கையி"},{"form":"னொண்டொடி"},{"form":"யொதுங்க"}]},{"lineNumber":217,"text":"மன்னவன் மறுத்து மடவோய் மற்று","words":[{"form":"மன்னவன்"},{"form":"மறுத்து"},{"form":"மடவோய்"},{"form":"மற்று"}]},{"lineNumber":218,"text":"நின்னுயிர் மதியா யாயி னென்னுயிர்","words":[{"form":"நின்னுயிர்"},{"form":"மதியா"},{"form":"யாயி"},{"form":"னென்னுயிர்"}]},{"lineNumber":219,"text":"யானும் வேண்டே னாயிழை கேண்மோ","words":[{"form":"யானும்"},{"form":"வேண்டே"},{"form":"னாயிழை"},{"form":"கேண்மோ"}]},{"lineNumber":220,"text":"கூடிய கொழுநன் கொழுங்குடர் மிசைகுற","words":[{"form":"கூடிய"},{"form":"கொழுநன்"},{"form":"கொழுங்குடர்"},{"form":"மிசைகுற"}]},{"lineNumber":221,"text":"ஓடிய வுள்ளத் துயர்துணைத் தேவியைக்","words":[{"form":"ஓடிய"},{"form":"வுள்ளத்"},{"form":"துயர்துணைத்"},{"form":"தேவியைக்"}]},{"lineNumber":222,"text":"குறையிற் கேட்டுக் கொடுத்துநோய் தணித்த","words":[{"form":"குறையிற்"},{"form":"கேட்டுக்"},{"form":"கொடுத்துநோய்"},{"form":"தணித்த"}]},{"lineNumber":223,"text":"மறையில் பெரும்புகழ் மன்னவன் போல","words":[{"form":"மறையில்"},{"form":"பெரும்புகழ்"},{"form":"மன்னவன்"},{"form":"போல"}]},{"lineNumber":224,"text":"என்ன தாயினு மீகுவன் மற்றுநின்","words":[{"form":"என்ன"},{"form":"தாயினு"},{"form":"மீகுவன்"},{"form":"மற்றுநின்"}]},{"lineNumber":225,"text":"இன்னா வெந்நோ யெத்திறத் தாயினும்","words":[{"form":"இன்னா"},{"form":"வெந்நோ"},{"form":"யெத்திறத்"},{"form":"தாயினும்"}]},{"lineNumber":226,"text":"ஒடுங்கா வுள்ளமொ டகற்றுவல் யானெனக்","words":[{"form":"ஒடுங்கா"},{"form":"வுள்ளமொ"},{"form":"டகற்றுவல்"},{"form":"யானெனக்"}]},{"lineNumber":227,"text":"கடுஞ்சூ ளறைஇக் காவலன் கேட்ப","words":[{"form":"கடுஞ்சூ"},{"form":"ளறைஇக்"},{"form":"காவலன்"},{"form":"கேட்ப"}]},{"lineNumber":228,"text":"ஒழுங்கினுங் கற்பினு மிழுக்க மின்றெனப்","words":[{"form":"ஒழுங்கினுங்"},{"form":"கற்பினு"},{"form":"மிழுக்க"},{"form":"மின்றெனப்"}]},{"lineNumber":229,"text":"பசைஇய கேள்வனைப் பைந்தொடி வணங்கி","words":[{"form":"பசைஇய"},{"form":"கேள்வனைப்"},{"form":"பைந்தொடி"},{"form":"வணங்கி"}]},{"lineNumber":230,"text":"அசையா வூக்கத் தடிகளென் னுள்ளம்","words":[{"form":"அசையா"},{"form":"வூக்கத்"},{"form":"தடிகளென்"},{"form":"னுள்ளம்"}]},{"lineNumber":231,"text":"விசைகொ ணோன்றாள் விச்சா தரர்போல்","words":[{"form":"விசைகொ"},{"form":"ணோன்றாள்"},{"form":"விச்சா"},{"form":"தரர்போல்"}]},{"lineNumber":232,"text":"மிசையே சென்றுற மேன்மே னெருங்கும்","words":[{"form":"மிசையே"},{"form":"சென்றுற"},{"form":"மேன்மே"},{"form":"னெருங்கும்"}]},{"lineNumber":233,"text":"இசையா வரும்பொரு ளிற்றென வுரைத்தல்","words":[{"form":"இசையா"},{"form":"வரும்பொரு"},{"form":"ளிற்றென"},{"form":"வுரைத்தல்"}]},{"lineNumber":234,"text":"வசைதீர் வையத்து நகைய தாதலிற்","words":[{"form":"வசைதீர்"},{"form":"வையத்து"},{"form":"நகைய"},{"form":"தாதலிற்"}]},{"lineNumber":235,"text":"சொல்லிய திலனென மெல்லியன் மிழற்ற","words":[{"form":"சொல்லிய"},{"form":"திலனென"},{"form":"மெல்லியன்"},{"form":"மிழற்ற"}]},{"lineNumber":236,"text":"எளிதெனக் கென்ன வமைச்சரோ டாராய்ந்","words":[{"form":"எளிதெனக்"},{"form":"கென்ன"},{"form":"வமைச்சரோ"},{"form":"டாராய்ந்"}]},{"lineNumber":237,"text":"தொளிமலர்க் கோதா யுற்றபி ன்றியெனத்","words":[{"form":"தொளிமலர்க்"},{"form":"கோதா"},{"form":"யுற்றபி"},{"form":"ன்றியெனத்"}]},{"lineNumber":238,"text":"துன்ப நீக்குந் தோழரோ டியைந்தே","words":[{"form":"துன்ப"},{"form":"நீக்குந்"},{"form":"தோழரோ"},{"form":"டியைந்தே"}]},{"lineNumber":239,"text":"இன்பக் கோட்டியு னினிதி னிருந்து","words":[{"form":"இன்பக்"},{"form":"கோட்டியு"},{"form":"னினிதி"},{"form":"னிருந்து"}]},{"lineNumber":240,"text":"பேராக் கழற்காற் பெருந்தகை வேந்தன்","words":[{"form":"பேராக்"},{"form":"கழற்காற்"},{"form":"பெருந்தகை"},{"form":"வேந்தன்"}]},{"lineNumber":241,"text":"ஆர்வவேய்த் தோளி யசாநோய் தீரிய","words":[{"form":"ஆர்வவேய்த்"},{"form":"தோளி"},{"form":"யசாநோய்"},{"form":"தீரிய"}]},{"lineNumber":242,"text":"ஆராய்ந் தனனா லமைச்சரோ டொருங்கென்.","words":[{"form":"ஆராய்ந்"},{"form":"தனனா"},{"form":"லமைச்சரோ"},{"form":"டொருங்கென்."}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AA%E0%AF%86%E0%AE%B0%E0%AF%81%E0%AE%99%E0%AF%8D%E0%AE%95%E0%AE%A4%E0%AF%88/5_1_%E0%AE%B5%E0%AE%AF%E0%AE%BE%E0%AE%95%E0%AF%8D_%E0%AE%95%E0%AF%87%E0%AE%9F%E0%AF%8D%E0%AE%9F%E0%AE%A4%E0%AF%81","verified":false,"structure":{"level":"chapter","book":"காண்டம் 5","chapter":"வயாக் கேட்டது","chapterNumber":1,"number":1,"verseCount":null},"title":"வயாக் கேட்டது"}
