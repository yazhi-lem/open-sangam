":"யாகம்"}]},{"lineNumber":135,"text":"இன்றை யெல்லையு ளியையா தாயிற்","words":[{"form":"இன்றை"},{"form":"யெல்லையு"},{"form":"ளியையா"},{"form":"தாயிற்"}]},{"lineNumber":136,"text":"சென்றதென் னுயிரெனத் தேவிமுகத் தெழுதி","words":[{"form":"சென்றதென்"},{"form":"னுயிரெனத்"},{"form":"தேவிமுகத்"},{"form":"தெழுதி"}]},{"lineNumber":137,"text":"வாட்டிறல் வேந்தன் மீட்டனன் விடுத்தலிற்","words":[{"form":"வாட்டிறல்"},{"form":"வேந்தன்"},{"form":"மீட்டனன்"},{"form":"விடுத்தலிற்"}]},{"lineNumber":138,"text":"பெருமகள் செல்லத் திருமகள் வாசகக்","words":[{"form":"பெருமகள்"},{"form":"செல்லத்"},{"form":"திருமகள்"},{"form":"வாசகக்"}]},{"lineNumber":139,"text":"கரும மெல்லா மொருமையி னுணர்ந்து","words":[{"form":"கரும"},{"form":"மெல்லா"},{"form":"மொருமையி"},{"form":"னுணர்ந்து"}]},{"lineNumber":140,"text":"வயாத்தீர் வதற்கோ ருயாத்துணை யின்றி","words":[{"form":"வயாத்தீர்"},{"form":"வதற்கோ"},{"form":"ருயாத்துணை"},{"form":"யின்றி"}]},{"lineNumber":141,"text":"மறுசுழிப் பட்ட நறுமலர் போலக்","words":[{"form":"மறுசுழிப்"},{"form":"பட்ட"},{"form":"நறுமலர்"},{"form":"போலக்"}]},{"lineNumber":142,"text":"கொட்புறு நெஞ்சினைத் திட்பங் கொளீஇ","words":[{"form":"கொட்புறு"},{"form":"நெஞ்சினைத்"},{"form":"திட்பங்"},{"form":"கொளீஇ"}]},{"lineNumber":143,"text":"விளைக பொலிக வேந்த னுறுகுறை","words":[{"form":"விளைக"},{"form":"பொலிக"},{"form":"வேந்த"},{"form":"னுறுகுறை"}]},{"lineNumber":144,"text":"களைகுவ லின்றெனுங் கருத்தொடு புலம்பி","words":[{"form":"களைகுவ"},{"form":"லின்றெனுங்"},{"form":"கருத்தொடு"},{"form":"புலம்பி"}]},{"lineNumber":145,"text":"அற்றை வைகல் கழிந்தபி னவளை","words":[{"form":"அற்றை"},{"form":"வைகல்"},{"form":"கழிந்தபி"},{"form":"னவளை"}]},{"lineNumber":146,"text":"மற்றுய ரணிநலம் வழிநாட் புனைஇக்","words":[{"form":"மற்றுய"},{"form":"ரணிநலம்"},{"form":"வழிநாட்"},{"form":"புனைஇக்"}]},{"lineNumber":147,"text":"கூத்தப் பள்ளிக் குச்சரக் குடிகையுட்","words":[{"form":"கூத்தப்"},{"form":"பள்ளிக்"},{"form":"குச்சரக்"},{"form":"குடிகையுட்"}]},{"lineNumber":148,"text":"பாற்படு வேதிகை சேர்த்தன ளாகி","words":[{"form":"ப