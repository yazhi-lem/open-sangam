"text":"வண்டலர் கோதாய் மனத்தினு மில்லது","words":[{"form":"வண்டலர்"},{"form":"கோதாய்"},{"form":"மனத்தினு"},{"form":"மில்லது"}]},{"lineNumber":204,"text":"கண்டனை யாதலிற் கலங்கினை மற்றுநின்","words":[{"form":"கண்டனை"},{"form":"யாதலிற்"},{"form":"கலங்கினை"},{"form":"மற்றுநின்"}]},{"lineNumber":205,"text":"உள்ளத் துள்ளே யுறைகுவே னாகவும்","words":[{"form":"உள்ளத்"},{"form":"துள்ளே"},{"form":"யுறைகுவே"},{"form":"னாகவும்"}]},{"lineNumber":206,"text":"கள்வ னென்று கருதினை யன்றியும்","words":[{"form":"கள்வ"},{"form":"னென்று"},{"form":"கருதினை"},{"form":"யன்றியும்"}]},{"lineNumber":207,"text":"நெறியுடை மகளிர் நினைப்பவுங் காண்பவும்","words":[{"form":"நெறியுடை"},{"form":"மகளிர்"},{"form":"நினைப்பவுங்"},{"form":"காண்பவும்"}]},{"lineNumber":208,"text":"இவையிவை போலுங் கணவர்தந் திறத்தெனக்","words":[{"form":"இவையிவை"},{"form":"போலுங்"},{"form":"கணவர்தந்"},{"form":"திறத்தெனக்"}]},{"lineNumber":209,"text":"கனவிற் கண்டது பிறரொடு பேசக்","words":[{"form":"கனவிற்"},{"form":"கண்டது"},{"form":"பிறரொடு"},{"form":"பேசக்"}]},{"lineNumber":210,"text":"குறைபோ மென்றலிற் கூறினே னன்றியும்","words":[{"form":"குறைபோ"},{"form":"மென்றலிற்"},{"form":"கூறினே"},{"form":"னன்றியும்"}]},{"lineNumber":211,"text":"யாவை காணினுங் காவலற் கன்றிப்","words":[{"form":"யாவை"},{"form":"காணினுங்"},{"form":"காவலற்"},{"form":"கன்றிப்"}]},{"lineNumber":212,"text":"பேசுவ தெவரொடு பெரியோ யென்று","words":[{"form":"பேசுவ"},{"form":"தெவரொடு"},{"form":"பெரியோ"},{"form":"யென்று"}]},{"lineNumber":213,"text":"மானார் நோக்கி மனத்தொடு நகையா","words":[{"form":"மானார்"},{"form":"நோக்கி"},{"form":"மனத்தொடு"},{"form":"நகையா"}]},{"lineNumber":214,"text":"ஆனா நினைவுட னகறா வேந்தன்","words":[{"form":"ஆனா"},{"form":"நினைவுட"},{"form":"னகறா"},{"form":"வேந்தன்"}]},{"lineNumber":215,"text":"தேவியை யையந் தெளித்தன மொருவகை","words":[{"form":"தேவியை"},{"form":"யையந்"},{"form":"தெளித்தன"},{"form":"மொருவகை"}]},{"lineNumber":216,"text":"யாரு மில்லென வினிதிருந் துவப்பப்","words":[{"form":"யாரு"},{"form":"மில்லென"},{"form":"வினிதிருந்"},{"form":"துவப்பப்"}]},{"lineNumber":217,"text":"பானுவுந் தேரொடு படுவரை யிடைபுக","words":[{"form":"பானுவுந்"},{"form":"தேரொடு"},{"form":"படுவரை"},{"form":"யிடைபுக"}]},{"lineNumber":218,"text":"மான னீகையைக் காவல்வைத் தனளாய்","words":[{"form":"மான"},{"form":"னீகையைக்"},{"form":"காவல்வைத்"},{"form":"தனளாய்"}]},{"lineNumber":219,"text":"மாந்தளிர் மேனீயுங் காஞ்சன மாலையொடு","words":[{"form":"மாந்தளிர்"},{"form":"மேனீயுங்"},{"form":"காஞ்சன"},{"form":"மாலையொடு"}]},{"lineNumber":220,"text":"நேர்ந்தவக் குறியிற் றான்சென் றிருப்ப","words":[{"form":"நேர்ந்தவக்"},{"form":"குறியிற்"},{"form":"றான்சென்"},{"form":"றிருப்ப"}]},{"lineNumber":221,"text":"நிகழ்ந்ததை யறியா னெழுந்து மெல்லென","words":[{"form":"நிகழ்ந்ததை"},{"form":"யறியா"},{"form":"னெழுந்து"},{"form":"மெல்லென"}]},{"lineNumber":222,"text":"நடந்தவன் சென்றவ ளிடந்தலைப் படலும்","words":[{"form":"நடந்தவன்"},{"form":"சென்றவ"},{"form":"ளிடந்தலைப்"},{"form":"படலும்"}]},{"lineNumber":223,"text":"வேந்தன் செய்வது காண்குவ மென்று","words":[{"form":"வேந்தன்"},{"form":"செய்வது"},{"form":"காண்குவ"},{"form":"மென்று"}]},{"lineNumber":224,"text":"காம்பேர் தோளி கையி னீக்கலும்","words":[{"form":"காம்பேர்"},{"form":"தோளி"},{"form":"கையி"},{"form":"னீக்கலும்"}]},{"lineNumber":225,"text":"மான னீகைதா னூடின ளாகி","words":[{"form":"மான"},{"form":"னீகைதா"},{"form":"னூடின"},{"form":"ளாகி"}]},{"lineNumber":226,"text":"மேவல ளாயினள் போலுமென் றெண்ணி","words":[{"form":"மேவல"},{"form":"ளாயினள்"},{"form":"போலுமென்"},{"form":"றெண்ணி"}]},{"lineNumber":227,"text":"முரசு முழங்கு தானை யரசொடு வேண்டினும்","words":[{"form":"முரசு"},{"form":"முழங்கு"},{"form":"தானை"},{"form":"யரசொடு"},{"form":"வேண்டினும்"}]},{"lineNumber":228,"text":"தருகுவ லின்னே பருவர லொழியினி","words":[{"form":"தருகுவ"},{"form":"லின்னே"},{"form":"பருவர"},{"form":"லொழியினி"}]},{"lineNumber":229,"text":"மானே தேனே மான்னீ காயெனக்","words":[{"form":"மானே"},{"form":"தேனே"},{"form":"மான்னீ"},{"form":"காயெனக்"}]},{"lineNumber":230,"text":"கானேர் பற்றத் தானது கொடாஅ","words":[{"form":"கானேர்"},{"form":"பற்றத்"},{"form":"தானது"},{"form":"கொடாஅ"}]},{"lineNumber":231,"text":"துரைப்பது கேட்ப மறுத்தவ ளொதுங்கி","words":[{"form":"துரைப்பது"},{"form":"கேட்ப"},{"form":"மறுத்தவ"},{"form":"ளொதுங்கி"}]},{"lineNumber":232,"text":"நிலைப்படு காமந் தலைப்படத் தரியான்","words":[{"form":"நிலைப்படு"},{"form":"காமந்"},{"form":"தலைப்படத்"},{"form":"தரியான்"}]},{"lineNumber":233,"text":"புதுமை கூறியிவண் முகம்பெறு கேனென","words":[{"form":"புதுமை"},{"form":"கூறியிவண்"},{"form":"முகம்பெறு"},{"form":"கேனென"}]},{"lineNumber":234,"text":"மதித்தன னாகி யொருமொழி கேளினி","words":[{"form":"மதித்தன"},{"form":"னாகி"},{"form":"யொருமொழி"},{"form":"கேளினி"}]},{"lineNumber":235,"text":"முகைக்கொடி முல்லை நகைத்திரு முகத்துத்","words":[{"form":"முகைக்கொடி"},{"form":"முல்லை"},{"form":"நகைத்திரு"},{"form":"முகத்துத்"}]},{"lineNumber":236,"text":"தகைக்கொடி யனையோள் வாசவ தத்தை","words":[{"form":"தகைக்கொடி"},{"form":"யனையோள்"},{"form":"வாசவ"},{"form":"தத்தை"}]},{"lineNumber":237,"text":"இயைந்த நெஞ்சுடை யாமிரு வர்க்கும்","words":[{"form":"இயைந்த"},{"form":"நெஞ்சுடை"},{"form":"யாமிரு"},{"form":"வர்க்கும்"}]},{"lineNumber":238,"text":"கழிந்த கங்குலி னிகழ்ந்ததை யெல்லாம்","words":[{"form":"கழிந்த"},{"form":"கங்குலி"},{"form":"னிகழ்ந்ததை"},{"form":"யெல்லாம்"}]},{"lineNumber":239,"text":"கனவது முந்திய வினைய தாதலின்","words":[{"form":"கனவது"},{"form":"முந்திய"},{"form":"வினைய"},{"form":"தாதலின்"}]},{"lineNumber":240,"text":"அதனிற் கண்டெனக் கொளியா துரைப்ப","words":[{"form":"அதனிற்"},{"form":"கண்டெனக்"},{"form":"கொளியா"},{"form":"துரைப்ப"}]},{"lineNumber":241,"text":"அதற்கொரு வழியான் மனத்தினு மில்லெனத்","words":[{"form":"அதற்கொரு"},{"form":"வழியான்"},{"form":"மனத்தினு"},{"form":"மில்லெனத்"}]},{"lineNumber":242,"text":"தெளித்த நிலைமையுந் தெளிந்திலை யேயெனப்","words":[{"form":"தெளித்த"},{"form":"நிலைமையுந்"},{"form":"தெளிந்திலை"},{"form":"யேயெனப்"}]},{"lineNumber":243,"text":"பெயரப் பெயர முறைமுறை வணங்கி","words":[{"form":"பெயரப்"},{"form":"பெயர"},{"form":"முறைமுறை"},{"form":"வணங்கி"}]},{"lineNumber":244,"text":"இயனிலை மான னீகா யருளென்","words":[{"form":"இயனிலை"},{"form":"மான"},{"form":"னீகா"},{"form":"யருளென்"}]},{"lineNumber":245,"text":"றடுத்தடுத் துரைப்பவு மாற்றா னாகவும்","words":[{"form":"றடுத்தடுத்"},{"form":"துரைப்பவு"},{"form":"மாற்றா"},{"form":"னாகவும்"}]},{"lineNumber":246,"text":"இதச்சொற் சொல்லவும் வணக்கஞ் செய்யவும்","words":[{"form":"இதச்சொற்"},{"form":"சொல்லவும்"},{"form":"வணக்கஞ்"},{"form":"செய்யவும்"}]},{"lineNumber":247,"text":"பெட்ப வருதலிற் பிடித்தல் செல்லாள்","words":[{"form":"பெட்ப"},{"form":"வருதலிற்"},{"form":"பிடித்தல்"},{"form":"செல்லாள்"}]},{"lineNumber":248,"text":"நக்கன ளாகி மிக்கோய் கூறிய","words":[{"form":"நக்கன"},{"form":"ளாகி"},{"form":"மிக்கோய்"},{"form":"கூறிய"}]},{"lineNumber":249,"text":"மானுந் தேனு மான னீகையும்","words":[{"form":"மானுந்"},{"form":"தேனு"},{"form":"மான"},{"form":"னீகையும்"}]},{"lineNumber":250,"text":"யானன் றென்பெயர் வாசவ தத்தை","words":[{"form":"யானன்"},{"form":"றென்பெயர்"},{"form":"வாசவ"},{"form":"தத்தை"}]},{"lineNumber":251,"text":"காணெனக் கைவிட் டோடின னோடி","words":[{"form":"காணெனக்"},{"form":"கைவிட்"},{"form":"டோடின"},{"form":"னோடி"}]},{"lineNumber":252,"text":"அடுத்த காட்சியிற் றனித்தொரு மண்டபத்","words":[{"form":"அடுத்த"},{"form":"காட்சியிற்"},{"form":"றனித்தொரு"},{"form":"மண்டபத்"}]},{"lineNumber":253,"text":"தொளித்தன னாகித் திகைத்தன னிருப்பச்","words":[{"form":"தொளித்தன"},{"form":"னாகித்"},{"form":"திகைத்தன"},{"form":"னிருப்பச்"}]},{"lineNumber":254,"text":"சினங்கொ ணெஞ்சொடு பெயர்ந்தவள் வதியப்","words":[{"form":"சினங்கொ"},{"form":"ணெஞ்சொடு"},{"form":"பெயர்ந்தவள்"},{"form":"வதியப்"}]},{"lineNumber":255,"text":"புலர்ந்தது கங்குலும் பொருக்கெனப் பொலிந்தென்.","words":[{"form":"புலர்ந்தது"},{"form":"கங்குலும்"},{"form":"பொருக்கெனப்"},{"form":"பொலிந்தென்."}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AA%E0%AF%86%E0%AE%B0%E0%AF%81%E0%AE%99%E0%AF%8D%E0%AE%95%E0%AE%A4%E0%AF%88/4_13_%E0%AE%AE%E0%AF%81%E0%AE%95%E0%AE%B5%E0%AF%86%E0%AE%B4%E0%AF%81%E0%AE%A4%E0%AF%8D%E0%AE%A4%E0%AF%81%E0%AE%95%E0%AF%8D_%E0%AE%95%E0%AE%BE%E0%AE%A4%E0%AF%88","verified":false,"structure":{"level":"chapter","book":"காண்டம் 4","chapter":"முகவெழுத்துக் காதை","chapterNumber":13,"number":13,"verseCount":null},"title":"முகவெழுத்துக் காதை"}
