lineNumber":94,"text":"கற்புமேம் படீஇயர் பொற்றொடி பொலிந்தென","words":[{"form":"கற்புமேம்"},{"form":"படீஇயர்"},{"form":"பொற்றொடி"},{"form":"பொலிந்தென"}]},{"lineNumber":95,"text":"நற்பல கிளவி பற்பல பயிற்றி","words":[{"form":"நற்பல"},{"form":"கிளவி"},{"form":"பற்பல"},{"form":"பயிற்றி"}]},{"lineNumber":96,"text":"நெய்தலைப் பெய்த பின்றை மெய்வயின்","words":[{"form":"நெய்தலைப்"},{"form":"பெய்த"},{"form":"பின்றை"},{"form":"மெய்வயின்"}]},{"lineNumber":97,"text":"மென்மையு நேயமு நனமையு நாற்றமும்","words":[{"form":"மென்மையு"},{"form":"நேயமு"},{"form":"நனமையு"},{"form":"நாற்றமும்"}]},{"lineNumber":98,"text":"ஒருநாட் பூசினு மோரியாண்டு விடாஅத்","words":[{"form":"ஒருநாட்"},{"form":"பூசினு"},{"form":"மோரியாண்டு"},{"form":"விடாஅத்"}]},{"lineNumber":99,"text":"திருமா ணுறுப்பிற்குச் சீர்நிறை யமைத்துக்","words":[{"form":"திருமா"},{"form":"ணுறுப்பிற்குச்"},{"form":"சீர்நிறை"},{"form":"யமைத்துக்"}]},{"lineNumber":100,"text":"கரும வித்தகர் கைபுனைந் தியற்றிய","words":[{"form":"கரும"},{"form":"வித்தகர்"},{"form":"கைபுனைந்"},{"form":"தியற்றிய"}]},{"lineNumber":101,"text":"வாச வெண்ணெய் பூசினர் போற்றி","words":[{"form":"வாச"},{"form":"வெண்ணெய்"},{"form":"பூசினர்"},{"form":"போற்றி"}]},{"lineNumber":102,"text":"நூல்வழி நுனித்த நுழைநுண் ணுணர்வினர்","words":[{"form":"நூல்வழி"},{"form":"நுனித்த"},{"form":"நுழைநுண்"},{"form":"ணுணர்வினர்"}]},{"lineNumber":103,"text":"நால்வகைக் கோலத்து நால்வகை மாக்கள்","words":[{"form":"நால்வகைக்"},{"form":"கோலத்து"},{"form":"நால்வகை"},{"form":"மாக்கள்"}]},{"lineNumber":104,"text":"தாமரை மூய தமனியக் குடநீர்","words":[{"form":"தாமரை"},{"form":"மூய"},{"form":"தமனியக்"},{"form":"குடநீர்"}]},{"lineNumber":105,"text":"தாமுறை சொரிந்துதம் முறைமையி னாட்டிச்","words":[{"form":"தாமுறை"},{"form":"சொரிந்துதம்"},{"form":"முறைமையி"},{"form":"னாட்டிச்"}]},{"lineNumber":106,"text":"செய்த கோலஞ் சிதைய மறலிப்","words":[{"form":"செய்த"},{"form":"கோலஞ்"},{"form":"சிதைய"},{"form":"மறலிப்"}]},{"lineNumber":107,"text":"பெய்த னாடிப் பேதையர் பிணங்கி","words":[{"form":"பெய்த"},{"form":"னாடிப்"},