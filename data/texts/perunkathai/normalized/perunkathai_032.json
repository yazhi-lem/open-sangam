t":"மேற்புற மமைந்த விளங்குமணி வேயுள்","words":[{"form":"மேற்புற"},{"form":"மமைந்த"},{"form":"விளங்குமணி"},{"form":"வேயுள்"}]},{"lineNumber":136,"text":"யாப்புறு மண்டபத் தாசனத் திரீஇக்","words":[{"form":"யாப்புறு"},{"form":"மண்டபத்"},{"form":"தாசனத்"},{"form":"திரீஇக்"}]},{"lineNumber":137,"text":"கோப்புறு விழுக்கல மேத்துவனர் காட்டிக்","words":[{"form":"கோப்புறு"},{"form":"விழுக்கல"},{"form":"மேத்துவனர்"},{"form":"காட்டிக்"}]},{"lineNumber":138,"text":"கனமணி முடியுங் கதிர்முத் தாரமும்","words":[{"form":"கனமணி"},{"form":"முடியுங்"},{"form":"கதிர்முத்"},{"form":"தாரமும்"}]},{"lineNumber":139,"text":"இனமணிப் பூணு மேக வட்டமும்","words":[{"form":"இனமணிப்"},{"form":"பூணு"},{"form":"மேக"},{"form":"வட்டமும்"}]},{"lineNumber":140,"text":"வயிரக் குழையும் வல்வினைப் பொலிந்த","words":[{"form":"வயிரக்"},{"form":"குழையும்"},{"form":"வல்வினைப்"},{"form":"பொலிந்த"}]},{"lineNumber":141,"text":"நெடுந்தோள் வளையுங் கடுங்கதிர்க் கடகமும்","words":[{"form":"நெடுந்தோள்"},{"form":"வளையுங்"},{"form":"கடுங்கதிர்க்"},{"form":"கடகமும்"}]},{"lineNumber":142,"text":"நாமர வளியுங் காமர் கைவினைச்","words":[{"form":"நாமர"},{"form":"வளியுங்"},{"form":"காமர்"},{"form":"கைவினைச்"}]},{"lineNumber":143,"text":"சித்திரப் பிணையலும் பத்திரச் சுரிகையும்","words":[{"form":"சித்திரப்"},{"form":"பிணையலும்"},{"form":"பத்திரச்"},{"form":"சுரிகையும்"}]},{"lineNumber":144,"text":"பத்திக் கச்சினொ னொத்தவை பிறவும்","words":[{"form":"பத்திக்"},{"form":"கச்சினொ"},{"form":"னொத்தவை"},{"form":"பிறவும்"}]},{"lineNumber":145,"text":"ஆரணங் காகிய பேரணி கலங்களும்","words":[{"form":"ஆரணங்"},{"form":"காகிய"},{"form":"பேரணி"},{"form":"கலங்களும்"}]},{"lineNumber":146,"text":"உழைப்பெருஞ் சிலதியர் பிழைப்பிலர் நீட்ட","words":[{"form":"உழைப்பெருஞ்"},{"form":"சிலதியர்"},{"form":"பிழைப்பிலர்"},{"form":"நீட்ட"}]},{"lineNumber":147,"text":"அருவரை பிளந்த வஞ்சுவரு நெடுவேல்","words":[{"form":"அருவரை"},{"form":"பிளந்த"},{"form":"வஞ்சுவரு"},{"form":"நெடுவேல்"}]},{"lineNumber":148,"text":"ஒருவலத் துயரிய பொருவில் புட்கொடித்","words":[{"form":"ஒருவலத்"},{"form":"துயரிய"},{"form":"பொருவில்"},{"form":"புட்கொடித்"}]},{"lineNumber":149,"text":"தளையவிழ் நறுந்தார்த் தனக்கிணை யில்லா","words":[{"form":"தளையவிழ்"},{"form":"நறுந்தார்த்"},{"form":"தனக்கிணை"},{"form":"யில்லா"}]},{"lineNumber":150,"text":"இளையவன் படிவ மேற்ப வியல்புறீஇச்","words":[{"form":"இளையவன்"},{"form":"படிவ"},{"form":"மேற்ப"},{"form":"வியல்புறீஇச்"}]},{"lineNumber":151,"text":"சித்திர விருநிதிச் செந்நெறி நுனித்த","words":[{"form":"சித்திர"},{"form":"விருநிதிச்"},{"form":"செந்நெறி"},{"form":"நுனித்த"}]},{"lineNumber":152,"text":"வித்தக வினைஞர் தம்முடன் வந்து","words":[{"form":"வித்தக"},{"form":"வினைஞர்"},{"form":"தம்முடன்"},{"form":"வந்து"}]},{"lineNumber":153,"text":"வடிவு கண்டிடும் வத்தவர் பெருமகன்","words":[{"form":"வடிவு"},{"form":"கண்டிடும்"},{"form":"வத்தவர்"},{"form":"பெருமகன்"}]},{"lineNumber":154,"text":"ஒடிவில் வென்றி யுதயண குமரன்","words":[{"form":"ஒடிவில்"},{"form":"வென்றி"},{"form":"யுதயண"},{"form":"குமரன்"}]},{"lineNumber":155,"text":"ஒருமெய் சேர்ந்திவை பெருமை பெறுகென","words":[{"form":"ஒருமெய்"},{"form":"சேர்ந்திவை"},{"form":"பெருமை"},{"form":"பெறுகென"}]},{"lineNumber":156,"text":"அருளி னணியி னல்லதை யிவற்கிவை","words":[{"form":"அருளி"},{"form":"னணியி"},{"form":"னல்லதை"},{"form":"யிவற்கிவை"}]},{"lineNumber":157,"text":"உருவென வணியா வுறுப்புமுத லணிதலிற்","words":[{"form":"உருவென"},{"form":"வணியா"},{"form":"வுறுப்புமுத"},{"form":"லணிதலிற்"}]},{"lineNumber":158,"text":"புண்ணிய முடையவிப் பொன்னணி கலனென","words":[{"form":"புண்ணிய"},{"form":"முடையவிப்"},{"form":"பொன்னணி"},{"form":"கலனென"}]},{"lineNumber":159,"text":"எண்ணிய நெஞ்சமொடு நுண்வினைப் பொலிந்த","words":[{"form":"எண்ணிய"},{"form":"நெஞ்சமொடு"},{"form":"நுண்வினைப்"},{"form":"பொலிந்த"}]},{"lineNumber":160,"text":"கோல வித்தகர் வாலணி புனைய","words":[{"form":"கோல"},{"form":"வித்தகர்"},{"form":"வாலணி"},{"form":"புனைய"}]},{"lineNumber":161,"text":"ஆராக் காத லவந்திகை தன்னையும்","words":[{"form":"ஆராக்"},{"form":"காத"},{"form":"லவந்திகை"},{"form":"தன்னையும்"}]},{"lineNumber":162,"text":"நீராட் டிடத்