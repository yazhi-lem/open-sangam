umber":48,"text":"கொங்கார் கோடலொடு கொய்யல் குழைஇ","words":[{"form":"கொங்கார்"},{"form":"கோடலொடு"},{"form":"கொய்யல்"},{"form":"குழைஇ"}]},{"lineNumber":49,"text":"அனிச்சமு மசோகமு மடர வலைத்துப்","words":[{"form":"அனிச்சமு"},{"form":"மசோகமு"},{"form":"மடர"},{"form":"வலைத்துப்"}]},{"lineNumber":50,"text":"பனிச்சையும் பயினும் பறியப் பாய்ந்து","words":[{"form":"பனிச்சையும்"},{"form":"பயினும்"},{"form":"பறியப்"},{"form":"பாய்ந்து"}]},{"lineNumber":51,"text":"வள்ளியு மரலுந் தன்வழி வணக்கிப்","words":[{"form":"வள்ளியு"},{"form":"மரலுந்"},{"form":"தன்வழி"},{"form":"வணக்கிப்"}]},{"lineNumber":52,"text":"புள்ளி மானும் புல்வாய்த் தொகுதியும்","words":[{"form":"புள்ளி"},{"form":"மானும்"},{"form":"புல்வாய்த்"},{"form":"தொகுதியும்"}]},{"lineNumber":53,"text":"ஆமா வினமுந் தாமா றோடி","words":[{"form":"ஆமா"},{"form":"வினமுந்"},{"form":"தாமா"},{"form":"றோடி"}]},{"lineNumber":54,"text":"இடைப்புனற் பட்டவை யுடைப்புனற் கிவரப்","words":[{"form":"இடைப்புனற்"},{"form":"பட்டவை"},{"form":"யுடைப்புனற்"},{"form":"கிவரப்"}]},{"lineNumber":55,"text":"பொறிமயிற் பேடை போத்தொடு புலம்ப","words":[{"form":"பொறிமயிற்"},{"form":"பேடை"},{"form":"போத்தொடு"},{"form":"புலம்ப"}]},{"lineNumber":56,"text":"எறிமயி ரேனமொ டெண்கின மிரியக்","words":[{"form":"எறிமயி"},{"form":"ரேனமொ"},{"form":"டெண்கின"},{"form":"மிரியக்"}]},{"lineNumber":57,"text":"குரங்கு முசுவு மரந்தொறும் வாவச்","words":[{"form":"குரங்கு"},{"form":"முசுவு"},{"form":"மரந்தொறும்"},{"form":"வாவச்"}]},{"lineNumber":58,"text":"கரும்புந் தும்பியும் விரும்புபு விரைய","words":[{"form":"கரும்புந்"},{"form":"தும்பியும்"},{"form":"விரும்புபு"},{"form":"விரைய"}]},{"lineNumber":59,"text":"அகத்துறை பல்லுநி ரச்ச மெய்தப்","words":[{"form":"அகத்துறை"},{"form":"பல்லுநி"},{"form":"ரச்ச"},{"form":"மெய்தப்"}]},{"lineNumber":60,"text":"புறத்துறை பல்லுயிர் புகன்றுவிளை யாடப்","words":[{"form":"புறத்துறை"},{"form":"பல்லுயிர்"},{"form":"புகன்றுவிளை"},{"form":"யாடப்"}]},{"lineNumber":61,"text":"படிவப் பள்ளியொடு பாக்கங் கவர்ந்து","words":[{"form":"படிவப்"},{"form":"பள்ளியொடு"},{"fo