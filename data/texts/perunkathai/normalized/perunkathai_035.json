rm":"மோடேந்"},{"form":"தரிவை"},{"form":"முற்றத்து"},{"form":"முனாது"}]},{"lineNumber":107,"text":"பனஞ்செறும் பன்ன பன்மயிர் முன்கை","words":[{"form":"பனஞ்செறும்"},{"form":"பன்ன"},{"form":"பன்மயிர்"},{"form":"முன்கை"}]},{"lineNumber":108,"text":"நிணம்பசை கொண்ட நீளி நெடும்பற்","words":[{"form":"நிணம்பசை"},{"form":"கொண்ட"},{"form":"நீளி"},{"form":"நெடும்பற்"}]},{"lineNumber":109,"text":"சாஅய் நீங்கிச் சார்ந்தோர் துட்கெனும்","words":[{"form":"சாஅய்"},{"form":"நீங்கிச்"},{"form":"சார்ந்தோர்"},{"form":"துட்கெனும்"}]},{"lineNumber":110,"text":"பேஎ யுருவம் பெறவகுத் தெழுதிய","words":[{"form":"பேஎ"},{"form":"யுருவம்"},{"form":"பெறவகுத்"},{"form":"தெழுதிய"}]},{"lineNumber":111,"text":"அழிசுவர் மண்டபத் தகவயி னாரிருள்","words":[{"form":"அழிசுவர்"},{"form":"மண்டபத்"},{"form":"தகவயி"},{"form":"னாரிருள்"}]},{"lineNumber":112,"text":"வழிபடர் வலித்த மந்திரக் கோட்டியுள்","words":[{"form":"வழிபடர்"},{"form":"வலித்த"},{"form":"மந்திரக்"},{"form":"கோட்டியுள்"}]},{"lineNumber":113,"text":"வென்வேல் வேந்தனை விடுத்தனிர் சிறையென","words":[{"form":"வென்வேல்"},{"form":"வேந்தனை"},{"form":"விடுத்தனிர்"},{"form":"சிறையென"}]},{"lineNumber":114,"text":"இன்னுரை யமிர்த மியைந்தவர்க் கீத்துத்","words":[{"form":"இன்னுரை"},{"form":"யமிர்த"},{"form":"மியைந்தவர்க்"},{"form":"கீத்துத்"}]},{"lineNumber":115,"text":"தான்செய்ப் படுபொரு ளாங்கவர்க் குணர்த்தி","words":[{"form":"தான்செய்ப்"},{"form":"படுபொரு"},{"form":"ளாங்கவர்க்"},{"form":"குணர்த்தி"}]},{"lineNumber":116,"text":"ஊன்சேர் கடுவே லுதயண னீங்கிய","words":[{"form":"ஊன்சேர்"},{"form":"கடுவே"},{"form":"லுதயண"},{"form":"னீங்கிய"}]},{"lineNumber":117,"text":"கான்சேர் பெருவழிக் கடத்தல் செல்லீர்","words":[{"form":"கான்சேர்"},{"form":"பெருவழிக்"},{"form":"கடத்தல்"},{"form":"செல்லீர்"}]},{"lineNumber":118,"text":"நாடு மலையுங் காடும் பொருந்திக்","words":[{"form":"நாடு"},{"form":"மலையுங்"},{"form":"காடும்"},{"form":"பொருந்திக்"}]},{"lineNumber":119,"text":"கனிவளங் கவர்ந்து பதிவயிற் பெயரும்","words":[{"form":"கனிவளங்"},{"form":"கவர்ந்து"},{"form":"பதிவயிற்"},{"form"