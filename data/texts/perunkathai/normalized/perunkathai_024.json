{"form":"வோடிப்"}]},{"lineNumber":75,"text":"பிடியது வீழ்ச்சியும் பெணபாற் சுவடும்","words":[{"form":"பிடியது"},{"form":"வீழ்ச்சியும்"},{"form":"பெணபாற்"},{"form":"சுவடும்"}]},{"lineNumber":76,"text":"அடுதிற லாடவ ரற்றமும் பிறவும்","words":[{"form":"அடுதிற"},{"form":"லாடவ"},{"form":"ரற்றமும்"},{"form":"பிறவும்"}]},{"lineNumber":77,"text":"படியி னாய்ந்து கடுகுவன ரோடி","words":[{"form":"படியி"},{"form":"னாய்ந்து"},{"form":"கடுகுவன"},{"form":"ரோடி"}]},{"lineNumber":78,"text":"வெள்ளிடை வெண்மணன் மிதித்த சுவடுதொறும்","words":[{"form":"வெள்ளிடை"},{"form":"வெண்மணன்"},{"form":"மிதித்த"},{"form":"சுவடுதொறும்"}]},{"lineNumber":79,"text":"புள்ளடி யொழுக்கம் புருவனர் நோக்கி","words":[{"form":"புள்ளடி"},{"form":"யொழுக்கம்"},{"form":"புருவனர்"},{"form":"நோக்கி"}]},{"lineNumber":80,"text":"நெருந னீடிரு ணீங்குநர் சுவடிவை","words":[{"form":"நெருந"},{"form":"னீடிரு"},{"form":"ணீங்குநர்"},{"form":"சுவடிவை"}]},{"lineNumber":81,"text":"அருமை யுடைத்தவர்த் தலைப்பட னமக்கென","words":[{"form":"அருமை"},{"form":"யுடைத்தவர்த்"},{"form":"தலைப்பட"},{"form":"னமக்கென"}]},{"lineNumber":82,"text":"அடியுறி னடையு மம்புடை யெயினர்","words":[{"form":"அடியுறி"},{"form":"னடையு"},{"form":"மம்புடை"},{"form":"யெயினர்"}]},{"lineNumber":83,"text":"கடிகை வெள்ளிலுங் கள்ளி வற்றலும்","words":[{"form":"கடிகை"},{"form":"வெள்ளிலுங்"},{"form":"கள்ளி"},{"form":"வற்றலும்"}]},{"lineNumber":84,"text":"வாடிய வுவலொடு நீடதர் பரப்பி","words":[{"form":"வாடிய"},{"form":"வுவலொடு"},{"form":"நீடதர்"},{"form":"பரப்பி"}]},{"lineNumber":85,"text":"உழைவயிற் றரியாது முழைவயி னொடுங்கிய","words":[{"form":"உழைவயிற்"},{"form":"றரியாது"},{"form":"முழைவயி"},{"form":"னொடுங்கிய"}]},{"lineNumber":86,"text":"ஆறலை யிளையரை யாண்மை யெள்ளி","words":[{"form":"ஆறலை"},{"form":"யிளையரை"},{"form":"யாண்மை"},{"form":"யெள்ளி"}]},{"lineNumber":87,"text":"வேறினி நும்மொடு விளிகநுங் களவெனச்","words":[{"form":"வேறினி"},{"form":"நும்மொடு"},{"form":"விளிகநுங்"},{"form":"களவெனச்"}]},{"lineNumber":88,"text":"சேறல் வலியாச் செய்கை நோக்கி","words":[{"form":"சேறல்"},{"form":"வல