்"},{"form":"பொருந்தி"}]},{"lineNumber":129,"text":"உடும்பெறிந் ததுபோற் கடுங்கணை முள்க","words":[{"form":"உடும்பெறிந்"},{"form":"ததுபோற்"},{"form":"கடுங்கணை"},{"form":"முள்க"}]},{"lineNumber":130,"text":"விட்ட வேந்தன் விற்றொழில் கண்டும்","words":[{"form":"விட்ட"},{"form":"வேந்தன்"},{"form":"விற்றொழில்"},{"form":"கண்டும்"}]},{"lineNumber":131,"text":"கண்டுகை விடுதல் கரும மன்றென","words":[{"form":"கண்டுகை"},{"form":"விடுதல்"},{"form":"கரும"},{"form":"மன்றென"}]},{"lineNumber":132,"text":"விண்டல ரிலவத் தண்டைசார்ந் தவனைக்","words":[{"form":"விண்டல"},{"form":"ரிலவத்"},{"form":"தண்டைசார்ந்"},{"form":"தவனைக்"}]},{"lineNumber":133,"text":"கண்ட வேட்டுவர் தண்டாது நெருக்கி","words":[{"form":"கண்ட"},{"form":"வேட்டுவர்"},{"form":"தண்டாது"},{"form":"நெருக்கி"}]},{"lineNumber":134,"text":"மையணி யிரும்பிடிவீழ மற்றுநீ","words":[{"form":"மையணி"},{"form":"யிரும்பிடிவீழ"},{"form":"மற்றுநீ"}]},{"lineNumber":135,"text":"உய்வலென் றெண்ணி யொளித்தனை போந்தனை","words":[{"form":"உய்வலென்"},{"form":"றெண்ணி"},{"form":"யொளித்தனை"},{"form":"போந்தனை"}]},{"lineNumber":136,"text":"எவ்வழிப் போதிநின் னின்னுயி ருண்குவம்","words":[{"form":"எவ்வழிப்"},{"form":"போதிநின்"},{"form":"னின்னுயி"},{"form":"ருண்குவம்"}]},{"lineNumber":137,"text":"யாரை நீயெமக் கறியக் கூறென","words":[{"form":"யாரை"},{"form":"நீயெமக்"},{"form":"கறியக்"},{"form":"கூறென"}]},{"lineNumber":138,"text":"வீர வெம்மொழி நீரல பயிற்றி","words":[{"form":"வீர"},{"form":"வெம்மொழி"},{"form":"நீரல"},{"form":"பயிற்றி"}]},{"lineNumber":139,"text":"உடுவமை பகழி யொருங்குடன் றூவ","words":[{"form":"உடுவமை"},{"form":"பகழி"},{"form":"யொருங்குடன்"},{"form":"றூவ"}]},{"lineNumber":140,"text":"விடுகணை விடலை வில்லின் விலக்கி","words":[{"form":"விடுகணை"},{"form":"விடலை"},{"form":"வில்லின்"},{"form":"விலக்கி"}]},{"lineNumber":141,"text":"வதிபயின் றடைந்த மறவரை யதிரக்","words":[{"form":"வதிபயின்"},{"form":"றடைந்த"},{"form":"மறவரை"},{"form":"யதிரக்"}]},{"lineNumber":142,"text":"கைவயிற் கடுங்கணை யொவ்வொன்று கொண்டவர்","words":[{"form":"கைவயிற்"},{"form":"கடுங்கணை"},{"form":"யொவ்வொன்று"},{"form":"கொண்டவர்"}]},{"lineNumber":143,"text":"மெய்வயிற் கழிந்து வியனிலத் திங்க","words":[{"form":"மெய்வயிற்"},{"form":"கழிந்து"},{"form":"வியனிலத்"},{"form":"திங்க"}]},{"lineNumber":144,"text":"வீரருள் வீரன் விசைபெற விடுதலின்","words":[{"form":"வீரருள்"},{"form":"வீரன்"},{"form":"விசைபெற"},{"form":"விடுதலின்"}]},{"lineNumber":145,"text":"வீர வேட்டுவர் சார்த லாற்றார்","words":[{"form":"வீர"},{"form":"வேட்டுவர்"},{"form":"சார்த"},{"form":"லாற்றார்"}]},{"lineNumber":146,"text":"கால வுருவொடு குன்றிடைப் போந்தவோர்","words":[{"form":"கால"},{"form":"வுருவொடு"},{"form":"குன்றிடைப்"},{"form":"போந்தவோர்"}]},{"lineNumber":147,"text":"காலன் கொல்லிவன் கானத் தோர்க்கெனப்","words":[{"form":"காலன்"},{"form":"கொல்லிவன்"},{"form":"கானத்"},{"form":"தோர்க்கெனப்"}]},{"lineNumber":148,"text":"பன்முகத் தானும் பற்றடைந் தன்னவன்","words":[{"form":"பன்முகத்"},{"form":"தானும்"},{"form":"பற்றடைந்"},{"form":"தன்னவன்"}]},{"lineNumber":149,"text":"வின்முகம் புகாஅர் வேட்டுவ ரஞ்சிப்","words":[{"form":"வின்முகம்"},{"form":"புகாஅர்"},{"form":"வேட்டுவ"},{"form":"ரஞ்சிப்"}]},{"lineNumber":150,"text":"புட்கூற் றாளனை யுட்கூற் றாகி","words":[{"form":"புட்கூற்"},{"form":"றாளனை"},{"form":"யுட்கூற்"},{"form":"றாகி"}]},{"lineNumber":151,"text":"அழித்தனை கொணர்ந்தெனப் பழித்தனர் கழறி","words":[{"form":"அழித்தனை"},{"form":"கொணர்ந்தெனப்"},{"form":"பழித்தனர்"},{"form":"கழறி"}]},{"lineNumber":152,"text":"உளைப்பொலி மான்றே ருதயண குமரனை","words":[{"form":"உளைப்பொலி"},{"form":"மான்றே"},{"form":"ருதயண"},{"form":"குமரனை"}]},{"lineNumber":153,"text":"வளைத்துநின் றனரால் வலிப்பது தெரிந்தென்.","words":[{"form":"வளைத்துநின்"},{"form":"றனரால்"},{"form":"வலிப்பது"},{"form":"தெரிந்தென்."}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AA%E0%AF%86%E0%AE%B0%E0%AF%81%E0%AE%99%E0%AF%8D%E0%AE%95%E0%AE%A4%E0%AF%88/1_55_%E0%AE%9A%E0%AE%B5%E0%AE%B0%E0%AE%B0%E0%AF%8D_%E0%AE%AA%E0%AF%81%E0%AE%B3%E0%AE%BF%E0%AE%9E%E0%AE%B0%E0%AF%8D_%E0%AE%B5%E0%AE%B3%E0%AF%88%E0%AE%A8%E0%AF%8D%E0%AE%A4%E0%AE%A4%E0%AF%81","verified":false,"structure":{"level":"chapter","book":"காண்டம் 1","chapter":"சவரர் புளிஞர் வளைந்தது","chapterNumber":55,"number":55,"verseCount":null},"title":"சவரர் புளிஞர் வளைந்தது"}
