"text":"மற்றவ ரெங்கு மறைந்திலர் காண்கெனச்","words":[{"form":"மற்றவ"},{"form":"ரெங்கு"},{"form":"மறைந்திலர்"},{"form":"காண்கெனச்"}]},{"lineNumber":103,"text":"செல்வோ ரொருங்குடன் வல்லையும் வழியும்","words":[{"form":"செல்வோ"},{"form":"ரொருங்குடன்"},{"form":"வல்லையும்"},{"form":"வழியும்"}]},{"lineNumber":104,"text":"வான்கரப் பொதும்புங் கானமுங் கடறும்","words":[{"form":"வான்கரப்"},{"form":"பொதும்புங்"},{"form":"கானமுங்"},{"form":"கடறும்"}]},{"lineNumber":105,"text":"முழைவளர் குன்றுங் கழைவளர் கானமும்","words":[{"form":"முழைவளர்"},{"form":"குன்றுங்"},{"form":"கழைவளர்"},{"form":"கானமும்"}]},{"lineNumber":106,"text":"பயம்பும் பாழியு மியங்குவனர் வதியும்","words":[{"form":"பயம்பும்"},{"form":"பாழியு"},{"form":"மியங்குவனர்"},{"form":"வதியும்"}]},{"lineNumber":107,"text":"முதுமரப் பொத்தும் புதுமலர்ப் பொய்கையும்","words":[{"form":"முதுமரப்"},{"form":"பொத்தும்"},{"form":"புதுமலர்ப்"},{"form":"பொய்கையும்"}]},{"lineNumber":108,"text":"இனையவை பிறவு மனையவ ருள்வழிச்","words":[{"form":"இனையவை"},{"form":"பிறவு"},{"form":"மனையவ"},{"form":"ருள்வழிச்"}]},{"lineNumber":109,"text":"செருக்கய லுண்கட் சீதையைத் தேர்வுழிக்","words":[{"form":"செருக்கய"},{"form":"லுண்கட்"},{"form":"சீதையைத்"},{"form":"தேர்வுழிக்"}]},{"lineNumber":110,"text":"குரக்கினத் தன்ன பரப்பின ராகிப்","words":[{"form":"குரக்கினத்"},{"form":"தன்ன"},{"form":"பரப்பின"},{"form":"ராகிப்"}]},{"lineNumber":111,"text":"பிடிமுதற் கொண்டுமல ரடிமுத லொற்றிச்","words":[{"form":"பிடிமுதற்"},{"form":"கொண்டுமல"},{"form":"ரடிமுத"},{"form":"லொற்றிச்"}]},{"lineNumber":112,"text":"செல்வோர் கதுமெனச் செம்மலைக் கண்டே","words":[{"form":"செல்வோர்"},{"form":"கதுமெனச்"},{"form":"செம்மலைக்"},{"form":"கண்டே"}]},{"lineNumber":113,"text":"கல்லெனத் துவன்றிக் கார்கிளர்ந் ததுபோல்","words":[{"form":"கல்லெனத்"},{"form":"துவன்றிக்"},{"form":"கார்கிளர்ந்"},{"form":"ததுபோல்"}]},{"lineNumber":114,"text":"ஆர்ப்பும் வீளையு மவ்வழிப் பரப்பிக்","words":[{"form":"ஆர்ப்பும்"},{"form":"வீளையு"},{"form":"மவ்வழிப்"},{"form":"பரப்பிக்"}]},{"lineNumber":115,"text":"கார்க்கலைக் கோ