er":60,"text":"தீரறு திங்க ளிருந்த பின்றை","words":[{"form":"தீரறு"},{"form":"திங்க"},{"form":"ளிருந்த"},{"form":"பின்றை"}]},{"lineNumber":61,"text":"ஆரா ணகர மாண்டன னொழுகும்","words":[{"form":"ஆரா"},{"form":"ணகர"},{"form":"மாண்டன"},{"form":"னொழுகும்"}]},{"lineNumber":62,"text":"ஆருணி யரசன் வார்பிணி முரசம்","words":[{"form":"ஆருணி"},{"form":"யரசன்"},{"form":"வார்பிணி"},{"form":"முரசம்"}]},{"lineNumber":63,"text":"நிலனுட னதிர நெருப்பிற் காய்ந்து","words":[{"form":"நிலனுட"},{"form":"னதிர"},{"form":"நெருப்பிற்"},{"form":"காய்ந்து"}]},{"lineNumber":64,"text":"தலமுதற் கெடுநோய் தரித்த லாற்றார்","words":[{"form":"தலமுதற்"},{"form":"கெடுநோய்"},{"form":"தரித்த"},{"form":"லாற்றார்"}]},{"lineNumber":65,"text":"போந்தனர் போலும் புரவல மற்றுநம்","words":[{"form":"போந்தனர்"},{"form":"போலும்"},{"form":"புரவல"},{"form":"மற்றுநம்"}]},{"lineNumber":66,"text":"ஓங்கிய பெருங்குல முயர்தற் குரித்தென்","words":[{"form":"ஓங்கிய"},{"form":"பெருங்குல"},{"form":"முயர்தற்"},{"form":"குரித்தென்"}]},{"lineNumber":67,"text":"றாங்கவ னுரைப்ப வமர்படக் கடந்த","words":[{"form":"றாங்கவ"},{"form":"னுரைப்ப"},{"form":"வமர்படக்"},{"form":"கடந்த"}]},{"lineNumber":68,"text":"தடக்கை கூட்டித் தாங்கா வுவகையொடு","words":[{"form":"தடக்கை"},{"form":"கூட்டித்"},{"form":"தாங்கா"},{"form":"வுவகையொடு"}]},{"lineNumber":69,"text":"படைப்பெரு வேந்தன் பல்லூழ் புல்லி","words":[{"form":"படைப்பெரு"},{"form":"வேந்தன்"},{"form":"பல்லூழ்"},{"form":"புல்லி"}]},{"lineNumber":70,"text":"இருவயி னுலக முயையப் பெற்ற","words":[{"form":"இருவயி"},{"form":"னுலக"},{"form":"முயையப்"},{"form":"பெற்ற"}]},{"lineNumber":71,"text":"பொருமுர ணண்ணல் புகன்ற பொழுதிற்","words":[{"form":"பொருமுர"},{"form":"ணண்ணல்"},{"form":"புகன்ற"},{"form":"பொழுதிற்"}]},{"lineNumber":72,"text":"பெருமகன் போல வுவகையுட் கெழுமிப்","words":[{"form":"பெருமகன்"},{"form":"போல"},{"form":"வுவகையுட்"},{"form":"கெழுமிப்"}]},{"lineNumber":73,"text":"பாடுபெறு சிறப்பிற் பைந்தார் மன்னன்","words":[{"form":"பாடுபெறு"},{"form":"சிறப்பிற்"},{"form":"பைந்தார்"},{"form":"மன்னன்"}]},{"lineNumber":74,"text":"சேடுபடு வத்தஞ் சேர்வது பொருளென","words":[{"form":"சேடுபடு"},{"form":"வத்தஞ்"},{"form":"சேர்வது"},{"form":"பொருளென"}]},{"lineNumber":75,"text":"அறியக் கூறிய குறிவயிற் றிரியார்","words":[{"form":"அறியக்"},{"form":"கூறிய"},{"form":"குறிவயிற்"},{"form":"றிரியார்"}]},{"lineNumber":76,"text":"முன்னீ ராயினு முகந்துடன் புகுவோர்","words":[{"form":"முன்னீ"},{"form":"ராயினு"},{"form":"முகந்துடன்"},{"form":"புகுவோர்"}]},{"lineNumber":77,"text":"பன்னீ ராயிரம் படைத்தொழி லிளையரொ","words":[{"form":"பன்னீ"},{"form":"ராயிரம்"},{"form":"படைத்தொழி"},{"form":"லிளையரொ"}]},{"lineNumber":78,"text":"டற்றக் காலைக் கமைக்கப் பட்ட","words":[{"form":"டற்றக்"},{"form":"காலைக்"},{"form":"கமைக்கப்"},{"form":"பட்ட"}]},{"lineNumber":79,"text":"கொற்றத் தானையுங் குழூஉக்கொண் டீண்டத்","words":[{"form":"கொற்றத்"},{"form":"தானையுங்"},{"form":"குழூஉக்கொண்"},{"form":"டீண்டத்"}]},{"lineNumber":80,"text":"தப்பினா ரென்ற தம்பியர் வந்தவன்","words":[{"form":"தப்பினா"},{"form":"ரென்ற"},{"form":"தம்பியர்"},{"form":"வந்தவன்"}]},{"lineNumber":81,"text":"பொற்கழற் சேவடிப் பொருந்தப் புல்லி","words":[{"form":"பொற்கழற்"},{"form":"சேவடிப்"},{"form":"பொருந்தப்"},{"form":"புல்லி"}]},{"lineNumber":82,"text":"ஓர்த்தனந் தேறி யுறுதிநோக் காது","words":[{"form":"ஓர்த்தனந்"},{"form":"தேறி"},{"form":"யுறுதிநோக்"},{"form":"காது"}]},{"lineNumber":83,"text":"சேர்த்தியில் செய்கையொடு சிறைகொளப் பட்டுப்","words":[{"form":"சேர்த்தியில்"},{"form":"செய்கையொடு"},{"form":"சிறைகொளப்"},{"form":"பட்டுப்"}]},{"lineNumber":84,"text":"பெருங்குடி யாக்கம் பீடற வெருளி","words":[{"form":"பெருங்குடி"},{"form":"யாக்கம்"},{"form":"பீடற"},{"form":"வெருளி"}]},{"lineNumber":85,"text":"அருங்கடம் பூண்ட வலியாக் காதலொடு","words":[{"form":"அருங்கடம்"},{"form":"பூண்ட"},{"form":"வலியாக்"},{"form":"காதலொடு"}]},{"lineNumber":86,"text":"பயந்தினி தெடுத்த படைப்பருங் கற்பினம்","words":[{"form":"பயந்தினி"},{"form":"தெடுத்த"},{"form":"படைப்பருங்"},{"form":"கற்பினம்"}]},{"lineNumber":87,"text":"கொற்ற விறைவிக்குக் குற்றேல் பிழையா","words":[{"form":"கொற்ற"},{"form":"விறைவிக்குக்"},{"form":"குற்றேல்"},{"form":"பிழையா"}]},{"lineNumber":88,"text":"தொருங்கியா முறைத லொழிந்தது மன்றி","words":[{"form":"தொருங்கியா"},{"form":"முறைத"},{"form":"லொழிந்தது"},{"form":"மன்றி"}]},{"lineNumber":89,"text":"இருங்கடல் வரைப்பி னினியோ ரெடுத்த","words":[{"form":"இருங்கடல்"},{"form":"வரைப்பி"},{"form":"னினியோ"},{"form":"ரெடுத்த"}]},{"lineNumber":90,"text":"இறைமீக் கூறிய விராமன் றம்பி","words":[{"form":"இறைமீக்"},{"form":"கூறிய"},{"form":"விராமன்"},{"form":"றம்பி"}]},{"lineNumber":91,"text":"மறுவொடு பெயரிய மதலைக் கியைந்த","words":[{"form":"மறுவொடு"},{"form":"பெயரிய"},{"form":"மதலைக்"},{"form":"கியைந்த"}]},{"lineNumber":92,"text":"ஆனாப் பெரும்புகழ் யாமு மெய்தத்","words":[{"form":"ஆனாப்"},{"form":"பெரும்புகழ்"},{"form":"யாமு"},{"form":"மெய்தத்"}]},{"lineNumber":93,"text":"தேனார் தாமரைத் திருந்துமலர்ச் சேவடி","words":[{"form":"தேனார்"},{"form":"தாமரைத்"},{"form":"திருந்துமலர்ச்"},{"form":"சேவடி"}]},{"lineNumber":94,"text":"வழிபா டாற்றலும் வன்கணி னீத்தனெம்","words":[{"form":"வழிபா"},{"form":"டாற்றலும்"},{"form":"வன்கணி"},{"form":"னீத்தனெம்"}]},{"lineNumber":95,"text":"கழிபெருஞ் சிறப்பிற் காவல் வேந்தே","words":[{"form":"கழிபெருஞ்"},{"form":"சிறப்பிற்"},{"form":"காவல்"},{"form":"வேந்தே"}]},{"lineNumber":96,"text":"இம்மை யென்ப தெமக்குநெறி யின்மையின்","words":[{"form":"இம்மை"},{"form":"யென்ப"},{"form":"தெமக்குநெறி"},{"form":"யின்மையின்"}]},{"lineNumber":97,"text":"முன்னர்ப் பிறப்பின் மூத்தோர்ப் பிழையா","words":[{"form":"முன்னர்ப்"},{"form":"பிறப்பின்"},{"form":"மூத்தோர்ப்"},{"form":"பிழையா"}]},{"lineNumber":98,"text":"துடன்வழிப் படூஉ முறுதவ மில்லாக்","words":[{"form":"துடன்வழிப்"},{"form":"படூஉ"},{"form":"முறுதவ"},{"form":"மில்லாக்"}]},{"lineNumber":99,"text":"கடுவினை யாளரேம் யாமெனக் கலங்கிப்","words":[{"form":"கடுவினை"},{"form":"யாளரேம்"},{"form":"யாமெனக்"},{"form":"கலங்கிப்"}]},{"lineNumber":100,"text":"பொள்ளெனச் சென்னி பூமி தோய","words":[{"form":"பொள்ளெனச்"},{"form":"சென்னி"},{"form":"பூமி"},{"form":"தோய"}]},{"lineNumber":101,"text":"உள்ளழல் வெம்பனி யுகுத்