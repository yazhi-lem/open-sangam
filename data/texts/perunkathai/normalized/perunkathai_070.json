form":"ரெரிவாய்ப்"},{"form":"பட்ட"}]},{"lineNumber":115,"text":"பன்னற் பஞ்சி யன்ன ராகென","words":[{"form":"பன்னற்"},{"form":"பஞ்சி"},{"form":"யன்ன"},{"form":"ராகென"}]},{"lineNumber":116,"text":"வெகுளித் தீயிற் கிளையறச் சுடுதல்","words":[{"form":"வெகுளித்"},{"form":"தீயிற்"},{"form":"கிளையறச்"},{"form":"சுடுதல்"}]},{"lineNumber":117,"text":"முடிந்த திந்நிலை முடிந்தன ரவரெனச்","words":[{"form":"முடிந்த"},{"form":"திந்நிலை"},{"form":"முடிந்தன"},{"form":"ரவரெனச்"}]},{"lineNumber":118,"text":"செப்பிய மாற்றம் பொய்ப்ப தன்றாற்","words":[{"form":"செப்பிய"},{"form":"மாற்றம்"},{"form":"பொய்ப்ப"},{"form":"தன்றாற்"}]},{"lineNumber":119,"text":"பொரக்குறை யிலமென விரப்ப வின்புற்","words":[{"form":"பொரக்குறை"},{"form":"யிலமென"},{"form":"விரப்ப"},{"form":"வின்புற்"}]},{"lineNumber":120,"text":"றிளையோர் தம்மோ டீன்றவட் கிரங்கிக்","words":[{"form":"றிளையோர்"},{"form":"தம்மோ"},{"form":"டீன்றவட்"},{"form":"கிரங்கிக்"}]},{"lineNumber":121,"text":"களைக ணாகிய காதலந் தோழனை","words":[{"form":"களைக"},{"form":"ணாகிய"},{"form":"காதலந்"},{"form":"தோழனை"}]},{"lineNumber":122,"text":"வளையெரிப் பட்ட தெளிபே ரன்பிற்","words":[{"form":"வளையெரிப்"},{"form":"பட்ட"},{"form":"தெளிபே"},{"form":"ரன்பிற்"}]},{"lineNumber":123,"text":"றளையவிழ் கோதையொடு தருதலும் பொருளோ","words":[{"form":"றளையவிழ்"},{"form":"கோதையொடு"},{"form":"தருதலும்"},{"form":"பொருளோ"}]},{"lineNumber":124,"text":"நும்மைத் தந்தென் புன்மை நீக்கிய","words":[{"form":"நும்மைத்"},{"form":"தந்தென்"},{"form":"புன்மை"},{"form":"நீக்கிய"}]},{"lineNumber":125,"text":"உம்மைச் செய்த செம்மைத் தவத்தனெனத்","words":[{"form":"உம்மைச்"},{"form":"செய்த"},{"form":"செம்மைத்"},{"form":"தவத்தனெனத்"}]},{"lineNumber":126,"text":"தம்பியர் தாமரைத் தடங்கண் சொரியும்","words":[{"form":"தம்பியர்"},{"form":"தாமரைத்"},{"form":"தடங்கண்"},{"form":"சொரியும்"}]},{"lineNumber":127,"text":"வெம்பனி துடைத்துப் பண்புளிப் பேணிக்","words":[{"form":"வெம்பனி"},{"form":"துடைத்துப்"},{"form":"பண்புளிப்"},{"form":"பேணிக்"}]},{"lineNumber":128,"text":"கண்ணுற வெய்திய கருமம் போல","words":[{"form