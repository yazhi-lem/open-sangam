்துகள்"}]},{"lineNumber":115,"text":"அழிந்தன பூமி விழுந்தனர் மேலோர்","words":[{"form":"அழிந்தன"},{"form":"பூமி"},{"form":"விழுந்தனர்"},{"form":"மேலோர்"}]},{"lineNumber":116,"text":"இப்படி நிகழ்ந்த காலை வெப்பமொடு","words":[{"form":"இப்படி"},{"form":"நிகழ்ந்த"},{"form":"காலை"},{"form":"வெப்பமொடு"}]},{"lineNumber":117,"text":"பெரும்படைச் செற்றத் திருங்கடன் மாந்திக்","words":[{"form":"பெரும்படைச்"},{"form":"செற்றத்"},{"form":"திருங்கடன்"},{"form":"மாந்திக்"}]},{"lineNumber":118,"text":"குஞ்சரக் கொண்மூக் குன்றடைந்து குழீஇக்","words":[{"form":"குஞ்சரக்"},{"form":"கொண்மூக்"},{"form":"குன்றடைந்து"},{"form":"குழீஇக்"}]},{"lineNumber":119,"text":"காலிய லிவுளிக் கடுவளி யாட்ட","words":[{"form":"காலிய"},{"form":"லிவுளிக்"},{"form":"கடுவளி"},{"form":"யாட்ட"}]},{"lineNumber":120,"text":"வேலிடை முடைந்து வாளிடை மின்னக்","words":[{"form":"வேலிடை"},{"form":"முடைந்து"},{"form":"வாளிடை"},{"form":"மின்னக்"}]},{"lineNumber":121,"text":"கணைத்துளி பொழிந்த கார்வரைச் சாரல்","words":[{"form":"கணைத்துளி"},{"form":"பொழிந்த"},{"form":"கார்வரைச்"},{"form":"சாரல்"}]},{"lineNumber":122,"text":"ஒருபெருஞ் சிறப்பி னுதயண குமரன்","words":[{"form":"ஒருபெருஞ்"},{"form":"சிறப்பி"},{"form":"னுதயண"},{"form":"குமரன்"}]},{"lineNumber":123,"text":"பொருபடை யுருமிற் பொங்குபு தொடரத்","words":[{"form":"பொருபடை"},{"form":"யுருமிற்"},{"form":"பொங்குபு"},{"form":"தொடரத்"}]},{"lineNumber":124,"text":"தாரணி மார்ப னாருணி யரசனும்","words":[{"form":"தாரணி"},{"form":"மார்ப"},{"form":"னாருணி"},{"form":"யரசனும்"}]},{"lineNumber":125,"text":"காந்தா ரகனுங் கழற்காற் சாயனும்","words":[{"form":"காந்தா"},{"form":"ரகனுங்"},{"form":"கழற்காற்"},{"form":"சாயனும்"}]},{"lineNumber":126,"text":"தேந்தார்ச் சூரனுந் திறற்பம சேன்னும்","words":[{"form":"தேந்தார்ச்"},{"form":"சூரனுந்"},{"form":"திறற்பம"},{"form":"சேன்னும்"}]},{"lineNumber":127,"text":"இந்நாற் றலைவரு மெரிகான் றெதிர்ப்பச்","words":[{"form":"இந்நாற்"},{"form":"றலைவரு"},{"form":"மெரிகான்"},{"form":"றெதிர்ப்பச்"}]},{"lineNumber":128,"text":"செந்நே ராகச் செல்வுழி யெதிரே","words":[{"fo