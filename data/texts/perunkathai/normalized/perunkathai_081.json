neNumber":69,"text":"பெருமட மகடூஉப் பெருந்தகை மாதால்","words":[{"form":"பெருமட"},{"form":"மகடூஉப்"},{"form":"பெருந்தகை"},{"form":"மாதால்"}]},{"lineNumber":70,"text":"நின்னினு நின்மாட்டுப் பின்னிய காதற்","words":[{"form":"நின்னினு"},{"form":"நின்மாட்டுப்"},{"form":"பின்னிய"},{"form":"காதற்"}]},{"lineNumber":71,"text":"றுன்னிய கற்பிற் றேவி தன்னினும்","words":[{"form":"றுன்னிய"},{"form":"கற்பிற்"},{"form":"றேவி"},{"form":"தன்னினும்"}]},{"lineNumber":72,"text":"எண்ணிய வெல்லாந் திண்ணிய வாயின","words":[{"form":"எண்ணிய"},{"form":"வெல்லாந்"},{"form":"திண்ணிய"},{"form":"வாயின"}]},{"lineNumber":73,"text":"இருநிலம் விண்ணோ டியைந்தனர் கொடுப்பினும்","words":[{"form":"இருநிலம்"},{"form":"விண்ணோ"},{"form":"டியைந்தனர்"},{"form":"கொடுப்பினும்"}]},{"lineNumber":74,"text":"பெருநில மன்ன ரேயதை யல்லது","words":[{"form":"பெருநில"},{"form":"மன்ன"},{"form":"ரேயதை"},{"form":"யல்லது"}]},{"lineNumber":75,"text":"பழமையிற் றிரியார் பயன்றெரி மாக்கள்","words":[{"form":"பழமையிற்"},{"form":"றிரியார்"},{"form":"பயன்றெரி"},{"form":"மாக்கள்"}]},{"lineNumber":76,"text":"கிழமையிற் செய்தனன் கெழுதகை தருமெனக்","words":[{"form":"கிழமையிற்"},{"form":"செய்தனன்"},{"form":"கெழுதகை"},{"form":"தருமெனக்"}]},{"lineNumber":77,"text":"கோனேறி வேந்தே கூறுங் காலை","words":[{"form":"கோனேறி"},{"form":"வேந்தே"},{"form":"கூறுங்"},{"form":"காலை"}]},{"lineNumber":78,"text":"நூனெறி யென்றியா னுன்னிடைத் துணிந்தது","words":[{"form":"நூனெறி"},{"form":"யென்றியா"},{"form":"னுன்னிடைத்"},{"form":"துணிந்தது"}]},{"lineNumber":79,"text":"பொறுத்தனை யருளென நெறிப்படுத் துரைப்ப","words":[{"form":"பொறுத்தனை"},{"form":"யருளென"},{"form":"நெறிப்படுத்"},{"form":"துரைப்ப"}]},{"lineNumber":80,"text":"வழுக்கிய தலைமையை யிழுக்க மின்றி","words":[{"form":"வழுக்கிய"},{"form":"தலைமையை"},{"form":"யிழுக்க"},{"form":"மின்றி"}]},{"lineNumber":81,"text":"அமைத்தனை நீயென வவையது நடுவண்","words":[{"form":"அமைத்தனை"},{"form":"நீயென"},{"form":"வவையது"},{"form":"நடுவண்"}]},{"lineNumber":82,"text":"ஆற்றுளிக் கூற வத்துணை யாயினும்","words":[{"form":"ஆற்றுளிக்"},{"form":"க