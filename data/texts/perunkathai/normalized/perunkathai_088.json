்"},{"form":"நகர்க்கென"}]},{"lineNumber":148,"text":"நெடுந்தேர் வீதியு மல்லா விடமும்","words":[{"form":"நெடுந்தேர்"},{"form":"வீதியு"},{"form":"மல்லா"},{"form":"விடமும்"}]},{"lineNumber":149,"text":"கொடைநவில் வேந்தன் கொடிக்கோ சம்பி","words":[{"form":"கொடைநவில்"},{"form":"வேந்தன்"},{"form":"கொடிக்கோ"},{"form":"சம்பி"}]},{"lineNumber":150,"text":"நிலையிடம் பெறாது நெருங்கிற்றாற் சனமென்.","words":[{"form":"நிலையிடம்"},{"form":"பெறாது"},{"form":"நெருங்கிற்றாற்"},{"form":"சனமென்."}]}],"culturalNotes":[],"audioUrl":null,"source":"https://ta.wikisource.org/wiki/%E0%AE%AA%E0%AF%86%E0%AE%B0%E0%AF%81%E0%AE%99%E0%AF%8D%E0%AE%95%E0%AE%A4%E0%AF%88/4_15_%E0%AE%B5%E0%AE%BF%E0%AE%B0%E0%AE%BF%E0%AE%9A%E0%AE%BF%E0%AE%95%E0%AF%88_%E0%AE%B5%E0%AE%B0%E0%AE%B5%E0%AF%81_%E0%AE%95%E0%AF%81%E0%AE%B1%E0%AE%BF%E0%AE%A4%E0%AF%8D%E0%AE%A4%E0%AE%A4%E0%AF%81","verified":false,"structure":{"level":"chapter","book":"காண்டம் 4","chapter":"விரிசிகை வரவு குறித்தது","chapterNumber":15,"number":15,"verseCount":null},"title":"விரிசிகை வரவு குறித்தது"}
