்த்துக் காண்ட லுறூஉம்","words":[{"form":"கண்டோர்"},{"form":"பெயர்த்துக்"},{"form":"காண்ட"},{"form":"லுறூஉம்"}]},{"lineNumber":149,"text":"தண்டா வனப்பின் றகைமைய ளாகிய","words":[{"form":"தண்டா"},{"form":"வனப்பின்"},{"form":"றகைமைய"},{"form":"ளாகிய"}]},{"lineNumber":150,"text":"கன்னி யாகங் கலக்கப் பெறீஇயரெனப்","words":[{"form":"கன்னி"},{"form":"யாகங்"},{"form":"கலக்கப்"},{"form":"பெறீஇயரெனப்"}]},{"lineNumber":151,"text":"பன்மலர்க் காவினுட் பகலு மிரவும்","words":[{"form":"பன்மலர்க்"},{"form":"காவினுட்"},{"form":"பகலு"},{"form":"மிரவும்"}]},{"lineNumber":152,"text":"உறையு ளெய்திய நிறையுடை நீர்மை","words":[{"form":"உறையு"},{"form":"ளெய்திய"},{"form":"நிறையுடை"},{"form":"நீர்மை"}]},{"lineNumber":153,"text":"இளையோ னமைந்த காலை மற்றுத்தன்","words":[{"form":"இளையோ"},{"form":"னமைந்த"},{"form":"காலை"},{"form":"மற்றுத்தன்"}]},{"lineNumber":154,"text":"தளையவிழ் கோதைத் தைய லிவளெனும்","words":[{"form":"தளையவிழ்"},{"form":"கோதைத்"},{"form":"தைய"},{"form":"லிவளெனும்"}]},{"lineNumber":155,"text":"மைய லுள்ளமொடு பைத லெய்தி","words":[{"form":"மைய"},{"form":"லுள்ளமொடு"},{"form":"பைத"},{"form":"லெய்தி"}]},{"lineNumber":156,"text":"மன்னவன் மடமகள் பின்னொழிந் திறக்கும்","words":[{"form":"மன்னவன்"},{"form":"மடமகள்"},{"form":"பின்னொழிந்"},{"form":"திறக்கும்"}]},{"lineNumber":157,"text":"ஏந்திள வனமுலை யெழில்வளைப் பணைத்தோள்","words":[{"form":"ஏந்திள"},{"form":"வனமுலை"},{"form":"யெழில்வளைப்"},{"form":"பணைத்தோள்"}]},{"lineNumber":158,"text":"மாந்தளிர் மேனி மடமா னோக்கின்","words":[{"form":"மாந்தளிர்"},{"form":"மேனி"},{"form":"மடமா"},{"form":"னோக்கின்"}]},{"lineNumber":159,"text":"ஆய்ந்த கோலத் தயிரா பதியெனும்","words":[{"form":"ஆய்ந்த"},{"form":"கோலத்"},{"form":"தயிரா"},{"form":"பதியெனும்"}]},{"lineNumber":160,"text":"கூன் மகடனைக் கோமகன் குறுகி","words":[{"form":"கூன்"},{"form":"மகடனைக்"},{"form":"கோமகன்"},{"form":"குறுகி"}]},{"lineNumber":161,"text":"யாவளிந் நங்கை யாதிவண் மெய்ப்பெயர்","words":[{"form":"யாவளிந்"},{"form":"நங்கை"},{"form":"யாதிவண்"},{"form":"மெய்ப்பெயர்"}]},{"lineNumber":162,"text":"கா