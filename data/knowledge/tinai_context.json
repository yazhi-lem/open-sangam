  "sampleVerses": [
   {
    "id": "akananooru_004",
    "poem": "akananooru",
    "number": 4,
    "poet": "குறுங்குடி மருதனார்",
    "snippet": "முல்லை வைந் நுனை தோன்ற, இல்லமொடு பைங் காற் கொன்றை மென் பிணி அவிழ, இரும்பு திரித்தன்ன மா இரு மருப்பின், பரல் அவல் அடைய, இ"
   },
   {
    "id": "akananooru_014",
    "poem": "akananooru",
    "number": 14,
    "poet": "ஒக்கூர் மாசாத்தனார்",
    "snippet": "'அரக்கத்து அன்ன செந் நிலப் பெரு வழி, காயாஞ் செம்மல் தாஅய், பல உடன் ஈயல் மூதாய் வரிப்ப, பவளமொடு மணி மிடைந்தன்ன குன்றம் கவ"
   },
   {
    "id": "akananooru_024",
    "poem": "akananooru",
    "number": 24,
    "poet": "ஆவூர் மூலங் கிழார்",
    "snippet": "வேளாப் பார்ப்பான் வாளரந் துமித்த வளை களைந்து ஒழிந்த கொழுந்தின் அன்ன, தலை பிணி அவிழா, சுரி முகப் பகன்றை, சிதரல் அம் துவலை"
   },
   {
    "id": "akananooru_034",
    "poem": "akananooru",
    "number": 34,
    "poet": "மதுரை மருதன் இளநாகனார்",
    "snippet": "சிறு கரும் பிடவின் வெண் தலைக் குறும் புதல் கண்ணியின் மலரும் தண் நறும் புறவில், தொடுதோற் கானவன் கவை பொறுத்தன்ன இரு திரி ம"
   },
   {
    "id": "akananooru_044",
    "poem": "akananooru",
    "number": 44,
    "poet": "குடவாயிற் கீரத்தனார்",
    "snippet": "வந்து வினை முடித்தனன் வேந்தனும்; பகைவரும் தம் திறை கொடுத்துத் தமர் ஆயினரே; முரண் செறிந்திருந்த தானை இரண்டும் ஒன்று என அற"
   },
   {
    "id": "akananooru_054",
    "poem": "akananooru",
    "number": 54,
    "poet": "மாற்றூர் கிழார் மகனார் கொற்றங் கொற்றனார்",
    "snippet": "விருந்தின் மன்னர் அருங்கலம் தெறுப்ப, வேந்தனும் வெம்பகை தணிந்தனன்; தீம் பெயற் காரும் ஆர்கலி தலையின்று. தேரும் ஓவத்தன்ன கோ"
   }
  ]
 },
