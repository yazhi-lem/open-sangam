  "sampleVerses": [
   {
    "id": "ainkurunooru_401",
    "poem": "ainkurunooru",
    "number": 401,
    "poet": "பேயனார்",
    "snippet": "மறியிடைப் படுத்த மான்பிணை போலப் புதல்வன் நடுவண னாக நன்றும் இனிது மன்றஅவர் கிடக்கை முனிவின்றி நீல்நிற வியலகம் கவைஇய ஈனும்"
   },
   {
    "id": "ainkurunooru_402",
    "poem": "ainkurunooru",
    "number": 402,
    "poet": "பேயனார்",
    "snippet": "புதல்வற் கவைஇய தாய்புற முயங்கி நசையினன் வதிந்த கிடக்கை பாணர் நரம்புளர் முரற்கை போல இனிதால் அம்ம பண்புமா ருடைத்தே."
   },
   {
    "id": "ainkurunooru_403",
    "poem": "ainkurunooru",
    "number": 403,
    "poet": "பேயனார்",
    "snippet": "புணர்ந்தகா தலியின் புதல்வன் தலையும் அமர்ந்த உள்ளம் பெரிதா இன்றே அகன்பெருஞ் சிறப்பின் தந்தை பெயரன் முறுவலில் இன்னகை பயிற்"
   },
   {
    "id": "ainkurunooru_404",
    "poem": "ainkurunooru",
    "number": 404,
    "poet": "பேயனார்",
    "snippet": "வாழ்நுதல் அரிவை மகன்முலை யூட்டத் தானவன் சிறுபுறம் கவையினன் நன்று நறும்பூம் தண்புற அணிந்த குறும்பல் பொறைய நாடுகிழ வோனே."
   },
   {
    "id": "ainkurunooru_405",
    "poem": "ainkurunooru",
    "number": 405,
    "poet": "பேயனார்",
    "snippet": "ஒண்சுடர்ப் பாண்டில் செஞ்சுடர் போல மனைக்குவிளக் காயினள் மன்ற கனைப்பெயல் பூப்பல அணிந்த வைப்பின் புறவணி நாடன் புதல்வன் தாயே"
   },
   {
    "id": "ainkurunooru_406",
    "poem": "ainkurunooru",
    "number": 406,
    "poet": "பேயனார்",
    "snippet": "மாதர் உண்கண் மகன்விளை யாடக் காதலித் தழீஇ இனிதிருந் தனனே தாதார் பிரசம் ஊதும் போதார் புறவின் நாடுகிழ வோனே."
   }
  ]
