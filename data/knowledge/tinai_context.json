   {
    "id": "ainkurunooru_201",
    "poem": "ainkurunooru",
    "number": 201,
    "poet": "கபிலர்",
    "snippet": "அன்னாய் வாழிவேண் டன்னை என்னை தானும் மலைந்தான் எமக்கும் தழையாயின பொன்வீ மணியரும் பினவே என்ன மரம்கொல்அவர் சாரல் அவ்வே."
   },
   {
    "id": "ainkurunooru_202",
    "poem": "ainkurunooru",
    "number": 202,
    "poet": "கபிலர்",
    "snippet": "அன்னாய் வாழிவேண் டன்னை நம்மூர்ப் பார்ப்பனக் குறுமகப் போலத் தாமும் குடுமித் தலைய மன்ற நெடுமலை நாடன் ஊர்ந்த மாவே."
   },
   {
    "id": "ainkurunooru_203",
    "poem": "ainkurunooru",
    "number": 203,
    "poet": "கபிலர்",
    "snippet": "அன்னாய் வாழிவேன் டன்னைநம் படப்பை தேன்மயங்கு பாலினும் இனிய அவர்நாட்டு உவலை கூவற் கீழ மானுண்டு எஞ்சிய கலிழி நீரே."
   },
   {
    "id": "ainkurunooru_204",
    "poem": "ainkurunooru",
    "number": 204,
    "poet": "கபிலர்",
    "snippet": "அன்னாய் வாழிவேண் டன்னைஅது எவன்கொல் வரையர மகளிரின் நிரையுடன் குழீஇப் பெயர்வழிப் பெயர் வழித் தவிராது நோக்கி நல்லள் நல்லள் "
   },
   {
    "id": "ainkurunooru_205",
    "poem": "ainkurunooru",
    "number": 205,
    "poet": "கபிலர்",
    "snippet": "அன்னாய் வாழிவேண் டன்னையென் தோழி நனிநான் உடையள் நின்னும் அஞ்சும் ஒலிவெள் ளருவி ஓங்குமலை நாடன் மலர்ந்த மார்பின் பாயல் துஞ்"
   },
   {
    "id": "ainkurunooru_206",
    "poem": "ainkurunooru",
    "number": 206,
    "poet": "கபிலர்",
    "snippet": "அன்னாய் வாழிவேண் டன்னை உவக்காண் மாரிக் குளத்துக் காப்பாள் அன்னன் தூவலின் நனைந்த தொடலை ஒள்வாள் பாசி சூழ்ந்த பெருங்கழல் தண"
