  "sampleVerses": [
   {
    "id": "akananooru_002",
    "poem": "akananooru",
    "number": 2,
    "poet": "கபிலர்",
    "snippet": "கோழிலை வாழைக் கோள் முதிர் பெருங் குலை ஊழுறு தீம் கனி, உண்ணுநர்த் தடுத்த சாரற் பலவின் சுளையொடு, ஊழ் படு பாறை நெடுஞ் சுனை,"
   },
   {
    "id": "akananooru_008",
    "poem": "akananooru",
    "number": 8,
    "poet": "பெருங்குன்றூர் கிழார்",
    "snippet": "ஈயல் புற்றத்து ஈர்ம் புறத்து இறுத்த குரும்பி வல்சிப் பெருங் கை ஏற்றை தூங்கு தோல் துதிய வள் உகிர் கதுவலின், பாம்பு மதன் அ"
   },
   {
    "id": "akananooru_012",
    "poem": "akananooru",
    "number": 12,
    "poet": "கபிலர்",
    "snippet": "யாயே, கண்ணினும் கடுங் காதலளே; எந்தையும், நிலன் உறப் பொறாஅன்; 'சீறடி சிவப்ப, எவன், இல! குறுமகள்! இயங்குதி?' என்னும்; யாமே"
   },
   {
    "id": "akananooru_018",
    "poem": "akananooru",
    "number": 18,
    "poet": "கபிலர்",
    "snippet": "நீர் நிறம் கரப்ப, ஊழுறுபு உதிர்ந்து, பூமலர் கஞலிய கடு வரற் கான் யாற்று, கராஅம் துஞ்சும் கல் உயர் மறி சுழி, மராஅ யானை மதம"
   },
   {
    "id": "akananooru_022",
    "poem": "akananooru",
    "number": 22,
    "poet": "வெறிபாடிய காமக்கண்ணியார்",
    "snippet": "'அணங்குடை நெடு வரை உச்சியின் இழிதரும் கணம் கொள் அருவிக் கான் கெழு நாடன் மணம் கமழ் வியல் மார்பு அணங்கிய செல்லல் இது என அற"
   },
   {
    "id": "akananooru_028",
    "poem": "akananooru",
    "number": 28,
    "poet": "பாண்டியன் அறிவுடைநம்பி",
    "snippet": "மெய்யின் தீரா மேவரு காமமொடு எய்யாய் ஆயினும், உரைப்பல் தோழி! கொய்யா முன்னும், குரல் வார்பு, தினையே அருவி ஆன்ற பைங் கால் த"
   }
  ]
 },
