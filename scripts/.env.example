# Backend environment variables — copy to .env and fill in your values.
# Never commit .env to version control.

# --- AI translation pipeline (ai/translate_with_gemini.py) ---
# Which gateway to reach Gemini through: "openrouter" (default) or "gemini".
SANGAM_TRANSLATE_BACKEND=openrouter

# openrouter backend (default) — the same key the Sangam Avai agents use.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
# Model id as listed on openrouter.ai/models, without the provider prefix
# LiteLLM would add. Must be a model with strong Tamil comprehension.
SANGAM_TRANSLATE_MODEL=google/gemini-2.5-flash

# gemini backend (alternative; SANGAM_TRANSLATE_BACKEND=gemini) — also used by
# the Cloud Functions in backend/functions.
GEMINI_API_KEY=
# SANGAM_TRANSLATE_MODEL=gemini-2.5-flash

# --- Firestore ---
# Firebase service account (for uploading data to Firestore)
# Path to your downloaded service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
